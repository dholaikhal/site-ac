---
import facts, { tk, usdOf } from "../data/facts";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const plans = facts.pricing.plans;
const colors: Record<string, string> = { free: "", starter: "red", business: "green", agency: "cobalt" };
---
<div class="plans" class:list={{ compact }}>
  {plans.map((p) => (
    <div class:list={["plan", colors[p.id]]}>
      <div class="plan-top"><h3>{p.name}</h3>{p.id === "starter" && <span class="tag">Start here</span>}</div>
      <p class="price"><span class="amt">{tk(p.tk)}</span>{p.tk > 0 && <span class="per">/month</span>}</p>
      <p class="usd">{p.tk > 0 ? `≈ ${usdOf(p.tk)} a month` : "Free to build and preview"}</p>
      {!compact && <ul class="ticks">{p.includes.map((i) => <li>{i}</li>)}</ul>}
    </div>
  ))}
</div>
<p class="pilot-note small"><span class="hyp">{facts.pricing.status[0].toUpperCase() + facts.pricing.status.slice(1)}</span> USD at Tk {facts.fx.tkPerUsd} = $1. Extra AI edits {tk(facts.pricing.extraEditTk)} each.</p>

<style>
.plans { display: grid; gap: 18px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
@media (max-width: 1000px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .plans { grid-template-columns: 1fr; } }
.plan { background: var(--card); border: 2px solid var(--line); border-radius: var(--radius); box-shadow: var(--sh); overflow: hidden; display: grid; align-content: start; }
.plan-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 16px 20px 14px; border-bottom: 2px solid var(--line); background: var(--ground-2); }
.plan.red .plan-top { background: var(--red); color: #fff; }
.plan.green .plan-top { background: var(--green); color: #fff; }
.plan.cobalt .plan-top { background: var(--cobalt); color: #fff; }
.plan h3 { margin: 0; font-size: 1.5rem; }
.price { margin: 16px 20px 0; }
.amt { font-family: var(--display); font-size: 2.3rem; font-weight: 800; letter-spacing: -0.04em; }
.per { color: var(--ink-2); margin-left: 4px; font-weight: 600; }
.usd { color: var(--ink-2); margin: 0 20px 14px; font-size: 0.92rem; }
.plan .ticks { margin: 0 20px 20px; }
.pilot-note { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
</style>
