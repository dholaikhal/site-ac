---
// A live photo scene behind an inner page's title.
import Scene from "./Scene.astro";
import data from "../data/scenes.json";
interface Props { id: string }
const s = [...data.hero, ...data.extra].find((x) => x.id === Astro.props.id);
if (!s) throw new Error(`Unknown scene: ${Astro.props.id}`);
---
<Scene scene={s} head />
<div class="node-tip" role="status" hidden></div>
