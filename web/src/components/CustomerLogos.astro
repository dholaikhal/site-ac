  "Padma Fresh Fish": `<path d="M4 24c8-11 24-12 34 0-10 12-26 11-34 0z" fill="c"/><path d="M38 24l8-8v16z" fill="c"/><circle cx="12" cy="22" r="2" fill="w"/><path d="M20 17c3 4 3 10 0 14M26 16c3 5 3 11 0 16" stroke="w" stroke-width="1.6" fill="none" opacity=".8"/><path d="M4 40c5-3 9 3 14 0s9 3 14 0 9 3 14 0" stroke="c" stroke-width="2.2" fill="none" stroke-linecap="round"/>`,
