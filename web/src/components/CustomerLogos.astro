---
// "Shops that sell with Amader Cloud": a wall of customer marks. Shown only while `live` is set in data/proof.ts,
// or in the dev preview, where it's tagged as placeholder (see the note in data/proof.ts).
import { live, logos } from "../data/proof";
import { icon } from "../scripts/app-art.js";
const show = live || import.meta.env.DEV;
---
{show && (
<section class="logos-band" aria-labelledby="logos-h">
  <div class="wrap">
    <p class="logos-h" id="logos-h">Shops that sell with Amader Cloud{!live && <span class="ph">Placeholder</span>}</p>
    <ul class="logo-wall">
      {logos.map((l) => (
        <li class={`lm m-${l.mark}`} title={l.kind}>
          <span class="lm-ic" set:html={icon(l.icon)} />
          <span class="lm-name">{l.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
)}

<style>
.logos-band { padding-block: clamp(28px, 4vw, 44px); background: var(--card); border-bottom: 1px solid var(--rule); }
.logos-h { margin: 0 0 18px; text-align: center; font-weight: 700; font-size: 0.82rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
.ph { margin-left: 10px; padding: 2px 8px; border-radius: 3px; background: var(--yellow); color: #14213d; letter-spacing: .04em; }
.logo-wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px 24px; align-items: center; }
@media (max-width: 1000px) { .logo-wall { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
@media (max-width: 640px) { .logo-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
/* Each mark in its own lettering, all in one quiet ink until hovered */
.lm { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; color: var(--ink); opacity: .62; filter: grayscale(1); transition: opacity .2s; white-space: nowrap; }
.lm:hover { opacity: 1; }
.lm-ic { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 7px; border: 2px solid currentColor; flex: none; }
.lm-ic :global(.ic) { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.lm-name { font-size: 1.05rem; line-height: 1; }
.m-serif .lm-name { font-family: Georgia, "Times New Roman", serif; font-weight: 700; letter-spacing: -0.01em; }
.m-script .lm-name { font-family: Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.15rem; }
.m-script .lm-ic { border-radius: 50%; }
.m-slab .lm-name { font-family: Rockwell, "Roboto Slab", "Courier New", serif; font-weight: 800; text-transform: uppercase; font-size: 0.92rem; letter-spacing: .02em; }
.m-slab .lm-ic { border-radius: 2px; }
.m-round .lm-name { font-family: var(--sans); font-weight: 800; text-transform: lowercase; letter-spacing: -0.02em; }
.m-round .lm-ic { border-radius: 50%; background: currentColor; }
.m-round .lm-ic :global(.ic) { stroke: var(--card); }
.m-condensed .lm-name { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: 1.2rem; letter-spacing: .01em; }
.m-mono .lm-name { font-family: var(--code); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; letter-spacing: .08em; }
.m-mono .lm-ic { border-radius: 0; }
</style>
