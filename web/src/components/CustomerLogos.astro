  "Barishal Honey": `<path d="M16 6l9 5v10l-9 5-9-5V11zM34 16l9 5v10l-9 5-9-5V21zM16 26l9 5v10l-9 5-9-5V31z" fill="c" opacity=".55"/><path d="M34 2c4 6 7 9 7 13a7 7 0 0 1-14 0c0-4 3-7 7-13z" fill="c"/>`,
  "Cool Point Services": `<circle cx="24" cy="24" r="22" fill="c"/><path d="M24 9v30M11 16.5l26 15M11 31.5l26-15" stroke="w" stroke-width="2.6" stroke-linecap="round"/><path d="M20 11l4 4 4-4M20 37l4-4 4 4M12.5 21l5.5-1-1.5-5M35.5 27l-5.5 1 1.5 5M12.5 27l5.5 1-1.5 5M35.5 21l-5.5-1 1.5-5" stroke="w" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
