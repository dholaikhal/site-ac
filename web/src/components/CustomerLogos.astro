const emblem = (name: string) =>
  `<svg viewBox="0 0 48 48" aria-hidden="true">${(EMBLEM[name] ?? "").replaceAll('="c"', '="currentColor"').replaceAll('="w"', '="#fff"')}</svg>`; // currentColor: lighter in dark mode
---
{show && (
<section class="logos-band" aria-labelledby="logos-h">
  <div class="wrap">
    <p class="logos-h" id="logos-h">Shops that sell with Amader Cloud</p>
    <ul class="logo-wall">
      {logos.map((l) => (
        <li class={`lm m-${l.mark}`} title={l.kind} style={`--c:${l.color}`}>
          <span class="lm-em" set:html={emblem(l.name)} />
          <span class="lm-name">{l.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
)}

<style>
.logos-band { padding-block: clamp(28px, 4vw, 44px); background: var(--card); border-bottom: 1px solid var(--rule); }
.logos-h { margin: 0 0 18px; text-align: center; font-weight: 700; font-size: 0.82rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); }
/* Equal tiles, each logo centred in its own: the same gap between every pair, whatever the name's length */
.logo-wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 1100px) { .logo-wall { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
@media (max-width: 640px) { .logo-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; } }
.lm { display: flex; align-items: center; justify-content: center; gap: 10px; height: 76px; padding: 0 12px; border-radius: 10px; background: var(--wash-2); box-shadow: inset 0 0 0 1px var(--rule); color: var(--c); transition: transform .2s, box-shadow .2s; }
:root[data-theme="dark"] .lm { color: color-mix(in srgb, var(--c) 55%, #fff); }
.lm:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -16px rgb(20 33 61 / .5); }
.lm-em { flex: none; width: 38px; height: 38px; }
.lm-em :global(svg) { width: 100%; height: 100%; display: block; }
.lm-name { font-size: 1rem; line-height: 1.05; min-width: 0; text-align: left; }
.m-serif .lm-name { font-family: Georgia, "Times New Roman", serif; font-weight: 700; letter-spacing: -0.01em; }
.m-script .lm-name { font-family: Georgia, serif; font-style: italic; font-weight: 400; font-size: 1.1rem; }
.m-slab .lm-name { font-family: Rockwell, "Roboto Slab", "Courier New", serif; font-weight: 800; text-transform: uppercase; font-size: 0.86rem; letter-spacing: .02em; }
.m-round .lm-name { font-family: var(--sans); font-weight: 800; text-transform: lowercase; letter-spacing: -0.02em; font-size: 1.05rem; }
.m-condensed .lm-name { font-family: var(--display); font-weight: 900; text-transform: uppercase; font-size: 1.1rem; letter-spacing: .01em; }
.m-mono .lm-name { font-family: var(--code); font-weight: 700; text-transform: uppercase; font-size: 0.74rem; letter-spacing: .06em; }
</style>
