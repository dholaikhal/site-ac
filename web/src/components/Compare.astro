---
// Where a seller can go today, side by side. Categories, not named products.
type V = true | false | string;
const cols = ["A Facebook page alone", "A website from an agency", "Global AI app builders", "Amader Cloud"];
const rows: [string, V[]][] = [
  ["Checkout by bKash, Nagad or card", ["Manual", true, "Build it yourself", true]],
  ["Courier booking", [false, "Extra work", "Build it yourself", true]],
  ["Change it yourself, by asking", [true, false, true, true]],
  ["Priced in taka, paid by bKash", [true, true, false, true]],
  ["Live the same day", [true, false, true, true]],
  ["Hosting, backups and updates included", [true, "Extra fee", "Partly", true]],
];
const cell = (v: V) => (v === true ? "✓" : v === false ? "—" : v);
---
<div class="table-wrap cmp">
  <table>
    <thead><tr><th scope="col"><span class="sr">Feature</span></th>{cols.map((c, i) => <th scope="col" class:list={{ us: i === 3 }}>{c}</th>)}</tr></thead>
    <tbody>
      {rows.map(([label, vals]) => (
        <tr><th scope="row">{label}</th>{vals.map((v, i) => <td class:list={{ us: i === 3, yes: v === true, no: v === false }}>{cell(v)}</td>)}</tr>
      ))}
    </tbody>
  </table>
</div>
<style>
.cmp table { min-width: 720px; }
.cmp th[scope="row"] { background: transparent; font-size: 0.95rem; }
.cmp thead th { font-size: 0.9rem; vertical-align: bottom; }
.cmp td { text-align: center; color: var(--ink-2); font-size: 0.9rem; }
.cmp td.yes { color: var(--ok); font-weight: 900; font-size: 1.15rem; }
.cmp td.no { color: var(--ink-2); }
.cmp .us { background: var(--yellow-wash); }
.cmp thead th.us { background: var(--green); color: var(--yellow); font-family: var(--display); font-size: 1.35rem; font-weight: 800; }
</style>
