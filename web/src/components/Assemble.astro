---
// "Built from parts that already work": a constellation of tested blocks around a phone. Five of them
// (marked data-part) light up in turn and fly into the phone, assembling a real checkout; the rest show
// what else a business app can be made of. Script: src/scripts/assemble.js.
import Device from "./Device.astro";
import Brand from "./Brand.astro";
import { icon } from "../scripts/app-art.js";
type Tile = { t: string; g: "store" | "pay" | "ship" | "msg" | "book" | "owner"; i: string; logos?: string[]; part?: number };
// Two rings of linked blocks around the phone. The inner ring holds the checkout's five parts; the outer ring,
// offset half a step, holds the rest of what a business app is commonly built from.
const innerRing: Tile[] = [
  { t: "Header and menu", g: "store", i: "menu", part: 0 },
  { t: "Product catalogue", g: "store", i: "grid" },
  { t: "Checkout steps", g: "store", i: "list", part: 1 },
  { t: "Coupons and offers", g: "store", i: "percent" },
  { t: "Order summary", g: "store", i: "receipt", part: 2 },
  { t: "Courier booking", g: "ship", i: "truck", logos: ["pathao", "steadfast", "redx"] },
  { t: "Delivery address", g: "ship", i: "pin", part: 3 },
  { t: "Order SMS", g: "msg", i: "chat" },
  { t: "Payments", g: "pay", i: "card", logos: ["bkash", "nagad", "visa"], part: 4 },
  { t: "WhatsApp updates", g: "msg", i: "chat", logos: ["whatsapp"] },
  { t: "Cash on delivery", g: "pay", i: "cash" },
  { t: "Sales dashboard", g: "owner", i: "chart" },
];
const outerRing: Tile[] = [
  { t: "Sizes and colours", g: "store", i: "tag" }, { t: "Booking calendar", g: "book", i: "cal" }, { t: "Stock counts", g: "store", i: "box" },
  { t: "Refunds", g: "pay", i: "undo" }, { t: "Delivery zones", g: "ship", i: "map" }, { t: "Deposits", g: "book", i: "coin" },
  { t: "Messenger chat", g: "msg", i: "chat", logos: ["messenger"] }, { t: "VAT invoices", g: "pay", i: "receipt" }, { t: "Google Sheets export", g: "owner", i: "grid", logos: ["googlesheets"] },
  { t: "Order tracking", g: "ship", i: "route" }, { t: "Serial numbers", g: "book", i: "hash" }, { t: "Bank transfer", g: "pay", i: "bank", logos: ["brac", "dbbl"] },
  { t: "Reviews", g: "store", i: "star" }, { t: "Reminders", g: "book", i: "bell" }, { t: "Facebook catalogue", g: "owner", i: "grid", logos: ["facebook"] },
  { t: "Fee receipts", g: "book", i: "receipt" }, { t: "Staff logins", g: "owner", i: "users" }, { t: "Daily backups", g: "owner", i: "shield" },
];
// Placed in pixels from the phone's centre so the rings hug the device at any stage width.
// A squarish superellipse keeps blocks off the phone's corners.
const ring = (list: Tile[], A: number, B: number, offset = 0, e = 0.4) => list.map((tile, i) => {
  const a = -Math.PI / 2 + ((i + offset) / list.length) * Math.PI * 2 + Math.PI / list.length;
  const c = Math.cos(a), sn = Math.sin(a);
  return { ...tile, dx: Math.round(A * Math.sign(c) * Math.abs(c) ** e), dy: Math.round(B * Math.sign(sn) * Math.abs(sn) ** e) };
});
const INNER = { A: 320, B: 352 }, OUTER = { A: 535, B: 432 };
const tiles = [...ring(innerRing, INNER.A, INNER.B), ...ring(outerRing, OUTER.A, OUTER.B, 0.5)];
// In the gaps that are left, faint unlinked blocks: other things a business might ask for.
const more: [string, string][] = [
  ["Loyalty points", "star"], ["Pre-orders", "cal"], ["Flash sales", "percent"], ["Wholesale prices", "tag"], ["POS for the counter", "cash"],
  ["Low-stock alerts", "bell"], ["Instalments", "coin"], ["Table booking", "cal"], ["QR menu", "grid"], ["Attendance", "check"],
  ["Prescription upload", "camera"], ["QR tickets", "ticket"], ["Your own domain", "home"], ["Bangla and English", "chat"], ["Gift cards", "card"],
  ["Barcode labels", "hash"], ["Returns", "undo"], ["Pickup from the store", "pin"], ["Due collection", "coin"], ["Expense tracker", "chart"],
  ["Class schedule", "cal"], ["Exam results", "list"], ["Lab reports", "receipt"], ["Rider tracking", "route"], ["Waitlist", "list"],
  ["Membership cards", "card"], ["Subscriptions", "cal"], ["Two-step login", "shield"], ["Live chat", "chat"], ["Photo gallery", "camera"],
  ["Service areas", "map"], ["Quotes", "receipt"], ["Multiple branches", "home"], ["Supplier orders", "truck"], ["Donations", "heart"],
];
const inside = (x: number, y: number, A: number, B: number) => (Math.abs(x) / A) ** 5 + (Math.abs(y) / B) ** 5 < 1;
const clear = (x: number, y: number, w: number) =>
  !inside(x, y, INNER.A + 40, INNER.B + 20) && !tiles.some((t) => Math.abs(t.dx - x) < 95 + w / 2 && Math.abs(t.dy - y) < 46);
const fieldTiles = (() => {
  const out: { t?: string; i?: string; dx: number; dy: number; d: number; w?: number }[] = [];
  let n = 0, row = 0;
  for (let y = -440; y <= 440 && n < more.length; y += 58, row++) {
    for (let x = -760 + (row % 2 ? 85 : 0); x <= 760 && n < more.length; x += 170) {
      if (!clear(x, y, 150)) continue;
      const [t, i] = more[n++];
      out.push({ t, i, dx: x, dy: y, d: (out.length * 7) % 23 });
    }
  }
  // Blank template blocks in whatever space is still empty: more where these came from.
  row = 0;
  for (let y = -450; y <= 450; y += 40, row++) {
    for (let x = -770 + (row % 2 ? 48 : 0); x <= 770; x += 96) {
      if (!clear(x, y, 80)) continue;
      if (out.some((o) => Math.abs(o.dx - x) < (o.t ? 125 : 90) && Math.abs(o.dy - y) < 34)) continue;
      out.push({ dx: x, dy: y, d: (out.length * 7) % 23, w: 1 + (out.length % 3) });
    }
  }
  return out;
})();
const groups = { store: "Store", pay: "Payments", ship: "Delivery", msg: "Messages", book: "Bookings and fees", owner: "Owner tools" };
---
<figure class="asm" data-asm aria-label="Tested blocks around a phone; five of them assemble a checkout (animation)">
  <div class="stage">
    <ul class="field" aria-hidden="true">
      {fieldTiles.map((f) => f.t
        ? <li style={`--dx:${f.dx}px;--dy:${f.dy}px;--t:${f.d}`}><span set:html={icon(f.i!)} />{f.t}</li>
        : <li class="ghost" style={`--dx:${f.dx}px;--dy:${f.dy}px;--t:${f.d};--w:${f.w}`}><i></i><b></b></li>)}
    </ul>
    <svg class="lines" aria-hidden="true">
      {tiles.map((t) => <line x1={t.dx} y1={t.dy} x2="0" y2="0" class:list={[t.g, { part: t.part !== undefined }]} />)}
    </svg>
    <ul class="tiles">
      {tiles.map((t, i) => (
        <li class:list={["tile", t.g, { part: t.part !== undefined }]} data-part={t.part} style={`--dx:${t.dx}px;--dy:${t.dy}px;--d:${i}`}>
          <span class="ti" set:html={icon(t.i)} />
          <span class="tx"><span class="tt">{t.t}</span>{t.logos && <span class="tl">{t.logos.map((id) => <Brand id={id as any} h={13} />)}</span>}</span>
        </li>
      ))}
    </ul>
    <div class="asm-phone">
      <Device kind="phone">
        <div class="phone-url"><span>goldweave.amader.cloud/checkout</span></div>
        <div class="screen" data-asm-screen></div>
      </Device>
      <span class="asm-ok" data-asm-ok>✓ Checked, previewed, undoable</span>
    </div>
  </div>
  <figcaption class="legend">{Object.entries(groups).map(([g, l]) => <span class={g}><i></i>{l}</span>)}</figcaption>
</figure>
<script src="../scripts/assemble.js"></script>

<style>
.asm { margin: 0; position: relative; }
/* The wider shelf: faint chips across the whole section, a few lighting up in turn */
.field { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.field li { position: absolute; left: calc(50% + var(--dx) * var(--k)); top: calc(50% + var(--dy)); translate: -50% -50%; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 5px 11px 5px 8px; border-radius: 999px; border: 1px solid rgb(255 255 255 / .14); color: rgb(255 255 255 / .42); font-size: 0.74rem; font-weight: 700; background: rgb(255 255 255 / .03); animation: twinkle 12s ease-in-out infinite; animation-delay: calc(var(--t) * -0.52s); }
.field li :global(.ic) { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
@keyframes twinkle { 0%, 82%, 100% { color: rgb(255 255 255 / .42); border-color: rgb(255 255 255 / .14); } 88%, 94% { color: var(--yellow); border-color: rgb(255 204 0 / .55); background: rgb(255 204 0 / .08); } }
/* Blank template blocks: an icon square and a text bar, outlines only */
.field li.ghost { width: calc(46px + var(--w) * 14px); height: 24px; padding: 0 8px; gap: 7px; border-style: dashed; border-color: rgb(255 255 255 / .12); background: transparent; animation: none; }
.field li.ghost i { width: 14px; height: 14px; border-radius: 4px; background: rgb(255 255 255 / .1); flex: none; }
.field li.ghost b { flex: 1; height: 6px; border-radius: 3px; background: rgb(255 255 255 / .1); }
@media (max-width: 980px) { .field { display: none; } }
@media (prefers-reduced-motion: reduce) { .field li { animation: none; } }
.stage { position: relative; height: 940px; width: min(1440px, calc(100vw - 24px)); margin-left: 50%; translate: -50% 0; }
.stage { --k: 1; }
@media (max-width: 1260px) { .stage { --k: .9; } }
@media (max-width: 1120px) { .stage { --k: .8; } }
.lines { position: absolute; left: 50%; top: 50%; width: 1px; height: 1px; overflow: visible; scale: var(--k) 1; }
.lines line { stroke: rgb(255 255 255 / .16); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-dasharray: 3 5; }
.lines line.part { stroke: rgb(255 204 0 / .55); }
.tiles { list-style: none; margin: 0; padding: 0; }
.tile { --c: #14213d; position: absolute; left: calc(50% + var(--dx) * var(--k)); top: calc(50% + var(--dy)); translate: -50% -50%; z-index: 1; display: flex; align-items: center; gap: 9px; padding: 6px 11px 6px 6px; width: max-content; max-width: 190px; background: #fff; color: #14213d; border-radius: 12px; border: 1px solid rgb(20 33 61 / .08); box-shadow: 0 1px 0 rgb(255 255 255 / .6) inset, 0 14px 30px -18px rgb(0 0 0 / .7); font-weight: 700; font-size: 0.82rem; line-height: 1.2; animation: drift 7s ease-in-out infinite; animation-delay: calc(var(--d) * -0.6s); transition: scale .25s, box-shadow .25s; }
.tile.store { --c: var(--green); } .tile.pay { --c: var(--red); } .tile.ship { --c: #d98f00; } .tile.msg { --c: #0b8ad9; } .tile.book { --c: #8b3fb5; } .tile.owner { --c: #14213d; }
.ti { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--c); color: #fff; }
.ti :global(.ic) { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.tx { display: grid; gap: 4px; text-align: left; }
.tile:hover { scale: 1.06; z-index: 3; }
.tl { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.tl :global(.brand-word) { font-size: 9.5px !important; }
@keyframes drift { 50% { translate: -50% calc(-50% - 6px); } }
.tile.part.go { scale: 1.12; z-index: 3; box-shadow: 0 0 0 3px var(--yellow), 0 16px 30px -12px rgb(0 0 0 / .6); }
.tile.part.done::after { content: "✓"; position: absolute; top: -9px; right: -9px; width: 20px; height: 20px; border-radius: 50%; background: var(--ok); color: #fff; font-size: 0.7rem; display: grid; place-items: center; }
.asm-phone { position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 2; display: grid; justify-items: center; gap: 10px; }
.asm-ok { font-weight: 800; font-size: 0.85rem; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; opacity: 0; translate: 0 8px; transition: opacity .3s, translate .4s cubic-bezier(.2,.8,.2,1.4); }
.asm-ok.on { opacity: 1; translate: 0 0; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; margin-top: 18px; font-weight: 700; font-size: 0.85rem; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 12px; height: 12px; border-radius: 3px; background: var(--c); }
.legend .store { --c: var(--green); } .legend .pay { --c: var(--red); } .legend .ship { --c: #d98f00; } .legend .msg { --c: #0b8ad9; } .legend .book { --c: #8b3fb5; } .legend .owner { --c: #c9d2e3; }
.asm :global(.b.asm-wait) { opacity: 0; }
.asm :global(.b.asm-fly) { animation: asm-fly .6s cubic-bezier(.2,.75,.25,1) both; }
@keyframes asm-fly { from { transform: translate(var(--dx), var(--dy)) scale(.3); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
/* Narrow screens: the phone first, the blocks as a wrapped shelf below it */
@media (max-width: 980px) {
  .stage { height: auto; width: auto; margin-left: 0; translate: none; display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .lines { display: none; }
  .asm-phone { position: static; translate: none; order: -1; }
  .tiles { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .tile { position: relative; left: auto; top: auto; translate: none; min-width: 0; animation: none; }
}
@media (prefers-reduced-motion: reduce) { .tile { animation: none; } }
</style>
