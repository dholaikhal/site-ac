---
// "Built from parts that already work": a constellation of tested blocks around a phone. Five of them
// (marked data-part) light up in turn and fly into the phone, assembling a real checkout; the rest show
// what else a business app can be made of. Script: src/scripts/assemble.js.
import Device from "./Device.astro";
import Brand from "./Brand.astro";
import { icon } from "../scripts/app-art.js";
type Tile = { t: string; g: "store" | "pay" | "ship" | "msg" | "book" | "owner"; i: string; logos?: string[]; part?: number };
// Two rings of linked blocks around the phone. The inner ring holds the checkout's five parts; the outer ring,
// offset half a step, holds the rest of what a business app is commonly built from.
const innerRing: Tile[] = [
  { t: "Header and menu", g: "store", i: "menu", part: 0 },
  { t: "Product catalogue", g: "store", i: "grid" },
  { t: "Checkout steps", g: "store", i: "list", part: 1 },
  { t: "Coupons and offers", g: "store", i: "percent" },
  { t: "Order summary", g: "store", i: "receipt", part: 2 },
  { t: "Courier booking", g: "ship", i: "truck", logos: ["pathao", "steadfast", "redx"] },
  { t: "Delivery address", g: "ship", i: "pin", part: 3 },
  { t: "Order SMS", g: "msg", i: "chat" },
  { t: "Payments", g: "pay", i: "card", logos: ["bkash", "nagad", "visa"], part: 4 },
  { t: "WhatsApp updates", g: "msg", i: "chat", logos: ["whatsapp"] },
  { t: "Cash on delivery", g: "pay", i: "cash" },
  { t: "Sales dashboard", g: "owner", i: "chart" },
];
const outerRing: Tile[] = [
  { t: "Sizes and colours", g: "store", i: "tag" }, { t: "Booking calendar", g: "book", i: "cal" }, { t: "Stock counts", g: "store", i: "box" },
  { t: "Refunds", g: "pay", i: "undo" }, { t: "Delivery zones", g: "ship", i: "map" }, { t: "Deposits", g: "book", i: "coin" },
  { t: "Messenger chat", g: "msg", i: "chat", logos: ["messenger"] }, { t: "VAT invoices", g: "pay", i: "receipt" }, { t: "Google Sheets export", g: "owner", i: "grid", logos: ["googlesheets"] },
  { t: "Order tracking", g: "ship", i: "route" }, { t: "Serial numbers", g: "book", i: "hash" }, { t: "Bank transfer", g: "pay", i: "bank", logos: ["brac", "dbbl"] },
  { t: "Reviews", g: "store", i: "star" }, { t: "Reminders", g: "book", i: "bell" }, { t: "Facebook catalogue", g: "owner", i: "grid", logos: ["facebook"] },
  { t: "Fee receipts", g: "book", i: "receipt" }, { t: "Staff logins", g: "owner", i: "users" }, { t: "Daily backups", g: "owner", i: "shield" },
];
// Placed in pixels from the phone's centre so the rings hug the device at any stage width.
// Blocks sit at equal steps along a rounded rectangle, not at equal angles (which would bunch them in the
// corners and leave the phone's sides bare). Vertical travel counts double: blocks are wide and short.
const ring = (list: Tile[], A: number, B: number, offset = 0, r = 0.45) => {
  const R = r * Math.min(A, B), pts: [number, number][] = [[0, -B]];
  for (const [cx, cy, from] of [[A - R, -B + R, -90], [A - R, B - R, 0], [-A + R, B - R, 90], [-A + R, -B + R, 180]]) {
    for (let k = 0; k <= 12; k++) { const t = ((from + (k / 12) * 90) * Math.PI) / 180; pts.push([cx + R * Math.cos(t), cy + R * Math.sin(t)]); }
  }
  pts.push([0, -B]);
  const len = [0];
  for (let s = 1; s < pts.length; s++) len.push(len[s - 1] + Math.hypot(pts[s][0] - pts[s - 1][0], 2 * (pts[s][1] - pts[s - 1][1])));
  const total = len[len.length - 1];
  return list.map((tile, i) => {
    const want = (((i + 0.5 + offset) / list.length) % 1) * total;
    const s = Math.max(1, len.findIndex((l) => l >= want)), f = (want - len[s - 1]) / (len[s] - len[s - 1] || 1);
    return { ...tile, dx: Math.round(pts[s - 1][0] + f * (pts[s][0] - pts[s - 1][0])), dy: Math.round(pts[s - 1][1] + f * (pts[s][1] - pts[s - 1][1])) };
  });
};
const INNER = { A: 320, B: 352 }, OUTER = { A: 535, B: 432 };
const tiles = [...ring(innerRing, INNER.A, INNER.B), ...ring(outerRing, OUTER.A, OUTER.B, 0.5)];
// Narrow screens: blocks packed like bricks either side of the phone, rows of one or two with ragged starts,
// running off the screen's edges. The two sides mirror each other's rhythm, and left-hand blocks read mirrored
// so every icon faces the phone. Each checkout part leads a row level with where it lands on the phone's screen.
const est = (t: Tile) => Math.min(190, Math.max(60 + t.t.length * 7.4, 50 + (t.logos?.length ?? 0) * 44));
const mobile = (() => {
  const GAP = 148, STEP = 64, JAG = [0, 28, 10, 40, 4, 22, 34, 14, 46];
  const per = [2, 1, 2, 2, 1, 2, 2, 1, 2];
  const slots = [-1, 1].flatMap((side) => per.flatMap((n, r) => Array.from({ length: n }, (_, pos) => ({ side, r, pos, tile: -1 }))));
  const at = [1, 3, 4, 5, 7];
  tiles.forEach((t, i) => { if (t.part !== undefined) slots.find((sl) => sl.pos === 0 && sl.side === (t.part! % 2 ? 1 : -1) && sl.r === at[t.part!])!.tile = i; });
  let n = 0;
  tiles.forEach((t, i) => {
    if (t.part !== undefined) return;
    const free = slots.filter((sl) => sl.tile < 0), pos = Math.min(...free.map((sl) => sl.pos)), side = n++ % 2 ? 1 : -1;
    (free.find((sl) => sl.pos === pos && sl.side === side) ?? free.find((sl) => sl.pos === pos)!).tile = i;
  });
  const out: { mx: number; my: number; mtx: string; side: string }[] = [];
  for (const sl of slots) {
    const jag = JAG[sl.r];
    const lead = slots.find((o) => o.side === sl.side && o.r === sl.r && o.pos === 0)!;
    const x = GAP + jag + (sl.pos ? est(tiles[lead.tile]) + 16 : 0);
    out[sl.tile] = { mx: sl.side * x, my: (sl.r - 4) * STEP, mtx: sl.side < 0 ? "-100%" : "0%", side: sl.side < 0 ? "l" : "r" };
  }
  return out;
})();
// Outside the rings, faint unlinked blocks: other things a business might ask for.
const more: [string, string][] = [
  ["Loyalty points", "star"], ["Pre-orders", "cal"], ["Flash sales", "percent"], ["Wholesale prices", "tag"], ["POS for the counter", "cash"],
  ["Low-stock alerts", "bell"], ["Instalments", "coin"], ["Table booking", "cal"], ["QR menu", "grid"], ["Attendance", "check"],
  ["Prescription upload", "camera"], ["QR tickets", "ticket"], ["Your own domain", "home"], ["Bangla and English", "chat"], ["Gift cards", "card"],
  ["Barcode labels", "hash"], ["Returns", "undo"], ["Pickup from the store", "pin"], ["Due collection", "coin"], ["Expense tracker", "chart"],
  ["Class schedule", "cal"], ["Exam results", "list"], ["Lab reports", "receipt"], ["Rider tracking", "route"], ["Waitlist", "list"],
  ["Membership cards", "card"], ["Subscriptions", "cal"], ["Two-step login", "shield"], ["Live chat", "chat"], ["Photo gallery", "camera"],
  ["Service areas", "map"], ["Quotes", "receipt"], ["Multiple branches", "home"], ["Supplier orders", "truck"], ["Donations", "heart"],
];
const inside = (x: number, y: number, A: number, B: number) => (Math.abs(x) / A) ** 5 + (Math.abs(y) / B) ** 5 < 1;
// Free of the phone, of the inner ring, and of every linked block with some air around it.
const clear = (x: number, y: number, w: number) =>
  !inside(x, y, INNER.A + 40, INNER.B + 20) && !tiles.some((t) => Math.abs(t.dx - x) < 98 + w / 2 && Math.abs(t.dy - y) < (t.logos ? 60 : 48));
// Unlinked blocks fill the spaces among the rings as well as the field outside them.
const among = (x: number, y: number) => inside(x, y, OUTER.A + 70, OUTER.B + 40);
const fieldTiles = (() => {
  const out: { t?: string; i?: string; dx: number; dy: number; d: number; w?: number }[] = [];
  const spots: [number, number][] = [];
  let row = 0;
  for (let y = -440; y <= 440; y += 58, row++) {
    for (let x = -1300 + (row % 2 ? 85 : 0); x <= 1300; x += 170) if (clear(x, y, 150)) spots.push([x, y]);
  }
  const even = (list: [number, number][], k: number) => Array.from({ length: Math.min(k, list.length) }, (_, j) => list[Math.floor((j * list.length) / Math.min(k, list.length))]);
  // Among the rings, a finer grid finds the narrow gaps between linked blocks; taken greedily, without overlaps.
  const inRing: [number, number][] = [];
  for (let y = -430; y <= 430; y += 29) {
    for (let x = -640; x <= 640; x += 40) {
      if (!among(x, y) || !clear(x, y, 140)) continue;
      if (inRing.some(([px, py]) => Math.abs(px - x) < 160 && Math.abs(py - y) < 40)) continue;
      inRing.push([x, y]);
    }
  }
  // Outside: nearest the rings first, so narrower screens still see names before the field is cut off.
  const outside = spots.filter(([x, y]) => !among(x, y)).sort((p, q) => Math.abs(p[0]) - Math.abs(q[0]));
  const k = Math.min(16, inRing.length);
  const near = even(inRing, k);
  const far = outside.filter(([x, y]) => !near.some(([px, py]) => Math.abs(px - x) < 170 && Math.abs(py - y) < 40));
  const named = [...near, ...even(far.slice(0, (more.length - k) * 2), more.length - k)];
  named.forEach(([x, y], n) => { const [t, i] = more[n]; out.push({ t, i, dx: x, dy: y, d: (n * 7) % 23 }); });
  // Blank template blocks in whatever space is still empty: more where these came from.
  row = 0;
  for (let y = -450; y <= 450; y += 40, row++) {
    for (let x = -1310 + (row % 2 ? 48 : 0); x <= 1310; x += 96) {
      if (!clear(x, y, 80)) continue;
      if (out.some((o) => Math.abs(o.dx - x) < (o.t ? 125 : 90) && Math.abs(o.dy - y) < 34)) continue;
      out.push({ dx: x, dy: y, d: (out.length * 7) % 23, w: 1 + (out.length % 3) });
    }
  }
  return out;
})();
// Tablet widths: unlinked blocks packed into the gaps beside and between the bricks, sweeping out from the phone.
type Box = [number, number, number, number];
const fieldMobile = (() => {
  const taken: Box[] = tiles.map((t, i) => {
    const m = mobile[i], w = est(t), h = t.logos ? 33 : 24;
    return [m.side === "l" ? m.mx - w : m.mx, m.my - h, m.side === "l" ? m.mx : m.mx + w, m.my + h];
  });
  const fits = (b: Box) => !taken.some((o) => b[0] < o[2] + 10 && o[0] < b[2] + 10 && b[1] < o[3] + 6 && o[1] < b[3] + 6);
  const out: { t?: string; i?: string; dx: number; dy: number; d: number; w?: number }[] = [];
  let named = 0, placed = 0;
  // Rows on the bricks' own rows and halfway between, so the gaps at row ends line up with something.
  for (let y = -320; y <= 320; y += 32) {
    for (const side of [-1, 1]) {
      for (let edge = 150; edge < 720; edge += 8) {
        // A named chip at its own width when it's due and fits; otherwise a blank one, shrunk to the gap.
        const blanks = [3, 2, 1].map((k) => 46 + k * 14);
        const sizes = placed % 3 === 0 && named < more.length ? [40 + more[named][0].length * 6.2, ...blanks] : blanks;
        const pick = sizes.findIndex((sz) => { const x0 = side < 0 ? -edge - sz : edge; return fits([x0, y - 13, x0 + sz, y + 13]); });
        if (pick < 0) continue;
        const w = sizes[pick], isNamed = sizes.length > blanks.length && pick === 0;
        const x0 = side < 0 ? -edge - w : edge;
        taken.push([x0, y - 13, x0 + w, y + 13]);
        const dx = Math.round(x0 + w / 2);
        if (isNamed) { const [t, i] = more[named++]; out.push({ t, i, dx, dy: y, d: (placed * 7) % 23 }); }
        else out.push({ dx, dy: y, d: (placed * 7) % 23, w: (w - 46) / 14 });
        placed++;
        edge += w;
      }
    }
  }
  return out;
})();
const groups = { store: "Store", pay: "Payments", ship: "Delivery", msg: "Messages", book: "Bookings and fees", owner: "Owner tools" };
---
<figure class="asm" data-asm aria-label="Tested blocks around a phone; five of them assemble a checkout (animation)">
  <div class="stage">
    <ul class="field" aria-hidden="true">
      {fieldTiles.map((f) => f.t
        ? <li style={`--dx:${f.dx}px;--dy:${f.dy}px;--t:${f.d}`}><span set:html={icon(f.i!)} />{f.t}</li>
        : <li class="ghost" style={`--dx:${f.dx}px;--dy:${f.dy}px;--t:${f.d};--w:${f.w}`}><i></i><b></b></li>)}
    </ul>
    <ul class="field field-m" aria-hidden="true">
      {fieldMobile.map((f) => f.t
        ? <li style={`--dx:${f.dx}px;--dy:${f.dy}px;--t:${f.d}`}><span set:html={icon(f.i!)} />{f.t}</li>
        : <li class="ghost" style={`--dx:${f.dx}px;--dy:${f.dy}px;--t:${f.d};--w:${f.w}`}><i></i><b></b></li>)}
    </ul>
    <svg class="lines" aria-hidden="true">
      {tiles.map((t) => <line x1={t.dx} y1={t.dy} x2="0" y2="0" class:list={[t.g, { part: t.part !== undefined }]} />)}
    </svg>
    <ul class="tiles">
      {tiles.map((t, i) => (
        <li class:list={["tile", t.g, { part: t.part !== undefined }]} data-part={t.part} data-side={mobile[i].side} style={`--dx:${t.dx}px;--dy:${t.dy}px;--mx:${mobile[i].mx}px;--my:${mobile[i].my}px;--mtx:${mobile[i].mtx};--d:${i}`}>
          <span class="ti" set:html={icon(t.i)} />
          <span class="tx"><span class="tt">{t.t}</span>{t.logos && <span class="tl">{t.logos.map((id) => <Brand id={id as any} h={13} />)}</span>}</span>
        </li>
      ))}
    </ul>
    <div class="asm-phone">
      <Device kind="phone">
        <div class="phone-url"><span>goldweave.amader.cloud/checkout</span></div>
        <div class="screen" data-asm-screen></div>
      </Device>
      <span class="asm-ok" data-asm-ok>✓ Checked, previewed, undoable</span>
    </div>
  </div>
  <figcaption class="legend">{Object.entries(groups).map(([g, l]) => <span class={g}><i></i>{l}</span>)}</figcaption>
</figure>
<script src="../scripts/assemble.js"></script>

<style>
.asm { margin: 0; position: relative; }
/* The wider shelf: faint chips across the whole section, a few lighting up in turn */
.field { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.field li { position: absolute; left: calc(50% + var(--dx)); top: calc(50% + var(--dy)); translate: -50% -50%; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; padding: 5px 11px 5px 8px; border-radius: 999px; border: 1px solid rgb(255 255 255 / .14); color: rgb(255 255 255 / .42); font-size: 0.74rem; font-weight: 700; background: rgb(255 255 255 / .03); animation: twinkle 12s ease-in-out infinite; animation-delay: calc(var(--t) * -0.52s); }
.field li :global(.ic) { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
@keyframes twinkle { 0%, 82%, 100% { color: rgb(255 255 255 / .42); border-color: rgb(255 255 255 / .14); } 88%, 94% { color: var(--yellow); border-color: rgb(255 204 0 / .55); background: rgb(255 204 0 / .08); } }
/* Blank template blocks: an icon square and a text bar, outlines only */
.field li.ghost { width: calc(46px + var(--w) * 14px); height: 24px; padding: 0 8px; gap: 7px; border-style: dashed; border-color: rgb(255 255 255 / .12); background: transparent; animation: none; }
.field li.ghost i { width: 14px; height: 14px; border-radius: 4px; background: rgb(255 255 255 / .1); flex: none; }
.field li.ghost b { flex: 1; height: 6px; border-radius: 3px; background: rgb(255 255 255 / .1); }
.field-m { display: none; }
@media (max-width: 980px) { .field { display: none; } .field-m { display: block; } }
/* Phones: the phone and its bricks fill the width; nothing left to fill */
@media (max-width: 600px) { .field-m { display: none; } }
@media (prefers-reduced-motion: reduce) { .field li { animation: none; } }
/* Full bleed; on narrower screens the whole constellation scales down evenly, blocks and gaps alike */
.stage { --k: 1; position: relative; height: 940px; zoom: var(--k); width: calc(100vw / var(--k)); margin-left: 50%; translate: -50% 0; }
/* The rings span about 1240px at full size; each step keeps them clear of the screen edges */
@media (max-width: 1340px) { .stage { --k: .94; } }
@media (max-width: 1240px) { .stage { --k: .86; } }
@media (max-width: 1120px) { .stage { --k: .78; } }
@media (max-width: 1040px) { .stage { --k: .72; } }
.lines { position: absolute; left: 50%; top: 50%; width: 1px; height: 1px; overflow: visible; }
.lines line { stroke: rgb(255 255 255 / .16); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-dasharray: 3 5; }
.lines line.part { stroke: rgb(255 204 0 / .55); }
.tiles { list-style: none; margin: 0; padding: 0; }
.tile { --c: #14213d; position: absolute; left: calc(50% + var(--dx)); top: calc(50% + var(--dy)); --tx: -50%; translate: var(--tx) -50%; z-index: 1; display: flex; align-items: center; gap: 9px; padding: 6px 11px 6px 6px; width: max-content; max-width: 190px; background: #fff; color: #14213d; border-radius: 12px; border: 1px solid rgb(20 33 61 / .08); box-shadow: 0 1px 0 rgb(255 255 255 / .6) inset, 0 14px 30px -18px rgb(0 0 0 / .7); font-weight: 700; font-size: 0.82rem; line-height: 1.2; animation: drift 7s ease-in-out infinite; animation-delay: calc(var(--d) * -0.6s); transition: scale .25s, box-shadow .25s; }
.tile.store { --c: var(--green); } .tile.pay { --c: var(--red); } .tile.ship { --c: #d98f00; } .tile.msg { --c: #0b8ad9; } .tile.book { --c: #8b3fb5; } .tile.owner { --c: #14213d; }
.ti { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--c); color: #fff; }
.ti :global(.ic) { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
.tx { display: grid; gap: 4px; text-align: left; }
.tile:hover { scale: 1.06; z-index: 3; }
.tl { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.tl :global(.brand-word) { font-size: 9.5px !important; }
@keyframes drift { 50% { translate: var(--tx) calc(-50% - 6px); } }
.tile.part.go { scale: 1.12; z-index: 3; box-shadow: 0 0 0 3px var(--yellow), 0 16px 30px -12px rgb(0 0 0 / .6); }
.tile.part.done::after { content: "✓"; position: absolute; top: -9px; right: -9px; width: 20px; height: 20px; border-radius: 50%; background: var(--ok); color: #fff; font-size: 0.7rem; display: grid; place-items: center; }
.asm-phone { position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 2; display: grid; justify-items: center; gap: 10px; }
.asm-ok { font-weight: 800; font-size: 0.85rem; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; opacity: 0; translate: 0 8px; transition: opacity .3s, translate .4s cubic-bezier(.2,.8,.2,1.4); }
.asm-ok.on { opacity: 1; translate: 0 0; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; margin-top: 18px; font-weight: 700; font-size: 0.85rem; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 12px; height: 12px; border-radius: 3px; background: var(--c); }
.legend .store { --c: var(--green); } .legend .pay { --c: var(--red); } .legend .ship { --c: #d98f00; } .legend .msg { --c: #0b8ad9; } .legend .book { --c: #8b3fb5; } .legend .owner { --c: #c9d2e3; }
.asm :global(.b.asm-wait) { opacity: 0; }
.asm :global(.b.asm-fly) { animation: asm-fly .6s cubic-bezier(.2,.75,.25,1) both; }
@keyframes asm-fly { from { transform: translate(var(--dx), var(--dy)) scale(.3); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
/* Narrow screens: the linked blocks in columns either side of the phone, clipped at the screen's edges */
@media (max-width: 980px) {
  .stage { --k: 1; height: 700px; overflow: clip; }
  .lines { display: none; }
  .tile { left: calc(50% + var(--mx)); top: calc(50% + var(--my)); --tx: var(--mtx); }
  .tile[data-side="l"] { flex-direction: row-reverse; padding: 6px 6px 6px 11px; }
  .tile[data-side="l"] .tx { text-align: right; }
  .tile[data-side="l"] .tl { justify-content: flex-end; }
}
@media (max-width: 560px) { .stage { --k: .84; } }
@media (prefers-reduced-motion: reduce) { .tile { animation: none; } }
</style>
