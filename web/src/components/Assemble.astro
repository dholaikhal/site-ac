---
// "Built from parts that already work": named parts light up one by one and fly into a phone,
// assembling a real checkout. Script: src/scripts/assemble.js. Uses the demo's apps.
import Device from "./Device.astro";
const parts = [
  ["Header and navigation", "block"],
  ["Order steps", "block"],
  ["Order summary", "block"],
  ["Delivery address", "block"],
  ["bKash · Nagad · Card", "connection"],
] as const;
---
<figure class="asm" data-asm aria-label="Our agent putting a checkout together from tested parts (animation)">
  <ol class="asm-parts">
    {parts.map(([label, kind], i) => <li data-part={i} class={kind}><span class="asm-ic" aria-hidden="true">{kind === "connection" ? "⇄" : "▦"}</span>{label}<em>{kind === "connection" ? "Ready connection" : "Tested block"}</em></li>)}
  </ol>
  <div class="asm-phone">
    <Device kind="phone">
      <div class="phone-url"><span>goldweave.amader.cloud/checkout</span></div>
      <div class="screen" data-asm-screen></div>
    </Device>
    <span class="asm-ok" data-asm-ok>✓ Checked, previewed, undoable</span>
  </div>
</figure>
<script src="../scripts/assemble.js"></script>

<style>
.asm { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px; align-items: center; }
@media (max-width: 560px) { .asm { grid-template-columns: 1fr; justify-items: center; } }
.asm-parts { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.asm-parts li { position: relative; display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: center; padding: 10px 12px; background: var(--card); border: 1.5px solid var(--rule); border-radius: 8px; font-weight: 700; transition: border-color .25s, background-color .25s, translate .25s; }
.asm-parts em { grid-column: 2; font-style: normal; font-weight: 600; font-size: 0.78rem; color: var(--ink-2); }
.asm-ic { grid-row: span 2; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: var(--wash-2); color: var(--ink); font-size: 1.1rem; }
.asm-parts li.connection .asm-ic { background: var(--yellow-wash); }
.asm-parts li.go { border-color: transparent; background: linear-gradient(var(--card), var(--card)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; animation: aiflow 2s linear infinite; translate: 6px 0; }
.asm-parts li.done { border-color: var(--ok); }
.asm-parts li.done .asm-ic { background: var(--ok); color: #fff; }
@keyframes aiflow { to { background-position: 0 0, 300% 0; } }
.asm-phone { display: grid; justify-items: center; gap: 10px; }
.asm-ok { font-weight: 800; font-size: 0.85rem; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; opacity: 0; translate: 0 8px; transition: opacity .3s, translate .4s cubic-bezier(.2,.8,.2,1.4); }
.asm-ok.on { opacity: 1; translate: 0 0; }
.asm :global(.b.asm-wait) { opacity: 0; }
.asm :global(.b.asm-fly) { animation: asm-fly .6s cubic-bezier(.2,.75,.25,1) both; }
@keyframes asm-fly { from { transform: translate(var(--dx), var(--dy)) scale(.3); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .asm-parts li.go { animation: none; } }
</style>
