---
// What every app comes connected to. Brand names are plain text only (no logos).
const items = [
  ["bKash", "Mobile-money checkout through your own merchant account.", "beta", "red"],
  ["Nagad", "Mobile-money checkout, same flow as bKash.", "beta", "red"],
  ["Cards", "Debit and credit cards through a licensed aggregator.", "beta", "red"],
  ["Courier", "A delivery booked when you mark the order as sent. Partners to confirm.", "beta", "green"],
  ["SMS", "Order confirmed, shipped, booking reminders and fee receipts.", "beta", "cobalt"],
  ["Google Sheets", "Export orders, bookings and payments.", "planned", ""],
  ["Facebook catalogue", "Keep your page's catalogue in sync with your shop.", "planned", ""],
  ["VAT invoices", "Invoices in the required format (format to confirm).", "planned", ""],
];
---
<ul class="conn">
  {items.map(([n, d, s, c]) => (
    <li class:list={["conn-i", c, s]}>
      <strong>{n}</strong><span>{d}</span><em>{s === "beta" ? "In the beta" : "Planned"}</em>
    </li>
  ))}
</ul>
<p class="small" style="margin-top:18px">Brand names describe what connects; they are trademarks of their owners and appear as text only. The payment partner and courier partners are being confirmed for the beta.</p>

<style>
.conn { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
@media (max-width: 960px) { .conn { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 520px) { .conn { grid-template-columns: 1fr; } }
.conn-i { border: 2px solid var(--line); border-radius: 8px; padding: 18px; display: grid; gap: 4px; align-content: start; background: var(--card); }
.conn-i strong { font-family: var(--display); font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em; }
.conn-i span { font-size: 0.93rem; line-height: 1.45; }
.conn-i em { font-style: normal; font-weight: 700; font-size: 0.75rem; justify-self: start; margin-top: 6px; padding: 3px 8px; border-radius: 999px; background: rgb(0 0 0 / .18); }
.conn-i.red, .conn-i.green, .conn-i.cobalt { color: #fff; border-color: #14213d; }
.conn-i.red { background: var(--red); } .conn-i.green { background: var(--green); } .conn-i.cobalt { background: var(--blue); }
.conn-i.planned { background: transparent; border-style: dashed; box-shadow: none; }
.conn-i.planned span { color: var(--ink-2); }
.conn-i.planned em { background: var(--wash-2); }
</style>
