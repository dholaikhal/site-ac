---
// What every app comes connected to, with each brand's logo (see data/brands.json).
import Brand from "./Brand.astro";
type Item = [string, string[], string, "beta" | "planned"];
const items: Item[] = [
  ["Mobile wallets", ["bkash", "nagad"], "Checkout through your own merchant account.", "beta"],
  ["Cards", ["visa", "mastercard", "amex"], "Debit and credit cards through a licensed aggregator.", "beta"],
  ["Courier", ["pathao"], "A delivery booked when you mark the order as sent. One courier in the beta.", "beta"],
  ["SMS", [], "Order confirmed, shipped, booking reminders and fee receipts.", "beta"],
  ["Google Sheets", ["googlesheets"], "Export orders, bookings and payments.", "planned"],
  ["Facebook catalogue", ["facebook"], "Keep your page's catalogue in sync with your store.", "planned"],
  ["WhatsApp and Messenger", ["whatsapp", "messenger"], "Order updates where your customers already chat.", "planned"],
  ["VAT invoices", [], "Invoices in the required VAT format.", "planned"],
];
const next = ["steadfast", "redx", "paperfly", "sslcommerz", "rocket", "upay", "brac", "dbbl", "ebl"] as const;
---
<ul class="conn">
  {items.map(([n, logos, d, s]) => (
    <li class:list={["conn-i", s]}>
      <span class="logos">{logos.length ? logos.map((id) => <Brand id={id as any} h={24} />) : <span class="glyph" aria-hidden="true">{n === "SMS" ? "✉" : "Tk"}</span>}</span>
      <strong>{n}</strong><span>{d}</span><em>{s === "beta" ? "In the beta" : "Planned"}</em>
    </li>
  ))}
</ul>
<div class="next-up">
  <p><strong>Next, after the beta</strong> <span class="tag">Not yet integrated</span></p>
  <div class="next-logos">{next.map((id) => <span class="nl"><Brand id={id} h={22} /></span>)}</div>
</div>

<style>
.conn { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
@media (max-width: 960px) { .conn { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 520px) { .conn { grid-template-columns: 1fr; } }
.conn-i { border: 2px solid var(--line); border-radius: 8px; padding: 18px; display: grid; gap: 4px; align-content: start; background: #fff; color: #14213d; }
.logos { display: flex; align-items: center; gap: 12px; min-height: 30px; margin-bottom: 8px; }
.glyph { font-size: 1.5rem; color: var(--green); }
.conn-i strong { font-family: var(--display); font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em; }
.conn-i span { font-size: 0.93rem; line-height: 1.45; }
.conn-i em { font-style: normal; font-weight: 700; font-size: 0.75rem; justify-self: start; margin-top: 6px; padding: 3px 8px; border-radius: 999px; background: #dcefe3; color: #0b5d3b; }
.conn-i.planned { border-style: dashed; }
.conn-i.planned em { background: #eef1f4; color: #4a5670; }
.next-up { margin-top: 26px; }
.next-up p { margin: 0 0 12px; }
.next-logos { display: flex; flex-wrap: wrap; gap: 10px; }
.nl { display: inline-flex; align-items: center; height: 46px; padding: 0 16px; background: #fff; color: #14213d; border: 1.5px solid var(--rule); border-radius: 8px; filter: grayscale(.2); }
</style>
