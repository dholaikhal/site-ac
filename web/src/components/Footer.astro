---
import Logo from "./Logo.astro";
import Social from "./Social.astro";
import { company as c, whatsapp } from "../data/facts";
const tel = (n: string) => `tel:${n.replace(/[^+\d]/g, "")}`;
const cols = [
  ["Company", [["how-it-works.html", "How it works"], ["pricing.html", "Pricing"], ["about.html", "About us"], ["investors.html", "Investors"], ["contact.html", "Contact"]]],
  ["Legal", [["terms.html", "Terms of service"], ["privacy.html", "Privacy policy"], ["terms.html#acceptable-use", "Acceptable use"], ["sources.html", "Sources"]]],
] as const;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a class="brand" href="./"><Logo /><span>Amader Cloud</span></a>
        <address>
          <span>{c.address.join(", ")}</span>
          <a href={`mailto:${c.email.hello}`}>{c.email.hello}</a>
          <a href={tel(c.phone)}>{c.phone}</a>
          <a class="wa-link" href={whatsapp()} target="_blank" rel="noopener">WhatsApp {c.whatsapp}</a>
        </address>
        <Social />
      </div>
      {cols.map(([h, links]) => (
        <nav aria-label={h}>
          <h2>{h}</h2>
          <ul>{links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="fine">
      <span>© <span data-year>2026</span> {c.legalName}</span>
      <span>Trade licence {c.registration.tradeLicence}</span>
    </p>
  </div>
</footer>
