      </div>
      <div>
        <h2>Legal</h2>
        <ul><li><a href="terms.html">Terms of service</a></li><li><a href="privacy.html">Privacy policy</a></li><li><a href="acceptable-use.html">Acceptable use</a></li></ul>
      </div>
    </div>
    <div class="footer-base"><span>© <span data-year>{new Date().getFullYear()}</span> amader.cloud</span><span>Dhaka, Bangladesh</span></div>
  </div>
</footer>
