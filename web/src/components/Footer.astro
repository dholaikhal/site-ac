---
import Sprite from "./Sprite.astro";
import F from "../data/facts.json";
---
<Sprite />
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="./"><svg viewBox="0 0 44 40" aria-hidden="true"><path d="M7 31 L5 34 M28 31 L30 34" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><rect x="1" y="15" width="33" height="16" rx="4.5" fill="currentColor"/><circle cx="26.5" cy="23" r="2.6" style="fill:var(--night)"/><path d="M33 9.5 a6 6 0 0 1 5 5.5 M33 3.5 a12 12 0 0 1 10.5 11.5" fill="none" style="stroke:var(--amber)" stroke-width="2.4" stroke-linecap="round"/></svg><span>amader<span class="tld">.cloud</span></span></a>
        <p>Second jobs for the devices Dhaka already owns.</p>
      </div>
      <div>
        <h2>Service</h2>
        <ul><li><a href="./#how">How it works</a></li><li><a href="devices.html">Check your device</a></li><li><a href="./#plans">Plans</a></li><li><a href="companies.html">For companies</a></li><li><a href="government.html">Public sector</a></li><li><a href="hosts.html">Earn</a></li></ul>
      </div>
      <div>
