---
// The amber network drawn over a photo. Coordinates are in the photo's own pixels (2400 px master).
interface Node { key: string; x: number; y: number; from: string; to: string; far: boolean }
interface Props { scene: { w: number; h: number; par: string; label: string; nodes: Node[]; links: string[]; radio: string[]; far: string[]; rings: string | null } }
const { scene: s } = Astro.props;
const byKey = Object.fromEntries(s.nodes.map((n) => [n.key, n]));
let delay = 0.5;
const links = (["", " radio", " far"] as const).flatMap((kind, k) =>
  [s.links, s.radio, s.far][k].map((pair) => {
    const [a, b] = pair.split("-"); const d = delay; delay += 0.09;
    return { cls: "link" + kind, d: d.toFixed(2), path: `M${byKey[a].x} ${byKey[a].y} L${byKey[b].x} ${byKey[b].y}` };
  }));
const chainKeys = [...new Set(s.links.flatMap((p) => p.split("-")))].slice(0, 7);
const packet = chainKeys.length > 2 ? "M" + chainKeys.map((k) => `${byKey[k].x} ${byKey[k].y}`).join(" L") : null;
const ring = s.rings ? byKey[s.rings] : null;
---
<svg class="mesh" viewBox={`0 0 ${s.w} ${s.h}`} preserveAspectRatio={s.par} role="group" aria-label={`${s.label}: old devices and their second jobs. Select a light to read it.`}>
  {ring && <g class="rings">{[90, 170, 250].map((r, i) => <circle cx={ring.x} cy={ring.y} r={r} style={`animation-delay:${1.6 + i * 0.5}s`} />)}</g>}
  <g class="links">{links.map((l) => <path class={l.cls} pathLength="1" style={`animation-delay:${l.d}s`} d={l.path} />)}</g>
  {packet && <g class="packets"><circle class="packet" r="7"><animateMotion dur="4s" begin="2s" repeatCount="indefinite" path={packet} /></circle></g>}
  <g class="nodes">
    {s.nodes.map((n, i) => {
      const [rh, rc] = n.far ? [16, 6] : [22, 8];
      const d1 = (0.4 + i * 0.12).toFixed(2), d2 = (1 + (i % 5) * 0.2).toFixed(1);
      return (
        <g class="node" tabindex="0" role="button" data-from={n.from} data-to={n.to}>
          <circle class="hit" cx={n.x} cy={n.y} r="44" />
          <circle class="halo" cx={n.x} cy={n.y} r={rh} style={`animation-delay:${d1}s,${d2}s`} />
          <circle class="core" cx={n.x} cy={n.y} r={rc} style={`animation-delay:${d1}s`} />
        </g>
      );
    })}
  </g>
</svg>
