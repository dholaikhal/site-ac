---
// A street photo with the store drawn onto it: the order leaves the shop prepaid, the courier picks it up,
// the buyer gets an SMS. Same idea as main's scene overlays, in this site's paint. Fictional order.
import Photo from "./Photo.astro";
import { tk } from "../data/facts";
---
<div class="scene" data-scene>
  <Photo id="delivery-van" class="scene-img" sizes="100vw" widths={[800, 1200, 1600, 2000]} />
  <div class="scene-shade" aria-hidden="true"></div>
  <svg class="route wide" viewBox="0 0 100 50" preserveAspectRatio="none" aria-hidden="true">
    <path class="trail" d="M19 30 C 24 44, 38 47, 52 45 S 84 38, 100 35" pathLength="100" />
    <path class="ants" d="M19 30 C 24 44, 38 47, 52 45 S 84 38, 100 35" pathLength="100" />
  </svg>
  <svg class="route tall" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true">
    <path class="trail" d="M14 60 C 18 90, 34 100, 50 98 S 86 86, 100 80" pathLength="100" />
    <path class="ants" d="M14 60 C 18 90, 34 100, 50 98 S 86 86, 100 80" pathLength="100" />
  </svg>
  <span class="pin p1" aria-hidden="true"></span>
  <span class="pin p2" aria-hidden="true"></span>
  <ul class="notes" aria-label="What happens to one order">
    <li class="note n1" style="--d:0"><span class="ico ok">✓</span><span><b>Order #1042 · {tk(1530)}</b>Paid by bKash before dispatch</span></li>
    <li class="note n2" style="--d:1"><span class="ico go">⟶</span><span><b>Courier booked</b>Pickup today, 4:30 pm</span></li>
    <li class="note n3" style="--d:2"><span class="ico sms">SMS</span><span><b>To the buyer</b>Your order has shipped</span></li>
  </ul>
</div>

<style>
.scene { --ax: 2 / 1; position: relative; aspect-ratio: var(--ax); max-height: 720px; width: 100%; overflow: hidden; background: #2b2a24; isolation: isolate; }
.scene :global(.scene-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
.scene-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(20 33 61 / .15), rgb(20 33 61 / 0) 40%, rgb(20 33 61 / .35)); }
.route { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.route path { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; }
.trail { stroke: rgb(255 255 255 / .55); stroke-width: 7; }
.ants { stroke: var(--yellow); stroke-width: 3.5; stroke-dasharray: 1.4 1.6; animation: ants 3.5s linear infinite; }
@keyframes ants { to { stroke-dashoffset: -30; } }
.route.tall { display: none; }
.pin { position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; background: var(--red); border: 3px solid #fff; box-shadow: 0 0 0 0 rgb(226 38 27 / .6); animation: beacon-red 2.2s ease-out infinite; }
.p1 { left: 19%; top: 60%; } .p2 { left: 98%; top: 70%; }
@keyframes beacon-red { 70% { box-shadow: 0 0 0 14px rgb(226 38 27 / 0); } 100% { box-shadow: 0 0 0 0 rgb(226 38 27 / 0); } }
.notes { list-style: none; margin: 0; padding: 0; }
.note { position: absolute; display: flex; gap: 10px; align-items: center; max-width: 250px; padding: 10px 14px 10px 10px; background: #fff; color: #14213d; border: 2px solid #14213d; border-radius: 12px; font-size: 0.86rem; line-height: 1.3; box-shadow: 0 10px 24px -12px rgb(0 0 0 / .5); }
.note b { display: block; font-size: 0.92rem; }
.ico { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; font-weight: 800; font-size: 0.9rem; color: #fff; }
.ico.ok { background: var(--green); } .ico.go { background: var(--blue); } .ico.sms { background: var(--red); font-size: 0.62rem; letter-spacing: .02em; }
.n1 { left: 3%; top: 7%; } .n2 { right: 3%; top: 9%; } .n3 { right: 3%; bottom: 9%; }
/* Put up one at a time when the scene comes into view */
:global(.js) .scene .note { opacity: 0; translate: 0 10px; scale: .96; transition: opacity .45s, translate .45s cubic-bezier(.2,.8,.2,1.2), scale .45s; transition-delay: calc(400ms + var(--d) * 650ms); }
:global(.js) .scene.in .note { opacity: 1; translate: 0 0; scale: 1; }
:global(.js) .scene .route { opacity: 0; transition: opacity 1s .2s; }
:global(.js) .scene.in .route { opacity: 1; }
@media (max-width: 760px) {
  .scene { --ax: 4 / 5; }
  .scene :global(.scene-img) { object-position: 50% 50%; }
  .route.wide { display: none; } .route.tall { display: block; }
  .p1 { left: 14%; top: 48%; } .p2 { left: 98%; top: 64%; }
  .note { max-width: 200px; font-size: 0.8rem; padding: 8px 10px 8px 8px; }
  .ico { width: 28px; height: 28px; }
  .n1 { left: 4%; top: 4%; } .n2 { right: 4%; top: auto; bottom: 6%; } .n3 { display: none; }
}
@media (prefers-reduced-motion: reduce) { .ants, .pin { animation: none; } }
</style>
