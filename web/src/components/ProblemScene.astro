---
// "A Facebook page is not a store": one full-width photo per problem with pins that open in turn,
// and an offset card holding the heading and the problems. Cash at the door carries the prepaid
// figures and a delivery route that goes out, is refused, and comes back.
import Photo from "./Photo.astro";
import facts from "../data/facts";
const m = facts.market;
const card = facts.market.cardLimitUsd.text;
type Pin = [number, number, string, string?];
const tabs = [
  { id: "inbox", label: "Orders lost in the inbox", fix: "Your store takes the order, the address and the payment by itself, day and night.", photo: "inbox-phone",
    pins: [[50, 26, "47 unread on the page"], [72, 52, "“Price?” asked 12 times today"], [86, 22, "11:48 pm: “still available?”"]] as Pin[] },
  { id: "cod", label: "Cash at the door", fix: "Buyers pay by bKash, Nagad or card before you ship, so parcels stop coming back.", photo: "delivery-van",
    pins: [[64, 16, "Order #1038 · cash on delivery"], [94, 30, "Refused at the door", "bad"], [80, 72, "Delivery charge paid both ways"]] as Pin[] },
  { id: "agency", label: "A website you can't change", fix: "Change anything by asking in a sentence. You see it before it goes live.", photo: "office",
    pins: [[66, 72, "Change request #7 · waiting for the developer"], [58, 16, "Last updated 8 months ago"], [88, 42, "New page: quoted separately"]] as Pin[] },
  { id: "dollar", label: "Tools priced in dollars", fix: "Priced in taka and paid by bKash, with local payments, couriers and SMS built in.", photo: "card-laptop",
    pins: [[52, 12, `Card declined: ${card} limit, allowed purposes only`, "bad"], [82, 40, "Checkout in dollars"], [66, 70, "No bKash or Nagad at checkout"]] as Pin[] },
];
---
<section class="pscene" data-tabs data-auto>
  <div class="pphotos">
    {tabs.map((t, i) => (
      <div class="pphoto treat" role="tabpanel" id={`pp-${t.id}`} aria-labelledby={`pt-${t.id}`} hidden={i !== 0} data-hotspots>
        <Photo id={t.photo as any} class={`pimg-bg ${t.id}`} sizes="100vw" widths={[800, 1200, 1600, 2000]} />
        {t.id === "cod" && (
          <svg class="route" viewBox="0 0 230 100" preserveAspectRatio="none" aria-hidden="true">
            <path id="cod-route" d="M136 40 C 160 26, 186 22, 216 30" />
            <circle r="3.2" class="parcel"><animateMotion dur="5s" repeatCount="indefinite" keyPoints="0;1;1;0" keyTimes="0;0.42;0.58;1" calcMode="linear"><mpath href="#cod-route" /></animateMotion></circle>
          </svg>
        )}
        <ul class="pins">
          {t.pins.map(([x, y, label, tone], n) => (
            <li class:list={["hs", tone]} style={`--x:${x}%;--y:${y}%;--n:${n}`}>
              <button type="button" aria-expanded="false"><span class="sr">Show: </span></button>
              <span class="hs-label">{label}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap">
    <div class="pcard" data-reveal>
      <h2>A Facebook page is not a store.</h2>
      <p class="lede">We add the missing pieces, so the inbox stops eating your day.</p>
      <div class="plist" role="tablist" aria-label="Problems">
        {tabs.map((t, i) => (
          <button type="button" role="tab" id={`pt-${t.id}`} aria-controls={`pp-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            <span class="num">{i + 1}</span>
            <span class="pl">{t.label}
              <small><b>With Amader Cloud:</b> {t.fix}</small>
              {t.id === "cod" && (
                <span class="cod-stats">
                  <span class="stat"><span class="n" data-count>{m.codShare.text}</span><span class="l">{m.codShare.label}.</span></span>
                  <span class="stat"><span class="n red" data-count>{m.codReturns.text}</span><span class="l">{m.codReturns.label}.</span></span>
                </span>
              )}
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.pscene { position: relative; padding-bottom: clamp(48px, 7vw, 96px); }
.pphotos { position: relative; aspect-ratio: 2.3 / 1; max-height: 680px; width: 100%; overflow: hidden; background: #14213d; }
.pphoto { position: absolute; inset: 0; animation: pfade .6s ease; }
.pphoto[hidden] { display: none; }
@keyframes pfade { from { opacity: 0; } }
.pphoto :global(.pimg-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.pphoto :global(.pimg-bg.cod) { object-position: 50% 62%; }
.pphoto :global(.pimg-bg.agency) { object-position: 50% 70%; }

/* The delivery route: out, refused, back */
.route { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
.route path { fill: none; stroke: var(--yellow); stroke-width: 3; stroke-dasharray: 2 3; vector-effect: non-scaling-stroke; animation: ants 1.6s linear infinite; }
.route .parcel { fill: #fff; stroke: #14213d; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
@keyframes ants { to { stroke-dashoffset: -20; } }

/* Hotspots: a pulsing pin; its label opens in turn when the photo shows, and on hover or tap */
.pins { list-style: none; margin: 0; padding: 0; }
.hs { position: absolute; z-index: 2; left: var(--x); top: var(--y); }
.hs button { position: relative; display: block; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; border: 3px solid #fff; background: var(--yellow); cursor: pointer; padding: 0; box-shadow: 0 0 0 0 rgb(255 204 0 / .7); animation: pin 2.2s ease-out infinite; }
.hs.bad button { background: var(--red); box-shadow: 0 0 0 0 rgb(226 38 27 / .7); animation-name: pin-bad; }
@keyframes pin { 70% { box-shadow: 0 0 0 14px rgb(255 204 0 / 0); } 100% { box-shadow: 0 0 0 0 rgb(255 204 0 / 0); } }
@keyframes pin-bad { 70% { box-shadow: 0 0 0 14px rgb(226 38 27 / 0); } 100% { box-shadow: 0 0 0 0 rgb(226 38 27 / 0); } }
.hs-label { position: absolute; left: 18px; top: -15px; width: max-content; max-width: 260px; padding: 6px 12px; border-radius: 10px; background: #fff; color: #14213d; font-weight: 700; font-size: 0.86rem; line-height: 1.3; box-shadow: 0 12px 26px -12px rgb(0 0 0 / .6); opacity: 0; translate: -6px 0; scale: .92; transform-origin: left center; transition: opacity .3s, translate .35s cubic-bezier(.2,.8,.2,1.3), scale .35s; pointer-events: none; }
.hs.bad .hs-label { background: var(--red); color: #fff; }
.hs[style*="--x:8"] .hs-label, .hs[style*="--x:9"] .hs-label { left: auto; right: 18px; transform-origin: right center; }
.hs.open .hs-label, .hs:hover .hs-label { opacity: 1; translate: 0 0; scale: 1; }
.pphoto#pp-cod .hs.bad.open .hs-label { animation: refused 5s linear infinite; }
@keyframes refused { 0%, 38% { opacity: .35; } 42%, 58% { opacity: 1; } 62%, 100% { opacity: .35; } }

.pcard { position: relative; z-index: 3; margin-top: clamp(-240px, -17vw, -60px); max-width: 600px; background: var(--card); border: 1.5px solid var(--line); border-radius: 6px; padding: clamp(24px, 4vw, 40px); box-shadow: 0 30px 60px -40px rgb(20 33 61 / .5); }
.pcard h2 { max-width: 14ch; }
.plist { display: grid; gap: 8px; margin-top: 22px; }
.plist button { display: flex; gap: 14px; align-items: flex-start; text-align: left; font: inherit; color: var(--ink); background: var(--card); border: 1.5px solid var(--rule); border-radius: 6px; padding: 12px 14px; cursor: pointer; transition: border-color .2s, background-color .2s; }
.plist button:hover { border-color: var(--line); }
.plist button[aria-selected="true"] { border-color: var(--line); background: var(--yellow-wash); }
.num { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 4px; background: var(--green); color: var(--yellow); font-family: var(--display); font-weight: 900; font-size: 1.2rem; }
.plist button[aria-selected="true"] .num { background: var(--red); }
.pl { display: grid; gap: 4px; font-weight: 700; font-size: 1.05rem; padding-top: 4px; }
.pl small { display: none; font-weight: 500; font-size: 0.95rem; color: var(--ink-2); }
.pl small b { color: var(--green); }
:root[data-theme="dark"] .pl small b { color: var(--ok); }
.plist button[aria-selected="true"] small { display: block; animation: pfade .4s ease; }
.cod-stats { display: none; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 10px; }
.plist button[aria-selected="true"] .cod-stats { display: grid; }
.cod-stats .stat { border-left: 3px solid var(--yellow); padding-left: 12px; }
.cod-stats .n { font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem); }
.cod-stats .n.red { color: var(--red); }
.cod-stats .l { font-weight: 500; font-size: 0.85rem; }
@media (max-width: 760px) {
  .pphotos { aspect-ratio: 4 / 5; }
  .route { display: none; }
  .hs-label { max-width: 180px; font-size: 0.78rem; }
  .pcard { margin-top: -48px; }
}
@media (prefers-reduced-motion: reduce) { .hs button, .route path { animation: none; } }
</style>
