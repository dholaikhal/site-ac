---
// Before and after, one switch: the same six jobs done from a Facebook inbox, then from your own store.
const rows: [string, string, string][] = [
  ["Taking an order", "Price, size and address asked one message at a time", "Buyers pick, fill in the address and pay on their own"],
  ["Getting paid", "Cash at the door, or a bKash screenshot to check by hand", "bKash, Nagad or card at checkout, matched to the order"],
  ["Booking delivery", "Each address copied into the courier's form", "The courier is booked when you mark it shipped"],
  ["Order updates", "“Where is my order?” messages all day", "An SMS when it's confirmed and when it ships"],
  ["After midnight", "Messages wait until morning", "Orders and payments keep coming in"],
  ["Changing things", "Ask a developer, wait, pay again", "Ask for it in a sentence"],
];
---
<div class="vs" data-vs>
  <div class="vs-switch">
    <span id="vs-a" class="side a">Selling from the inbox</span>
    <button type="button" role="switch" aria-checked="false" aria-labelledby="vs-b" class="switch"><span class="knob"></span></button>
    <span id="vs-b" class="side b">From your own store</span>
  </div>
  <ol class="vs-rows">
    {rows.map(([job, before, after], i) => (
      <li style={`--d:${i}`}>
        <span class="job">{job}</span>
        <span class="state before"><span class="mk">✕</span>{before}</span>
        <span class="state after"><span class="mk">✓</span>{after}</span>
      </li>
    ))}
  </ol>
</div>

<style>
.vs-switch { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 14px; margin-bottom: 26px; font-weight: 700; font-size: 1.05rem; }
.switch { position: relative; width: 74px; height: 38px; border-radius: 999px; border: 2px solid var(--line); background: var(--red-wash); cursor: pointer; transition: background-color .3s; }
.knob { position: absolute; top: 4px; left: 4px; width: 26px; height: 26px; border-radius: 50%; background: var(--red); transition: translate .35s cubic-bezier(.3,1.4,.5,1), background-color .3s; }
.vs.on .switch { background: var(--green-wash); }
.vs.on .knob { translate: 36px 0; background: var(--green); }
.side { transition: opacity .3s; } .vs.on .side.a, .vs:not(.on) .side.b { opacity: .45; }
.vs-rows { list-style: none; margin: 0 auto; padding: 0; display: grid; gap: 10px; max-width: 900px; }
.vs-rows li { display: grid; grid-template-columns: minmax(130px, 0.35fr) minmax(0, 1fr); align-items: center; gap: 16px; background: var(--card); border: 1.5px solid var(--rule); border-radius: 6px; padding: 14px 18px; position: relative; overflow: hidden; }
.job { font-weight: 700; }
.state { grid-column: 2; grid-row: 1; display: flex; gap: 10px; align-items: baseline; transition: opacity .35s, translate .35s; transition-delay: calc(var(--d) * 55ms); }
.mk { flex: none; font-weight: 900; }
.before .mk { color: var(--red); } .after .mk { color: var(--ok); }
.after { opacity: 0; translate: 0 12px; }
.vs.on .before { opacity: 0; translate: 0 -12px; }
.vs.on .after { opacity: 1; translate: 0 0; }
.vs-rows li::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--red); transition: background-color .35s; transition-delay: calc(var(--d) * 55ms); }
.vs.on .vs-rows li::before { background: var(--green); }
@media (max-width: 600px) { .vs-rows li { grid-template-columns: 1fr; gap: 4px; } .state { grid-column: 1; grid-row: 2; } }
</style>
