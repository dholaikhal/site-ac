---
// A small static phone showing a template's main screen (fictional business).
import "../styles/app-screen.css";
interface Props { url: string; name: string; banner: string; rows: [string, string][]; button: string; color?: string; sample?: boolean }
const { url, name, banner, rows, button, color = "#9a4a24", sample = false } = Astro.props;
---
<figure class="mini">
  <div class="phone">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class="phone-url"><span>{url}</span></div>
    <div class="screen" style={`--brand:${color}`}>
      <div class="b ink"><div class="ah"><strong>{name}</strong></div></div>
      <div class="b ink"><div class="hero-b"><span>{banner}</span></div></div>
      <div class="b ink">{rows.map(([a, b]) => <div class="row svc"><span>{a}</span><span>{b}</span></div>)}</div>
      <div class="b ink"><div class="paybtn">{button}</div></div>
    </div>
  </div>
</figure>

<style>
.mini { margin: 0; display: grid; justify-items: center; gap: 14px; }
.mini .phone { width: 250px; }
</style>
