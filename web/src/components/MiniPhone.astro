---
// A small static phone showing a template's main screen (fictional business), drawn like the demo's apps.
import "../styles/app-screen.css";
import { icon, bag, heroArt } from "../scripts/app-art.js";
interface Props { url: string; name: string; banner: string; rows: [string, string][]; button: string; color?: string; sample?: boolean; kind?: "shop" | "book" | "fees" }
const { url, name, banner, rows, button, color = "#9a4a24", kind = "shop" } = Astro.props;
const art = {
  shop: [["tote", "#d9b27a", "#8a4a22"], ["sling", "#a7b58e", "#4f5f3a"], ["sleeve", "#8b97ab", "#2f3b55"]],
  book: ["scissors", "drop", "sparkle"],
  fees: ["book", "book", "receipt"],
}[kind];
const thumb = (i: number) => kind === "shop" ? `<span class="thumb" style="--tint:${(art[i] as string[])[1]}33">${bag(...(art[i] as [string, string, string]))}</span>` : `<span class="svc-ic">${icon(art[i] as string)}</span>`;
---
<figure class="mini">
  <div class="phone">
    <div class="phone-notch" aria-hidden="true"></div>
    <div class="phone-url"><span>{url}</span></div>
    <div class="screen" style={`--brand:${color}`}>
      <div class="b ink"><div class="ah"><span class="mark">{name[0]}</span><strong>{name}</strong><span class="ah-ic"><span class="ib" set:html={icon(kind === "shop" ? "bag" : "user")}></span></span></div></div>
      <div class="b ink"><div class="hero-b"><div><span>{banner}</span></div><Fragment set:html={heroArt[kind]()} /></div></div>
      <div class="b ink"><div class="svc-list">{rows.map(([a, b], i) => <div class="svc"><Fragment set:html={thumb(i)} /><span class="svc-t">{a}</span><b>{b}</b></div>)}</div></div>
      <div class="b ink"><div class="paybar"><div class="paybtn">{button}</div></div></div>
    </div>
  </div>
</figure>

<style>
.mini { margin: 0; display: grid; justify-items: center; gap: 14px; }
.mini .phone { width: 250px; }
</style>
