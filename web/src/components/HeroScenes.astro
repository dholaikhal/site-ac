---
import Scene from "./Scene.astro";
import data from "../data/scenes.json";
const scenes = data.hero;
---
<div class="scenes">
  {scenes.map((s, i) => <Scene scene={s} live={i === 0} first={i === 0} />)}
</div>
<div class="wrap hero-foot">
  <div class="scene-tabs mono" role="tablist" aria-label="Scenes">
    {scenes.map((s, i) => (
      <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`scene-${s.id}`} data-i={i}><span>{s.label}</span><i></i></button>
    ))}
  </div>
  <button type="button" class="scene-pause mono" aria-pressed="false">Pause</button>
</div>
