---
// Home: the safe base in one picture, in plain words about safety and stability. The example apps, each in its own
// colours, stand on one shared base. The detail (payments, logins, data, upkeep) is on How it works (#safe-base).
import Photo from "./Photo.astro";
import { APPS } from "../../examples/data";
import { icon } from "../scripts/app-art.js";
const apps = Object.values(APPS);
const base: [string, string][] = [["card", "Safe payments"], ["shield", "Private details"], ["check", "Checked changes"], ["undo", "Always up to date"], ["box", "Backed up every day"]];
const points = [
  ["Safe for your customers", "Their payments and details are protected the same way in every store."],
  ["Steady as you grow", "Every change is checked before it goes live, and can be undone."],
  ["Looked after for you", "We keep the base up to date, so your store keeps working without any work from you."],
];
---
<section class="band band-blue has-photo safe" id="safe-base">
  <Photo id="skyline" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap safe-grid">
    <div data-reveal>
      <h2 class="slogan">One safe base.<br>Every store.</h2>
      <p class="lede">A quickly made app can leave a business exposed. Every store on Amader Cloud stands on the same tested, looked-after base, so it stays safe and keeps working while you sell.</p>
      <ul class="safe-points">{points.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ul>
      <a class="band-link" href="how-it-works.html#safe-base">How the base works →</a>
    </div>
    <figure class="stack" data-reveal style="--d:1" aria-label="Four example apps standing on one shared base: safe payments, private details, checked changes, always up to date, backed up every day">
      <div class="stack-apps">
        {apps.map((a, i) => <span class="stack-app" style={`--b:${a.brand};--i:${i}`}><i>{a.name[0]}</i>{a.name}</span>)}
      </div>
      <div class="stack-base">
        <strong><span class="mk" aria-hidden="true">a</span>The Amader Cloud base</strong>
        <ul>{base.map(([ic, l]) => <li><span set:html={icon(ic)} />{l}</li>)}</ul>
      </div>
    </figure>
  </div>
</section>

<style>
.safe-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
@media (max-width: 900px) { .safe-grid { grid-template-columns: 1fr; } }
.safe-points { list-style: none; margin: 20px 0 22px; padding: 0; display: grid; gap: 12px; }
.safe-points li { display: grid; gap: 2px; padding-left: 26px; position: relative; }
.safe-points li::before { content: "✓"; position: absolute; left: 0; top: 0; font-weight: 900; color: var(--yellow); }
.safe-points strong { font-size: 1.05rem; }
.safe-points span { opacity: .9; }
/* The picture: apps on top, each linked down to the base */
.stack { margin: 0; display: grid; gap: 0; }
.stack-apps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
@media (max-width: 520px) { .stack-apps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.stack-app { position: relative; display: grid; justify-items: center; gap: 8px; padding: 14px 8px 12px; background: #fff; color: #14213d; border-radius: 10px; font-weight: 800; font-size: 0.85rem; text-align: center; line-height: 1.2; box-shadow: 0 14px 28px -18px rgb(0 0 0 / .6); border-top: 4px solid var(--b); }
.stack-app i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--b); color: #fff; font-style: normal; font-weight: 900; }
/* the post that stands each app on the base */
.stack-app::after { content: ""; position: absolute; left: 50%; top: 100%; width: 3px; height: 22px; translate: -50% 0; background: repeating-linear-gradient(180deg, var(--yellow) 0 4px, transparent 4px 7px); }
.stack-base { margin-top: 22px; padding: 18px 20px 16px; border-radius: 6px; background: #0b5d3b; color: #fff; box-shadow: inset 0 0 0 6px #0b5d3b, inset 0 0 0 8px #ffcc00, 0 24px 40px -26px rgb(0 0 0 / .7); }
.stack-base strong { display: flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: 1.35rem; color: #ffcc00; text-shadow: 0.05em 0.05em 0 #e2261b; }
.stack-base .mk { display: grid; place-items: center; width: 26px; height: 24px; border-radius: 3px; background: #14213d; color: #ffcc00; font-size: 1rem; text-shadow: none; box-shadow: inset 0 0 0 1.5px #ffcc00; }
.stack-base ul { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.stack-base li { display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 999px; background: rgb(255 255 255 / .12); border: 1px solid rgb(255 204 0 / .45); font-weight: 700; font-size: 0.86rem; }
.stack-base li :global(.ic) { width: 15px; height: 15px; fill: none; stroke: #ffcc00; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
/* On reveal the apps settle onto the base, one after another */
.stack[data-reveal] .stack-app { opacity: 0; translate: 0 -14px; transition: opacity .4s, translate .5s cubic-bezier(.2, 1.4, .4, 1); transition-delay: calc(.25s + var(--i) * .12s); }
.stack[data-reveal].in .stack-app { opacity: 1; translate: 0 0; }
@media (prefers-reduced-motion: reduce) { .stack[data-reveal] .stack-app { opacity: 1; translate: none; transition: none; } }
</style>
