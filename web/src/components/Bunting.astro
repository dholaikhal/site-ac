---
// Paper bunting strung across the street: flags in the sign paints along a sagging string.
// Sliced to the container, so narrow screens see the middle of the string.
interface Props { flags?: number; sag?: number; class?: string }
const { flags = 30, sag = 16, class: cls } = Astro.props;
const W = 1200, paints = ["#e2261b", "#ffcc00", "#0b5d3b", "#1739a8", "#ffffff"];
const y = (x: number) => 4 + sag * (1 - ((x - W / 2) / (W / 2)) ** 2);
const step = W / flags;
const list = Array.from({ length: flags }, (_, i) => { const x = step * (i + 0.5); return { x, y: y(x), c: paints[i % paints.length] }; });
const string = Array.from({ length: 41 }, (_, i) => `${(W / 40) * i},${y((W / 40) * i).toFixed(1)}`).join(" ");
---
<svg class:list={["bunting", cls]} viewBox={`0 0 ${W} ${sag + 40}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true">
  <polyline points={string} fill="none" stroke="currentColor" stroke-width="1.5" opacity=".55" />
  {list.map((f, i) => (
    <path class="flag" style={`--i:${i}`} d={`M${(f.x - 13).toFixed(1)} ${(f.y - 1).toFixed(1)} L${(f.x + 13).toFixed(1)} ${(f.y + 1).toFixed(1)} L${f.x.toFixed(1)} ${(f.y + 26).toFixed(1)} Z`} fill={f.c} stroke="#14213d" stroke-opacity=".25" />
  ))}
</svg>
