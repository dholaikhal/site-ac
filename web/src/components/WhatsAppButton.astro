---
// Say hello on WhatsApp: beside Join the beta in the hero, and on About and Contact.
import WhatsAppGlyph from "./WhatsAppGlyph.astro";
import { whatsapp } from "../data/facts";
interface Props { label?: string; class?: string }
const { label = "Say hello on WhatsApp", class: cls } = Astro.props;
---
<a class:list={["btn", "btn-wa", cls]} href={whatsapp()} target="_blank" rel="noopener">
  <WhatsAppGlyph />
  <span>{label}</span>
</a>
<style>
.btn-wa { background: #25d366; border-color: #128c4a; color: #06281a; }
.btn-wa:hover { background: #3be078; }
.btn-wa :global(svg) { width: 20px; height: 20px; fill: currentColor; flex: none; }
</style>
