---
// A photo from src/assets/photos, served as AVIF/WebP/JPEG at several widths.
// Pass-through attributes (class, style, alt, loading, fetchpriority) land on the <img>.
import { getImage } from "astro:assets";
interface Props { name: string; alt?: string; sizes?: string; class?: string; style?: string; loading?: "lazy" | "eager"; fetchpriority?: "high" | "low" | "auto"; ariaHidden?: boolean; maxWidth?: number }
const { name, alt = "", sizes = "100vw", class: cls, style, loading = "lazy", fetchpriority, ariaHidden, maxWidth } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/photos/*.jpg", { eager: true });
const src = photos[`../assets/photos/${name}.jpg`]?.default;
if (!src) throw new Error(`Unknown photo: ${name}`);
const cap = Math.min(src.width, maxWidth ?? src.width);
const widths = [640, 960, 1280, 1600, 1920, 2400].filter((w) => w < cap).concat(cap);
const avif = await getImage({ src, widths, format: "avif", quality: 55 });
const webp = await getImage({ src, widths, format: "webp", quality: 70 });
const jpg = await getImage({ src, widths, format: "jpg", quality: 72 });
---
<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img src={jpg.src} srcset={jpg.srcSet.attribute} sizes={sizes} width={src.width} height={src.height} alt={alt} class={cls} style={style} loading={loading} fetchpriority={fetchpriority} decoding="async" aria-hidden={ariaHidden ? "true" : undefined} />
</picture>
