---
// The builder demo, as a builder window: chat on the left; on the right the app as a phone preview,
// the code being written, and the data it collects. Scripted in the browser (src/scripts/demo.js);
// nothing runs until the visitor picks or types a request.
import "../styles/app-screen.css";
import Logo from "./Logo.astro";
import Device from "./Device.astro";
---
<div class="demo" data-demo id="demo-app" role="region" aria-label="Builder demo (scripted)">
  <span class="demo-stamp" aria-hidden="true">Demo</span>
  <div class="win-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="proj"><Logo /><b data-project>New app</b><span class="url" data-addr></span></span>
    <button type="button" class="pub" data-publish disabled>Publish</button>
  </div>

  <div class="win-body">
    <div class="demo-chat">
      <ol class="msgs" data-msgs aria-live="polite"></ol>
      <div class="chips" data-chips></div>
      <form class="composer" data-composer>
        <label class="sr" for="demo-input">Describe your app</label>
        <input id="demo-input" type="text" autocomplete="off" placeholder="Write what you want, how you want">
        <button type="submit" class="btn btn-go">Send</button>
      </form>
    </div>

    <div class="demo-stage">
      <div class="stage-status"><span class="pulse" aria-hidden="true"></span><span data-status>Waiting for your request</span></div>

      <div class="dev-switch" role="group" aria-label="Preview on">
        <button type="button" data-dev="phone" aria-pressed="true">Phone</button>
        <button type="button" data-dev="tablet" aria-pressed="false">Tablet</button>
        <button type="button" data-dev="laptop" aria-pressed="false">Laptop</button>
      </div>
      <div class="preview-row">
        <div class="phone-col">
          <span class="who-pill" data-who hidden></span>
          <div class="dev-wrap">
            <div class="open-sign" data-open hidden aria-hidden="true"><span class="cord"></span><span class="board">Open</span></div>
            <Device kind="phone" id="demo-device">
              <div class="notif" data-notif role="status"></div>
              <div class="phone-url"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="5" width="7" height="5.5" rx="1" fill="currentColor"/><path d="M4 5V3.6a2 2 0 0 1 4 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg><span data-url>yourname.amader.cloud</span></div>
              <div class="screen" data-screen aria-live="polite"></div>
            </Device>
          </div>
          <div class="screen-tabs" role="tablist" aria-label="Preview pages" data-tabs></div>
        </div>
        <div class="till" data-till hidden>
          <span class="till-k">Today's sales</span>
          <b class="till-amt" data-till-amt>Tk 0</b>
          <span class="till-n" data-till-n>0 orders</span>
          <ol class="till-log" data-till-log></ol>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="../scripts/demo.js"></script>

<style is:global>
.demo { position: relative; color: var(--ink); border: 2px solid var(--line); border-radius: 10px; background: var(--card); text-align: left; box-shadow: 0 30px 60px -36px rgb(20 33 61 / .55); }
.demo-stamp { position: absolute; z-index: 8; top: -22px; right: 28px; rotate: 9deg; font-family: var(--display); font-weight: 900; font-size: 1.9rem; letter-spacing: .14em; text-transform: uppercase; color: var(--red); padding: 0 14px 0 18px; border: 4px solid var(--red); border-radius: 6px; box-shadow: inset 0 0 0 2px var(--card), inset 0 0 0 4px var(--red); background: color-mix(in srgb, var(--card) 86%, transparent); pointer-events: none; opacity: .92; }
.win-bar { display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-bottom: 2px solid var(--line); background: var(--wash-2); border-radius: 8px 8px 0 0; flex-wrap: wrap; }
.dots { display: inline-flex; gap: 6px; } .dots i { width: 11px; height: 11px; border-radius: 50%; background: var(--red); } .dots i:nth-child(2) { background: var(--yellow); } .dots i:nth-child(3) { background: var(--green); }
.proj { display: inline-flex; align-items: center; gap: 8px; font-size: 0.92rem; min-width: 0; }
.proj svg { width: 20px; height: 20px; flex: none; }
.proj .url { color: var(--ink-2); font-size: 0.8rem; }
.pub { margin-left: auto; font: inherit; font-weight: 800; font-size: 0.9rem; padding: 6px 16px; border-radius: 5px; border: 1.5px solid var(--red); background: var(--red); color: #fff; cursor: pointer; }
.pub:disabled { opacity: .4; cursor: default; }
.pub.ready { animation: beacon-pub 1.8s ease-out infinite; }
.pub.live { background: var(--green); border-color: var(--green); }
@keyframes beacon-pub { 0% { box-shadow: 0 0 0 0 rgb(226 38 27 / .55); } 100% { box-shadow: 0 0 0 10px rgb(226 38 27 / 0); } }

.win-body { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); }
@media (max-width: 900px) { .win-body { grid-template-columns: 1fr; } }
.demo-chat { display: flex; flex-direction: column; min-height: 620px; max-height: 680px; border-right: 2px solid var(--line); min-width: 0; }
@media (max-width: 900px) { .demo-chat { min-height: 0; height: 460px; border-right: 0; border-bottom: 2px solid var(--line); } }
.msgs { list-style: none; margin: 0; padding: 16px; display: flex; flex-direction: column; gap: 12px; overflow-y: auto; flex: 1; overscroll-behavior: contain; }
.m { max-width: 92%; padding: 10px 14px; border-radius: 16px; font-size: 0.95rem; line-height: 1.5; }
.m p { margin: 0 0 0.5em; } .m p:last-child { margin: 0; }
.m ul { margin: 6px 0 0; padding-left: 18px; }
.m.user { align-self: flex-end; background: var(--blue); color: #fff; border-bottom-right-radius: 4px; font-weight: 600; }
.m.ai { align-self: flex-start; background: var(--wash-2); border-bottom-left-radius: 4px; }
.m .who { display: block; font-size: 0.78rem; font-weight: 700; color: var(--green); margin-bottom: 4px; }
:root[data-theme="dark"] .m .who { color: var(--ok); }
.m .spark { color: var(--red); }
.m.log { background: transparent; border: 1.5px dashed var(--rule); padding-block: 8px; }
.m.log.thinking { border: 1.5px solid transparent; background: linear-gradient(var(--card), var(--card)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; animation: aiflow 2.2s linear infinite; }
@keyframes aiflow { to { background-position: 0 0, 300% 0; } }
.steps { list-style: none; padding: 0; margin: 0; font-size: 0.86rem; color: var(--ink-2); }
.steps li { display: flex; gap: 8px; align-items: baseline; padding: 2px 0; flex-wrap: wrap; }
.steps .st { flex: none; width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--red); border-right-color: transparent; animation: spin .8s linear infinite; transform: translateY(1px); }
.steps li.done { color: var(--ink); }
.steps li.done .st { animation: none; border: 0; width: 10px; height: 6px; border-radius: 0; border-left: 2.5px solid var(--ok); border-bottom: 2.5px solid var(--ok); transform: rotate(-45deg) translateY(-1px); }
@keyframes spin { to { transform: rotate(360deg); } }
.chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 16px 12px; }
.chip { font: inherit; font-size: 0.88rem; font-weight: 600; line-height: 1.35; text-align: left; color: var(--ink); background: var(--card); border: 1.5px solid var(--line); border-radius: 4px; padding: 8px 12px; cursor: pointer; max-width: 100%; }
.chip:hover { background: var(--yellow-wash); }
.chip.primary { background: var(--red); color: #fff; border-color: var(--red); }
.chip.alt { border-style: dashed; }
.composer { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 1.5px solid var(--rule); }
.composer input { flex: 1; min-width: 0; font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--wash); border: 1.5px solid var(--rule); border-radius: 4px; padding: 10px 14px; }
.composer .btn { padding: 10px 18px; }
.caret::after { content: "▍"; color: var(--red); animation: blink 1s steps(1) infinite; margin-left: 1px; }
@keyframes blink { 50% { opacity: 0; } }

.demo-stage { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: stretch; gap: 14px; padding: 22px 18px; min-width: 0; background: var(--green); box-shadow: inset 0 0 0 10px var(--green), inset 0 0 0 12px var(--yellow); border-radius: 0 0 8px 0; }
@media (max-width: 900px) { .demo-stage { border-radius: 0 0 8px 8px; } }
.stage-status { align-self: center; display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 700; color: #14213d; background: #fff; border: 2px solid #14213d; border-radius: 999px; padding: 5px 12px; max-width: 100%; transition: background-color .3s; }
.stage-status .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--green); flex: none; }
.stage-status:has(.live) .pulse { background: var(--red); animation: pulse 1s ease-in-out infinite; }
.stage-status.ai { background: var(--yellow); }
@keyframes pulse { 50% { opacity: .3; } }
.preview-row { display: flex; justify-content: center; gap: 14px; align-items: center; flex-wrap: wrap; }
.dev-switch { align-self: center; display: inline-flex; border: 2px solid #14213d; border-radius: 999px; overflow: hidden; background: #fff; }
.dev-switch button { font: inherit; font-size: 0.78rem; font-weight: 800; padding: 4px 12px; border: 0; background: transparent; color: #14213d; cursor: pointer; }
.dev-switch button[aria-pressed="true"] { background: #14213d; color: #fff; }
.dev-wrap { position: relative; transition: transform .65s cubic-bezier(.25, .8, .25, 1); }
.dev-wrap.zoom { transform: scale(1.5); }
@media (prefers-reduced-motion: reduce) { .dev-wrap { transition: none; } }
.phone-col { display: flex; flex-direction: column; align-items: center; gap: 12px; }
.who-pill { font-size: 0.78rem; font-weight: 800; color: #14213d; background: var(--yellow); border-radius: 3px; padding: 3px 10px; }
.screen-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; min-height: 32px; }
.screen-tabs button { font: inherit; font-size: 0.8rem; font-weight: 700; color: #14213d; background: #fff; border: 2px solid #14213d; border-radius: 999px; padding: 4px 11px; cursor: pointer; }
.screen-tabs button[aria-selected="true"] { color: #fff; background: #14213d; }
.screen-tabs button:disabled { opacity: .5; cursor: default; }
/* The till: today's sales, ticking up as orders arrive after the store opens */
.till { width: 200px; flex: none; align-self: center; background: #fff; color: #14213d; border: 2px solid #14213d; border-radius: 10px; padding: 14px 16px; box-shadow: 0 16px 30px -18px rgb(0 0 0 / .5); animation: sheet-up .4s ease; }
.till[hidden] { display: none; }
.till-k { display: block; font-size: 0.78rem; font-weight: 700; color: #4a5670; }
.till-amt { display: block; font-family: var(--display); font-weight: 900; font-size: 2.3rem; line-height: 1.05; color: #0b5d3b; }
.till-n { font-size: 0.8rem; font-weight: 700; }
.till-log { list-style: none; margin: 10px 0 0; padding: 10px 0 0; border-top: 1px dashed #c9d2dc; display: grid; gap: 6px; font-size: 0.74rem; }
.till-log li { display: flex; justify-content: space-between; gap: 8px; animation: sheet-up .3s ease; }
.till-log b { color: #0b5d3b; }
.till.bump .till-amt { animation: bump .5s ease; }
@keyframes bump { 40% { scale: 1.12; color: #e2261b; } }
@media (max-width: 1100px) { .preview-row { flex-direction: column; align-items: center; } .till { width: min(290px, 100%); } }
/* Brush, notifications, OPEN sign, flags, wallet sheet */
.screen .b.paint::after { content: ""; position: absolute; inset: -2px; border-radius: 9px; pointer-events: none; background: linear-gradient(100deg, transparent 0 35%, rgb(255 204 0 / .55) 45% 55%, transparent 65%) -120% 0 / 220% 100% no-repeat; animation: brush .7s ease-out forwards; }
@keyframes brush { to { background-position: 220% 0; opacity: .2; } }
.notif { position: absolute; z-index: 5; left: 10px; right: 10px; top: 46px; display: flex; gap: 8px; align-items: center; padding: 9px 10px; background: rgb(255 255 255 / .96); color: #14213d; border-radius: 14px; font-size: 0.74rem; line-height: 1.3; box-shadow: 0 10px 24px -10px rgb(0 0 0 / .45); translate: 0 -24px; opacity: 0; pointer-events: none; }
.notif b { display: block; }
.notif.show { animation: notif 4.2s cubic-bezier(.2,.8,.2,1) forwards; }
@keyframes notif { 0% { translate: 0 -24px; opacity: 0; } 10%, 82% { translate: 0 0; opacity: 1; } 100% { translate: 0 -24px; opacity: 0; } }
.ni { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 7px; color: #fff; font-weight: 900; font-size: 0.7rem; background: var(--green); }
.ni.sms { background: var(--red); font-size: 0.5rem; }
.open-sign { position: absolute; z-index: 6; top: 70px; right: -22px; display: grid; justify-items: center; transform-origin: 50% 0; }
.open-sign .cord { width: 56px; height: 20px; border: 2px solid #14213d; border-bottom: 0; border-radius: 30px 30px 0 0; }
.open-sign .board { font-family: var(--display); font-weight: 900; font-size: 1.35rem; letter-spacing: .06em; text-transform: uppercase; color: var(--yellow); background: var(--red); padding: 2px 14px; border-radius: 3px; box-shadow: inset 0 0 0 3px var(--red), inset 0 0 0 4.5px var(--yellow); }
.open-sign.swing { animation: swing 2.4s cubic-bezier(.3,.6,.3,1) both; }
@keyframes swing { 0% { rotate: 0deg; translate: 0 -40px; opacity: 0; } 15% { translate: 0 0; opacity: 1; rotate: 14deg; } 35% { rotate: -9deg; } 55% { rotate: 5deg; } 75% { rotate: -2deg; } 100% { rotate: 0deg; } }
.screen { position: relative; }
.screen .paysheet { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: grid; gap: 6px; padding: 14px 12px 16px; background: #fff; border-radius: 16px 16px 0 0; box-shadow: 0 -12px 30px -10px rgb(0 0 0 / .35); animation: sheet-up .35s cubic-bezier(.2,.8,.2,1); }
.screen .paysheet > b { font-size: 0.95rem; color: #c2185b; }
.screen .paysheet .paybtn { background: #c2185b; }
.screen .paysheet.paid .paybtn { opacity: .4; }
.screen .paid-ok { text-align: center; font-weight: 800; color: #0b7a4f; animation: sheet-up .3s ease; }
@keyframes sheet-up { from { translate: 0 20px; opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .m.log.thinking, .pub.ready, .caret::after { animation: none; } .notif.show { animation: none; opacity: 1; translate: 0 0; } }
</style>
