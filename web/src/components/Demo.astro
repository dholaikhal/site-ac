---
// The builder demo: chat on the left, the app assembling on a phone on the right.
// Scripted in the browser (src/scripts/demo.js); nothing runs until the visitor picks or types a request.
import "../styles/app-screen.css";
---
<div class="demo" data-demo id="demo-app">
  <div class="demo-chat">
    <div class="demo-bar">
      <strong>Amader Cloud builder</strong>
      <span class="tag">Demonstration</span>
    </div>
    <ol class="msgs" data-msgs aria-live="polite"></ol>
    <div class="chips" data-chips></div>
    <form class="composer" data-composer>
      <label class="sr" for="demo-input">Describe your app</label>
      <input id="demo-input" type="text" autocomplete="off" placeholder="Describe your app, or ask for a change">
      <button type="submit" class="btn btn-go">Send</button>
    </form>
  </div>

  <div class="demo-stage">
    <div class="stage-status"><span class="pulse" aria-hidden="true"></span><span data-status>Waiting for your request</span></div>
    <div class="phone">
      <div class="phone-notch" aria-hidden="true"></div>
      <div class="phone-url"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="5" width="7" height="5.5" rx="1" fill="currentColor"/><path d="M4 5V3.6a2 2 0 0 1 4 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg><span data-url>yourname.amader.cloud</span></div>
      <div class="screen" data-screen aria-live="polite"></div>
    </div>
    <div class="screen-tabs" role="tablist" aria-label="Preview pages" data-tabs></div>
  </div>
</div>
<p class="demo-note small">Demonstration, scripted in your browser. No AI is called, nothing is published, and the businesses and prices are made up.</p>

<script src="../scripts/demo.js"></script>

<style is:global>
.demo { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); border: 2px solid var(--line); border-radius: 20px; overflow: hidden; background: var(--card); box-shadow: 8px 8px 0 var(--shadow); text-align: left; }
@media (max-width: 880px) { .demo { grid-template-columns: 1fr; } }
.demo-chat { display: flex; flex-direction: column; min-height: 600px; max-height: 660px; border-right: 2px solid var(--line); min-width: 0; background: var(--card); }
@media (max-width: 880px) { .demo-chat { min-height: 0; height: 470px; border-right: 0; border-bottom: 2px solid var(--line); } }
.demo-bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 2px solid var(--line); background: var(--ground-2); }
.demo-bar strong { font-family: var(--display); font-weight: 800; letter-spacing: -0.02em; }
.demo-bar .tag { margin-left: auto; }
.msgs { list-style: none; margin: 0; padding: 16px; display: flex; flex-direction: column; gap: 12px; overflow-y: auto; flex: 1; scroll-behavior: smooth; }
.m { max-width: 92%; padding: 10px 14px; border-radius: 16px; font-size: 0.95rem; line-height: 1.5; }
.m p { margin: 0 0 0.5em; } .m p:last-child { margin: 0; }
.m ul { margin: 6px 0 0; padding-left: 18px; }
.m .muted { color: var(--ink-2); font-size: 0.86rem; }
.m.user { align-self: flex-end; background: var(--cobalt); color: #fff; border-bottom-right-radius: 4px; font-weight: 600; }
.m.ai { align-self: flex-start; background: var(--ground-2); border-bottom-left-radius: 4px; }
.m .who { display: inline-block; font-size: 0.72rem; font-weight: 700; color: #1b1510; background: var(--marigold); border-radius: 999px; padding: 2px 8px; margin-bottom: 6px; }
.m.log { background: transparent; border: 2px solid var(--rule); padding-block: 8px; }
.steps { list-style: none; padding: 0; margin: 0; font-size: 0.86rem; color: var(--ink-2); }
.steps li { display: flex; gap: 8px; align-items: baseline; padding: 2px 0; }
.steps .st { flex: none; width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--red); border-right-color: transparent; animation: spin .8s linear infinite; transform: translateY(1px); }
.steps li.done { color: var(--ink); }
.steps li.done .st { animation: none; border: 0; width: 10px; height: 6px; border-radius: 0; border-left: 2.5px solid var(--ok); border-bottom: 2.5px solid var(--ok); transform: rotate(-45deg) translateY(-1px); }
@keyframes spin { to { transform: rotate(360deg); } }
.chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 16px 12px; }
.chip { font: inherit; font-size: 0.88rem; font-weight: 600; line-height: 1.35; text-align: left; color: var(--ink); background: var(--card); border: 2px solid var(--line); border-radius: 12px; padding: 8px 12px; cursor: pointer; max-width: 100%; box-shadow: 2px 2px 0 var(--shadow); }
.chip:hover { background: var(--marigold-tint); }
.chip.primary { background: var(--red); color: #fff; border-color: #1b1510; }
.composer { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 2px solid var(--rule); }
.composer input { flex: 1; min-width: 0; font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--ground); border: 2px solid var(--line); border-radius: 999px; padding: 10px 16px; }
.composer .btn { padding: 10px 18px; }

.demo-stage { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 22px 16px 22px; min-width: 0; background: var(--marigold); }
.stage-status { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 700; color: #1b1510; background: #fff; border: 2px solid #1b1510; border-radius: 999px; padding: 5px 12px; max-width: 100%; }
.stage-status .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--green); flex: none; }
.stage-status:has(.live) .pulse { background: var(--red); animation: pulse 1s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .3; } }
@media (max-width: 880px) { .demo-stage .phone { aspect-ratio: auto; height: 560px; } }
.screen-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; min-height: 32px; }
.screen-tabs button { font: inherit; font-size: 0.8rem; font-weight: 700; color: #1b1510; background: #fff; border: 2px solid #1b1510; border-radius: 999px; padding: 4px 11px; cursor: pointer; }
.screen-tabs button[aria-selected="true"] { color: #fff; background: #1b1510; }
.screen-tabs button:disabled { opacity: .5; cursor: default; }
.demo-note { margin: 16px 0 0; }
</style>
