---
// The builder demo: chat on the left, the app drawing itself on a phone on the right.
// Scripted in the browser (src/scripts/demo.js); labelled as a demonstration.
---
<div class="demo" data-demo id="demo">
  <div class="demo-chat">
    <div class="demo-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>Builder</span>
      <span class="tag">demonstration</span>
    </div>
    <ol class="msgs" data-msgs aria-live="polite"></ol>
    <div class="chips" data-chips></div>
    <form class="composer" data-composer>
      <label class="sr" for="demo-input">Describe your app</label>
      <input id="demo-input" type="text" autocomplete="off" placeholder="Describe your app, or ask for a change">
      <button type="submit" class="btn btn-live">Send</button>
    </form>
  </div>

  <div class="demo-stage">
    <div class="stage-status"><span class="pulse" aria-hidden="true"></span><span data-status>Waiting for a request</span></div>
    <div class="phone">
      <div class="phone-notch" aria-hidden="true"></div>
      <div class="phone-url"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="2.5" y="5" width="7" height="5.5" rx="1" fill="currentColor"/><path d="M4 5V3.6a2 2 0 0 1 4 0V5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg><span data-url>yourname.amader.cloud</span></div>
      <div class="screen" data-screen aria-live="polite"></div>
    </div>
    <div class="screen-tabs" role="tablist" aria-label="Preview pages" data-tabs></div>
    <svg class="dim" viewBox="0 0 10 100" preserveAspectRatio="none" aria-hidden="true"><path d="M5 0v100M1 0h8M1 100h8" /></svg>
  </div>
</div>
<p class="demo-note">Demonstration: scripted in your browser. No AI is called, nothing is published, and the businesses and prices are made up.</p>

<script src="../scripts/demo.js"></script>

<style is:global>
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.demo { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 0; border: 1px solid rgb(var(--line-rgb) / .35); border-radius: 14px; overflow: hidden; background: rgb(var(--night-rgb) / .55); box-shadow: 0 30px 80px -30px rgb(0 0 0 / .6); text-align: left; color: var(--chalk); }
@media (max-width: 880px) { .demo { grid-template-columns: 1fr; } }
.demo-chat { display: flex; flex-direction: column; min-height: 600px; max-height: 660px; border-right: 1px solid rgb(var(--line-rgb) / .25); background: rgb(9 30 42 / .85); min-width: 0; }
@media (max-width: 880px) { .demo-chat { min-height: 0; height: 460px; border-right: 0; border-bottom: 1px solid rgb(var(--line-rgb) / .25); } }
.demo-bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid rgb(var(--line-rgb) / .2); font-family: var(--mono); font-size: 0.8rem; color: var(--chalk-2); }
.demo-bar .tag { margin-left: auto; color: var(--amber); }
.dots { display: inline-flex; gap: 5px; }
.dots i { width: 9px; height: 9px; border-radius: 50%; background: rgb(var(--chalk-rgb) / .2); }
.msgs { list-style: none; margin: 0; padding: 16px; display: flex; flex-direction: column; gap: 12px; overflow-y: auto; flex: 1; scroll-behavior: smooth; }
.m { max-width: 92%; padding: 10px 14px; border-radius: 12px; font-size: 0.95rem; line-height: 1.5; }
.m p { margin: 0 0 0.5em; } .m p:last-child { margin: 0; }
.m ul { margin: 6px 0 0; padding-left: 18px; }
.m .muted { color: var(--chalk-2); font-size: 0.85rem; }
.m.user { align-self: flex-end; background: var(--amber); color: var(--night); border-bottom-right-radius: 4px; font-weight: 500; }
.m.ai { align-self: flex-start; background: rgb(var(--chalk-rgb) / .07); border: 1px solid rgb(var(--line-rgb) / .22); border-bottom-left-radius: 4px; }
.m .who { display: block; font-family: var(--mono); font-size: 0.72rem; color: var(--amber); margin-bottom: 4px; }
.m.log { background: transparent; border-style: dashed; padding-block: 8px; }
.steps { list-style: none; padding: 0; margin: 0; font-family: var(--mono); font-size: 0.78rem; color: var(--chalk-2); }
.steps li { display: flex; gap: 8px; align-items: baseline; padding: 2px 0; }
.steps .st { flex: none; width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--amber); border-right-color: transparent; animation: spin .8s linear infinite; transform: translateY(1px); }
.steps li.done { color: var(--chalk); }
.steps li.done .st { animation: none; border: 0; width: 10px; height: 6px; border-radius: 0; border-left: 2px solid #5cc493; border-bottom: 2px solid #5cc493; transform: rotate(-45deg) translateY(-1px); }
@keyframes spin { to { transform: rotate(360deg); } }
.chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 16px 12px; }
.chip { font: inherit; font-size: 0.84rem; line-height: 1.35; text-align: left; color: var(--chalk); background: rgb(var(--chalk-rgb) / .06); border: 1px solid rgb(var(--line-rgb) / .4); border-radius: 10px; padding: 7px 11px; cursor: pointer; max-width: 100%; }
.chip:hover { border-color: var(--amber); }
.chip.primary { background: var(--amber); color: var(--night); border-color: var(--amber); font-weight: 600; }
.composer { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 1px solid rgb(var(--line-rgb) / .2); }
.composer input { flex: 1; min-width: 0; font: inherit; font-size: 0.95rem; color: var(--chalk); background: rgb(var(--chalk-rgb) / .06); border: 1px solid rgb(var(--line-rgb) / .35); border-radius: 8px; padding: 10px 12px; }
.composer input::placeholder { color: rgb(var(--chalk-rgb) / .5); }
.composer .btn { padding: 10px 16px; }

/* Stage: blueprint paper behind the phone */
.demo-stage { position: relative; display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 22px 16px 20px; min-width: 0;
  background-color: #0f2c3e; background-image: linear-gradient(rgb(var(--line-rgb) / .16) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--line-rgb) / .16) 1px, transparent 1px), linear-gradient(rgb(var(--line-rgb) / .06) 1px, transparent 1px), linear-gradient(90deg, rgb(var(--line-rgb) / .06) 1px, transparent 1px); background-size: 80px 80px, 80px 80px, 16px 16px, 16px 16px; }
.stage-status { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 0.75rem; color: var(--chalk-2); background: rgb(var(--night-rgb) / .8); border: 1px solid rgb(var(--line-rgb) / .3); border-radius: 999px; padding: 5px 12px; max-width: 100%; }
.stage-status .pulse { width: 8px; height: 8px; border-radius: 50%; background: #5cc493; flex: none; }
.stage-status:has(.live) .pulse { background: var(--amber); animation: pulse 1s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .3; } }
.dim { position: absolute; right: 18px; top: 70px; bottom: 70px; width: 10px; height: auto; stroke: rgb(var(--line-rgb) / .55); stroke-width: 1; fill: none; vector-effect: non-scaling-stroke; }
.dim path { vector-effect: non-scaling-stroke; }
@media (max-width: 420px) { .dim { display: none; } }

.phone { position: relative; width: min(300px, 100%); aspect-ratio: 300 / 600; background: #0a0f14; border-radius: 38px; padding: 12px; box-shadow: 0 0 0 1px rgb(var(--line-rgb) / .5), 0 24px 60px -20px rgb(0 0 0 / .7); display: flex; flex-direction: column; }
@media (max-width: 880px) { .phone { aspect-ratio: auto; height: 560px; } }
.phone-notch { position: absolute; top: 18px; left: 50%; translate: -50% 0; width: 72px; height: 18px; background: #0a0f14; border-radius: 0 0 12px 12px; z-index: 2; }
.phone-url { display: flex; align-items: center; justify-content: center; gap: 5px; padding: 26px 10px 8px; background: #f3f5f7; color: #4c6273; font-family: var(--mono); font-size: 0.68rem; border-radius: 28px 28px 0 0; white-space: nowrap; overflow: hidden; }
.phone-url svg { width: 10px; height: 10px; flex: none; }
.phone-url span { overflow: hidden; text-overflow: ellipsis; }

/* The generated app: always its own light theme, coloured by --brand */
.screen { --brand: #9a4a24; flex: 1; overflow: hidden auto; background: #fff; color: #1d2730; border-radius: 0 0 28px 28px; padding: 10px 10px 14px; font-size: 0.8rem; line-height: 1.4; display: flex; flex-direction: column; gap: 8px; font-family: var(--sans); scrollbar-width: none; }
.screen .empty { flex: 1; display: grid; place-items: center; border: 1.5px dashed #a9bccb; border-radius: 12px; color: #6d8394; font-family: var(--mono); font-size: 0.72rem; background: repeating-linear-gradient(0deg, transparent 0 15px, rgb(95 135 166 / .08) 15px 16px), repeating-linear-gradient(90deg, transparent 0 15px, rgb(95 135 166 / .08) 15px 16px); }
.b { position: relative; border-radius: 8px; transition: background-color .35s, box-shadow .35s, outline-color .35s; outline: 1.5px dashed transparent; outline-offset: 0; }
.b > * { transition: opacity .35s; }
.b.draft { min-height: 30px; }
.b.draft > * { opacity: 0; }
.b.draft.drawn { outline-color: #5f87a6; background: repeating-linear-gradient(0deg, transparent 0 11px, rgb(95 135 166 / .1) 11px 12px), repeating-linear-gradient(90deg, transparent 0 11px, rgb(95 135 166 / .1) 11px 12px), #f2f7fb; }
.b.draft.drawn::after { content: attr(data-l); position: absolute; top: 4px; left: 6px; font-family: var(--mono); font-size: 0.6rem; color: #5f87a6; }
.b:not(.draft):not(.ink) { opacity: 0; }
.b.changed.ink { outline: 2px solid #f29d1c; outline-offset: 2px; animation: flash 1.4s ease-out 2; }
@keyframes flash { 0% { box-shadow: 0 0 0 0 rgb(242 157 28 / .55); } 100% { box-shadow: 0 0 0 10px rgb(242 157 28 / 0); } }
.screen .ah { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 8px 10px; background: var(--brand); color: #fff; border-radius: 8px; transition: background-color .4s; }
.screen .ah strong { font-stretch: 108%; }
.screen .cart, .screen .live-dot { font-size: 0.68rem; background: rgb(255 255 255 / .2); border-radius: 999px; padding: 2px 8px; }
.screen .hero-b { display: grid; gap: 2px; padding: 16px 12px; border-radius: 8px; color: #fff; background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 80%, #000), var(--brand)); transition: background .4s; }
.screen .hero-b span { font-size: 1.05rem; font-weight: 600; font-stretch: 110%; }
.screen .hero-b small { opacity: .85; }
.screen .pgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.screen .pc { display: grid; gap: 2px; }
.screen .pc b { color: var(--brand); }
/* Woven swatches stand in for product photos */
.screen .sw { aspect-ratio: 1; border-radius: 6px; background-color: #c9a46b; background-image: repeating-linear-gradient(0deg, rgb(0 0 0 / .12) 0 2px, transparent 2px 5px), repeating-linear-gradient(90deg, rgb(255 255 255 / .18) 0 2px, transparent 2px 5px); }
.screen .sw.w2 { background-color: #7b8f6a; } .screen .sw.w3 { background-color: #4e5d73; } .screen .sw.w4 { background-color: #a5553a; }
.screen .sw.big { aspect-ratio: 4 / 3; }
.screen h4 { margin: 0; font-size: 1rem; }
.screen .price { font-weight: 700; color: var(--brand); }
.screen .muted { color: #6d7c88; margin: 0; }
.screen .row { display: flex; justify-content: space-between; gap: 8px; padding: 5px 2px; border-bottom: 1px solid #eef1f4; }
.screen .row.tot { font-weight: 700; border-bottom: 0; }
.screen .row.ok { color: #2c7a55; } .screen .row.warn { color: #b8326a; }
.screen .row.svc { padding: 8px 2px; }
.screen .fld { border: 1px solid #dfe5ea; border-radius: 6px; padding: 6px 8px; color: #6d7c88; margin-bottom: 5px; }
.screen .pm { display: flex; align-items: center; gap: 8px; border: 1px solid #dfe5ea; border-radius: 6px; padding: 7px 8px; margin-bottom: 5px; }
.screen .pm.sel { border-color: var(--brand); }
.screen .radio { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid #9aa8b3; flex: none; }
.screen .pm.sel .radio { border: 4px solid var(--brand); }
.screen .badge { margin-left: auto; font-size: 0.65rem; font-weight: 600; background: #fdf0dc; color: #8a5200; border-radius: 999px; padding: 2px 7px; }
.screen .badge.inline { display: inline-block; margin: 4px 0 0; }
.screen .pm .muted { margin-left: auto; font-size: 0.68rem; }
.screen .paybtn { text-align: center; background: var(--brand); color: #fff; font-weight: 600; border-radius: 8px; padding: 9px; margin-top: 4px; transition: background-color .4s; }
.screen .days, .screen .slots { display: flex; flex-wrap: wrap; gap: 5px; }
.screen .days span, .screen .slots span { border: 1px solid #dfe5ea; border-radius: 6px; padding: 5px 7px; font-size: 0.72rem; }
.screen .days .sel, .screen .slots .sel { background: var(--brand); color: #fff; border-color: var(--brand); }
.screen .sms-head { text-align: center; font-weight: 600; padding: 6px 0 8px; border-bottom: 1px solid #eef1f4; margin-bottom: 8px; }
.screen .sms { background: #eef1f4; border-radius: 12px 12px 12px 4px; padding: 8px 10px; margin-bottom: 8px; max-width: 92%; }
.screen .sms.changed { outline: 2px solid #f29d1c; }
.screen .toast { background: #e7f5ee; color: #1f6b47; border-radius: 8px; padding: 8px 10px; font-weight: 600; }
.screen .order { padding: 4px 0; }

.screen-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; min-height: 30px; }
.screen-tabs button { font: inherit; font-family: var(--mono); font-size: 0.72rem; color: var(--chalk-2); background: rgb(var(--night-rgb) / .7); border: 1px solid rgb(var(--line-rgb) / .35); border-radius: 999px; padding: 5px 10px; cursor: pointer; }
.screen-tabs button[aria-selected="true"] { color: var(--night); background: var(--chalk); border-color: var(--chalk); }
.screen-tabs button:disabled { opacity: .45; cursor: default; }
.demo-note { font-family: var(--mono); font-size: 0.75rem; color: var(--chalk-2); margin: 12px 0 0; }
</style>
