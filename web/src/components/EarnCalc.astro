---
// Earnings estimator. Initial numbers are computed here with the same formula the script uses,
// so the page is correct before (and without) JavaScript.
import site from "../data/site.json";
const { calculator: c, rates: r } = site;
const fmt = new Intl.NumberFormat("en-IN", { maximumFractionDigits: 0 });
const h = c.idleHours.start, gb = c.diskGB.start;
let coreHours = 0, kwh = 0;
for (const k of c.kinds) { coreHours += k.start * k.cores * k.speed * h * c.days; kwh += k.start * k.watts * h * c.days / 1000; }
const storage = gb * r.storageTkPer250GB / 250, compute = coreHours * r.coreHourTk, power = kwh * r.tkPerKwh;
const config = JSON.stringify({ kinds: c.kinds, days: c.days, coreHourTk: r.coreHourTk, storageTkPer250GB: r.storageTkPer250GB, tkPerKwh: r.tkPerKwh });
---
<form class="console earn-calc" id="earn-calc" onsubmit="return false" aria-label="Earnings estimate" data-config={config}>
  <fieldset class="counts">
    <legend>What could you share?</legend>
    {c.kinds.map((k) => (
      <div class="count" data-kind={k.id}><span>{k.label}</span><button type="button" data-d="-1" aria-label={`One fewer ${k.noun}`}>−</button><output>{k.start}</output><button type="button" data-d="1" aria-label={`One more ${k.noun}`}>+</button></div>
    ))}
  </fieldset>
  <label for="idle-hours">Idle hours a day <output id="idle-out">{h} h</output></label>
  <input type="range" id="idle-hours" min={c.idleHours.min} max={c.idleHours.max} value={h} />
  <label for="disk-gb">Spare disk space to rent <output id="disk-out">{fmt.format(gb)} GB</output></label>
  <input type="range" id="disk-gb" min={c.diskGB.min} max={c.diskGB.max} step={c.diskGB.step} value={gb} />
  <dl>
    <dt>Storage credit</dt><dd id="e-storage">Tk {fmt.format(storage)}</dd>
    <dt>Computing, <span id="e-corehours">{fmt.format(coreHours)}</span> core-hours</dt><dd id="e-compute">Tk {fmt.format(compute)}</dd>
    <dt>Your extra electricity</dt><dd id="e-power">− Tk {fmt.format(power)}</dd>
    <dt class="total">About, each month</dt><dd class="total" id="e-net">Tk {fmt.format(Math.max(0, storage + compute - power))}</dd>
  </dl>
  <p class="small">An estimate, not a promise. Storage pays Tk {r.storageTkPer250GB} per 250 GB a month during the pilot. Computing starts in {r.computeFrom} at a target of Tk {r.coreHourTk.toFixed(2)} per core-hour, depending on demand. Electricity is counted at about Tk {r.tkPerKwh} a unit. Paid as plan credit first, then by bKash.</p>
</form>
