---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Demo from "../components/Demo.astro";
import Src from "../components/Src.astro";
import Sources from "../components/Sources.astro";
import facts, { tk, plan } from "../data/facts";
import "../styles/app-screen.css";
const m = facts.market;
const starter = plan("starter"), business = plan("business");
// Static "after" screen: the same fictional shop the demo builds.
const products: [string, number, string][] = [["Market tote", 1450, "w1"], ["Sling bag", 980, "w2"], ["Laptop sleeve", 1650, "w3"], ["Coin pouch", 350, "w4"]];
const rates: [string, string, string][] = [
  ["Checkout by bKash, Nagad or card", "Paid into your own merchant account", "Included"],
  ["Courier booking", "The courier charges its own delivery fee", "Included"],
  ["Your web address", "yourname.amader.cloud", "Included"],
  ["Hosting, backups and updates", "We keep it running", "Included"],
  ["Changes by asking", `On Starter; extra changes ${tk(facts.pricing.extraEditTk)} each`, `${starter.edits} a month`],
  ["SMS to your customers", "On Business", `${business.sms} a month`],
];
---
<Base title="Amader Cloud: describe your business, AI builds its app" description="Tell Amader Cloud what you sell in one sentence. It builds a working online shop, booking page or fee collection, with bKash, Nagad and card payments already set up.">

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="signboard">
        <h1>Describe your shop. AI builds&nbsp;it.</h1>
        <span class="address">Open at <span class="url">yourname.amader.cloud</span></span>
      </div>
      <p class="lede">Tell Amader Cloud what you sell in one sentence. It builds a working online shop, booking page or fee collection, with bKash, Nagad and card payments already set up.</p>
      <div class="btn-row"><a class="btn btn-go" href="contact.html?topic=beta">Join the beta</a></div>
    </div>

    <figure class="before-after" aria-label="Before: a one-sentence request. After: the finished shop on a phone.">
      <div class="ba-before">
        <span class="ba-cap">What you type</span>
        <p class="ba-request">A shop for my handmade bags, with bKash payment and delivery.</p>
      </div>
      <svg class="ba-arrow" viewBox="0 0 130 100" aria-hidden="true"><path d="M14 6 C 8 58, 48 84, 116 72" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><path d="M98 58 L118 72 L100 88" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="ba-after">
        <div class="phone">
          <div class="phone-notch" aria-hidden="true"></div>
          <div class="phone-url"><span>jutethread.amader.cloud</span></div>
          <div class="screen">
            <div class="b ink"><div class="ah"><strong>Jute &amp; Thread</strong><span class="cart">Bag · 0</span></div></div>
            <div class="b ink"><div class="hero-b"><span>Handmade jute bags</span><small>Delivery across Bangladesh</small></div></div>
            <div class="b ink"><div class="pgrid">{products.map(([n, p, w]) => <div class="pc"><div class={`sw ${w}`}></div><span>{n}</span><b>{tk(p)}</b></div>)}</div></div>
          </div>
        </div>
        <figcaption class="ba-cap">What you get: a made-up shop, for illustration</figcaption>
      </div>
    </figure>
  </div>
</section>

<section class="section alt">
  <div class="wrap rate-grid">
    <div>
      <h2>What comes with every shop</h2>
      <p class="lede">You don't connect anything yourself. Ask for a change in plain words, and we keep the shop running.</p>
      <p class="small"><span class="hyp">Pilot pricing</span> <a href="pricing.html">All plans</a></p>
    </div>
    <ul class="rates">
      {rates.map(([item, note, val]) => <li><span class="item">{item}<small>{note}</small></span><span class="lead" aria-hidden="true"></span><span class="val">{val}</span></li>)}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap cod">
    <Photo id="delivery-van" class="cod-photo" sizes="(max-width: 860px) 100vw, 40vw" />
    <div>
      <h2 class="cod-h">Prepaid orders rarely come back.</h2>
      <p class="lede">Most online orders in Bangladesh are paid in cash at the door, and many are refused when the courier arrives. Your own checkout lets buyers pay first, while your Facebook page keeps bringing them in.</p>
      <div class="cod-stats">
        <div class="stat"><span class="n">{m.codShare.text}</span><span class="l">{m.codShare.label}.</span><Src id={m.codShare.source} /></div>
        <div class="stat"><span class="n red">{m.codReturns.text}</span><span class="l">{m.codReturns.label}.</span><Src id={m.codReturns.source} /></div>
      </div>
    </div>
  </div>
</section>

<section class="section alt" id="demo">
  <div class="wrap">
    <div class="head">
      <h2>Try the builder</h2>
      <p class="lede">Pick a business or type your own. Watch the app come together, then ask for a change.</p>
    </div>
    <Demo />
  </div>
</section>

<section class="section">
  <div class="wrap closing">
    <div class="signboard sign-yellow">
      <h2>Free to build. {tk(starter.tk)} a month to go&nbsp;live.</h2>
      <span class="address">Pilot pricing, paid by bKash</span>
    </div>
    <div>
      <p class="lede">The closed beta opens to a small group of businesses first.</p>
      <div class="btn-row"><a class="btn btn-go" href="contact.html?topic=beta">Join the beta</a><a class="btn" href="pricing.html">See the plans</a></div>
    </div>
  </div>
  <div class="wrap"><Sources ids={["easysell"]} /></div>
</section>

<style>
.hero { padding-block: clamp(28px, 4vw, 56px) clamp(48px, 7vw, 96px); }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
@media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } }
.hero-copy .signboard h1 { font-size: clamp(3.2rem, 1.8rem + 4.6vw, 6rem); }
.hero-copy .lede { margin-top: 26px; max-width: 46ch; }

.before-after { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: 0 4px; align-items: start; }
.ba-before { grid-column: 1; grid-row: 1; position: relative; z-index: 1; background: var(--card); border: 1.5px solid var(--line); border-radius: 18px 18px 18px 4px; padding: 14px 18px 16px; max-width: 280px; margin-top: 28px; }
.ba-request { font-size: 1.15rem; font-weight: 600; line-height: 1.35; margin: 4px 0 0; }
.ba-cap { display: block; font-size: 0.85rem; font-weight: 600; color: var(--ink-2); }
.ba-arrow { grid-column: 1; grid-row: 2; width: 130px; justify-self: end; color: var(--red); margin: 6px 6px 0 0; }
.ba-after { grid-column: 2; grid-row: 1 / 3; display: grid; justify-items: center; gap: 12px; }
.ba-after .phone { width: 248px; }
.ba-after .ba-cap { text-align: center; max-width: 248px; }
@media (max-width: 1000px) { .before-after { max-width: 620px; } }
@media (max-width: 560px) {
  .before-after { grid-template-columns: 1fr; justify-items: center; }
  .ba-before { grid-column: 1; grid-row: 1; justify-self: stretch; max-width: none; margin: 0; }
  .ba-arrow { grid-row: 2; width: 70px; justify-self: center; transform: rotate(60deg); margin: 0; }
  .ba-after { grid-column: 1; grid-row: 3; }
}

.rate-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
@media (max-width: 860px) { .rate-grid { grid-template-columns: 1fr; } }
.rate-grid h2 { max-width: 12ch; }

.cod { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
:global(.cod-photo) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 4px; }
.cod-h { max-width: 13ch; }
.cod-stats { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); margin-top: 28px; }
.cod .stat { border-left: 3px solid var(--rule); padding-left: 20px; }
.cod .n.red { color: var(--red); }
@media (max-width: 860px) { .cod { grid-template-columns: 1fr; } :global(.cod-photo) { aspect-ratio: 4 / 3; } }
@media (max-width: 480px) { .cod-stats { grid-template-columns: 1fr; } }

.closing { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
@media (max-width: 860px) { .closing { grid-template-columns: 1fr; } }
.closing .signboard h2 { font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.8rem); }
</style>
</Base>
