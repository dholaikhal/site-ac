---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import Ticker from "../components/Ticker.astro";
import BetaButton from "../components/BetaButton.astro";
import ProblemScene from "../components/ProblemScene.astro";
import Photo from "../components/Photo.astro";
import SafeBase from "../components/SafeBase.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CustomerLogos from "../components/CustomerLogos.astro";
import Stories from "../components/Stories.astro";
import Faq from "../components/Faq.astro";
import facts, { tk, plan } from "../data/facts";
import "../styles/app-screen.css";
import Device from "../components/Device.astro";
import Brand from "../components/Brand.astro";
import Showcase from "../components/Showcase.astro";
// Four kinds with example apps of their own, then the catch-all: whatever the idea is.
const KINDS = ["Facebook page", "home kitchen", "salon", "clinic", "idea"];
const m = facts.market;
const starter = plan("starter"), business = plan("business");
const rates: [string, string, string, string[]?][] = [
  ["Checkout by bKash, Nagad or card", "Paid into your own merchant account", "Included", ["bkash", "nagad", "visa", "mastercard"]],
  ["Courier booking", "The courier charges its own delivery fee", "Included", ["pathao", "steadfast", "redx"]],
  ["Your web address", "yourname.amader.cloud", "Included"],
  ["Hosting, backups and updates", "We keep it running", "Included"],
  ["A safe base under it", "Tested checkout, logins and data, the same under every store", "Included"],
  ["Changes by asking", `On Starter; extra changes ${tk(facts.pricing.extraEditTk)} each`, `${starter.edits} a month`],
  ["SMS to your customers", "On Business", `${business.sms} a month`],
];
const ticker = ["bKash checkout", "Nagad", "Cards", "Courier booking", "Order SMS", "Bookings with deposits", "Fee receipts", "Write it your way", "Change it by asking", "yourname.amader.cloud"];
---
<Base title="Amader Cloud: describe your business, our agent builds its app" description="Tell Amader Cloud what you sell in one sentence. It builds a working online store, booking page or fee collection, with bKash, Nagad and card payments already set up.">

<section class="hero" data-qb>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="signboard lit">
        <h1><span class="hl">A store for your</span>
          <!-- The kinds of business slide sideways along the board; the chosen one sits in the middle, lit. The list
               is drawn three times so it can turn either way without an end; only the middle copy is read out. -->
          <span class="hl hw"><span class="hw-track" data-qb-reel role="group" aria-label="Kind of business">
            {[0, 1, 2].flatMap((copy) => KINDS.map((word, i) =>
              <button type="button" data-qb-pick={i} data-word={word} aria-pressed={copy === 1 && i === 0 ? "true" : "false"} tabindex={copy === 1 ? 0 : -1} aria-hidden={copy === 1 ? undefined : "true"} class:list={{ on: copy === 1 && i === 0, idea: word === "idea" }}>{word === "idea" ? <><span class="spk" aria-hidden="true">✦</span> idea <span class="spk" aria-hidden="true">✦</span></> : word}</button>))}
          </span></span>
          <span class="hl">from one sentence.</span></h1>
        <span class="address">Payments by <Brand id="bkash" h={18} />, Nagad and card, built in</span>
      </div>
      <div class="qb-bar">
        <div class="qb-in"><span class="qb-cap" data-st="type" aria-live="polite">You type</span><p data-qb-text></p></div>
        <span class="qb-send" aria-hidden="true">→</span>
      </div>
      <div class="btn-row"><BetaButton sticker="" /><WhatsAppButton /></div>
      <p class="cta-line"><span>Free while you build</span><span>Pay when you go live</span><span>Cancel any time</span></p>
    </div>

    <figure class="qb" aria-label="Our agent building an app from one sentence, for different kinds of business (animation)">
      <div class="qb-phone">
        <Device kind="phone">
          <div class="notif qb-notif" data-qb-notif></div>
          <div class="phone-url"><span data-qb-url>…</span></div>
          <div class="screen" data-qb-screen></div>
        </Device>
        <a class="qb-live" data-qb-live target="_blank" rel="noopener"><i></i>Live at <span class="url" data-qb-url-2></span></a>
      </div>
    </figure>
  </div>
</section>

<section class="band band-green demo-band has-photo fade-low" id="demo">
  <Photo id="street" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="band-head band-split" data-reveal>
      <h2 class="slogan">Try it.<br> Build one now.</h2>
      <p class="lede">Pick a kind of business, or write what you want, how you want. Then open it to customers and watch the orders come in.</p>
    </div>
    <Demo />
  </div>
</section>


<Ticker items={ticker} />

<CustomerLogos />

<Showcase />

<ProblemScene />

<SafeBase />

<Stories />

<section class="band band-yellow has-photo fade-right">
  <Photo id="facades" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap rate-grid">
    <div data-reveal>
      <h2 class="slogan">All in.<br>No setup.</h2>
      <p class="lede">What comes with every store. Ask for changes in plain words.</p>
      <a class="band-link" href="pricing.html">See the plans →</a>
    </div>
    <ul class="rates board" data-reveal style="--d:1">
      {rates.map(([item, note, val, logos]) => <li><span class="item">{item}<small>{note}</small>{logos && <span class="rl">{logos.map((id) => <Brand id={id as any} h={18} />)}</span>}</span><span class="lead" aria-hidden="true"></span><span class="val">{val}</span></li>)}
    </ul>
  </div>
</section>

<section class="band band-plum has-photo faq-band">
  <Photo id="tea-stall" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap faq-grid">
    <div class="head" data-reveal>
      <h2>Questions owners ask first</h2>
      <p class="small">Anything else: <a href="contact.html">write to us</a>, or ask on WhatsApp.</p>
    </div>
    <div data-reveal style="--d:1"><Faq /></div>
  </div>
</section>

<section class="band band-navy has-photo fade-left">
  <Photo id="sunset" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap closing">
    <div class="signboard sign-yellow" data-reveal>
      <h2>Free to build. {tk(starter.tk)} a month to go&nbsp;live.</h2>
      <span class="address">Pilot pricing, paid by bKash</span>
    </div>
    <div data-reveal style="--d:1">
      <p class="lede">The closed beta opens to the first {facts.mvp.phases[1].output.match(/\d+/)?.[0]} businesses. Tell us what you sell and we'll set you up.</p>
      <div class="btn-row"><BetaButton label="Get my store" /><a class="btn" href="pricing.html">See the plans</a></div>
    </div>
  </div>
</section>

<style>
.hero { position: relative; padding-block: clamp(28px, 4vw, 56px) clamp(28px, 4vw, 48px); overflow: hidden; --h1: clamp(2.5rem, 1.3rem + 4.4vw, 5.6rem); }
/* One column tells it top to bottom (headline, kind of business, the sentence, the action); the phone beside
   it is scaled to the same height, tops and bottoms level */
.hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(32px, 5vw, 72px); align-items: stretch; }
.hero-copy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.hero-copy .signboard h1 { font-size: var(--h1); line-height: 1.02; }
.hl { display: block; }
/* The middle line is a track the kinds of business slide along, reaching the board's pinstripe: the chosen
   one lit and in line with the other lines, the next ones muted to its right, a sliver of the last one to its left */
.hw { --hp: calc(clamp(24px, 4vw, 52px) - 12px); position: relative; overflow: hidden; margin-inline: calc(-1 * var(--hp)); padding-block: 0.04em; -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / .2), #000 var(--hp), #000 78%, transparent); mask-image: linear-gradient(90deg, rgb(0 0 0 / .2), #000 var(--hp), #000 78%, transparent); }
.hw-track { display: flex; gap: 0.32em; width: max-content; will-change: transform; }
.hw-track.glide { transition: transform .62s cubic-bezier(.3,1.15,.4,1); }
.hw-track button { flex: none; font: inherit; letter-spacing: inherit; line-height: inherit; padding: 0; border: 0; background: none; color: inherit; text-shadow: inherit; opacity: .32; cursor: pointer; transition: color .35s, opacity .35s; }
.hw-track button:hover, .hw-track button:focus-visible { opacity: .7; }
.hw-track button.on { color: #fff; opacity: 1; }
.hw-track .spk { display: inline-block; font-size: 0.55em; vertical-align: 0.5em; color: var(--yellow); animation: twinkle-spk 1.6s ease-in-out infinite; }
.hw-track .spk:last-child { animation-delay: -.8s; }
@keyframes twinkle-spk { 50% { opacity: .35; scale: .7; rotate: 25deg; } }
/* The catch-all's phone: placeholder apps composed from a kit of parts, each fading in over the last */
.qb :global(.gx) { --ink-g: color-mix(in srgb, var(--b) 55%, var(--s)); position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; gap: var(--gg, 9px); padding: 10px 12px; background: var(--bg); opacity: 0; transition: opacity .3s ease; overflow: hidden; }
.qb :global(.gx.in) { opacity: 1; }
/* The body holds more than fits and runs off the bottom, so the screen is always full; the footer stays pinned */
.qb :global(.g-body) { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: var(--gg, 9px); overflow: hidden; }
.qb :global(.g-body > .gp) { flex: none; }
.qb :global(.gx i) { display: block; border-radius: 6px; background: var(--s); }
.qb :global(.gx .g-t) { height: 8px; border-radius: 4px; background: var(--ink-g); }
.qb :global(.gx .g-t.thin) { height: 6px; opacity: .6; }
.qb :global(.gx .g-t.big) { height: 14px; background: var(--b); }
.qb :global(.gx .g-t.inv) { background: rgb(255 255 255 / .92); }
.qb :global(.gx .g-t.price) { background: var(--b); }
.qb :global(.g-bar) { display: flex; align-items: center; gap: 8px; height: 30px; flex: none; }
.qb :global(.g-bar.centre) { justify-content: space-between; }
.qb :global(.g-logo) { width: 26px; height: 26px; border-radius: 8px !important; background: var(--b) !important; }
.qb :global(.g-ic) { width: 18px; height: 18px; border-radius: 50% !important; margin-left: auto; }
.qb :global(.g-ic + .g-ic) { margin-left: 0; }
.qb :global(.g-search) { flex: 1; height: 26px; border-radius: 999px !important; }
.qb :global(.g-hero) { flex: none; border-radius: var(--gr, 14px); padding: 14px; display: flex; flex-direction: column; justify-content: flex-end; gap: 7px; }
.qb :global(.g-hero.photo) { height: 120px; background: linear-gradient(135deg, var(--b), var(--a)); }
.qb :global(.g-hero.banner) { height: 72px; background: var(--b); flex-direction: row; align-items: center; justify-content: space-between; }
.qb :global(.g-hero.split) { height: 96px; background: var(--s); flex-direction: row; align-items: center; justify-content: space-between; }
.qb :global(.g-hero.split > div) { flex: 1; display: grid; gap: 7px; }
.qb :global(.g-circle) { width: 64px; height: 64px; border-radius: 50% !important; background: var(--a) !important; }
.qb :global(.g-pill) { width: 64px; height: 20px; border-radius: 999px !important; background: var(--b) !important; }
.qb :global(.g-hero.photo .g-pill), .qb :global(.g-pill.light) { background: #fff !important; }
.qb :global(.g-chips) { display: flex; gap: 6px; flex: none; }
.qb :global(.g-chips i) { height: 22px; border-radius: 999px; }
.qb :global(.g-chips i.on), .qb :global(.g-days i.on), .qb :global(.g-slots i.on), .qb :global(.g-tabs i.on) { background: var(--b); }
.qb :global(.g-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.qb :global(.g-card) { display: grid; gap: 5px; }
.qb :global(.g-img) { height: 70px; border-radius: var(--gr, 10px) !important; background: color-mix(in srgb, var(--a) 55%, var(--s)) !important; }
.qb :global(.g-list) { display: grid; gap: 8px; }
.qb :global(.g-row) { display: flex; align-items: center; gap: 9px; padding: 8px; border-radius: var(--gr, 10px); background: var(--card-g, #fff); }
.qb :global(.g-row span) { flex: 1; display: grid; gap: 5px; }
.qb :global(.g-av) { width: 30px; height: 30px; border-radius: 50% !important; background: var(--a) !important; }
.qb :global(.g-tag) { width: 34px; height: 16px; border-radius: 999px !important; background: var(--b) !important; opacity: .8; }
.qb :global(.g-cal) { display: grid; gap: 8px; }
.qb :global(.g-days) { display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; }
.qb :global(.g-days i) { height: 34px; border-radius: 8px; }
.qb :global(.g-slots) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
.qb :global(.g-slots i) { height: 20px; border-radius: 999px; }
.qb :global(.g-stats) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.qb :global(.g-stats > div) { display: grid; gap: 6px; padding: 10px 8px; border-radius: var(--gr, 10px); background: var(--card-g, #fff); }
.qb :global(.g-map) { position: relative; height: 90px; border-radius: 12px; background: repeating-linear-gradient(35deg, var(--s) 0 14px, color-mix(in srgb, var(--s) 70%, #fff) 14px 18px); }
.qb :global(.g-pin) { position: absolute; left: 48%; top: 30%; width: 18px; height: 18px; border-radius: 50% 50% 50% 0 !important; rotate: -45deg; background: var(--b) !important; }
.qb :global(.g-form) { display: grid; gap: 7px; }
.qb :global(.g-field) { height: 28px; border-radius: 8px !important; background: #fff !important; box-shadow: inset 0 0 0 1.5px var(--s); }
.qb :global(.g-btn) { height: 30px; border-radius: 8px !important; background: var(--b) !important; }
.qb :global(.g-thumbs) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.qb :global(.g-thumbs i) { height: 58px; border-radius: 10px; background: color-mix(in srgb, var(--a) 45%, var(--s)); }
.qb :global(.g-tabs) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 8px 10px 0; border-top: 1px solid var(--s); flex: none; }
.qb :global(.g-tabs i) { height: 18px; border-radius: 6px; }
.qb :global(.g-cta) { flex: none; height: 40px; border-radius: var(--gr, 12px); background: var(--b); display: grid; place-items: center; }
.qb :global(.g-cta .g-t) { margin: 0 auto; }
/* Each placeholder app draws its own card style; dark ones get light cards */
.qb :global(.gx.dark) { --card-g: color-mix(in srgb, var(--s) 70%, #000); --ink-g: color-mix(in srgb, var(--b) 60%, #fff); }
.qb :global(.gx.c-outline .g-row), .qb :global(.gx.c-outline .g-stats > div), .qb :global(.gx.c-outline .g-card), .qb :global(.gx.c-outline .g-plans > div), .qb :global(.gx.c-outline .g-ticket) { box-shadow: inset 0 0 0 1.5px var(--s); background: transparent; }
.qb :global(.gx.c-shadow .g-row), .qb :global(.gx.c-shadow .g-stats > div), .qb :global(.gx.c-shadow .g-card), .qb :global(.gx.c-shadow .g-plans > div), .qb :global(.gx.c-shadow .g-ticket) { box-shadow: 0 6px 14px -8px rgb(0 0 0 / .35); }
.qb :global(.gx.c-shadow .g-card) { padding: 5px; border-radius: var(--gr, 10px); background: var(--card-g, #fff); }
/* More of the kit */
.qb :global(.gx .g-t.huge) { height: 16px; background: var(--b); }
.qb :global(.g-profile) { display: flex; align-items: center; gap: 10px; flex: none; }
.qb :global(.g-profile span) { flex: 1; display: grid; gap: 6px; }
.qb :global(.g-av.big) { width: 40px; height: 40px; }
.qb :global(.g-hero.radial) { height: 110px; background: radial-gradient(circle at 75% 20%, var(--a), var(--b) 70%); }
.qb :global(.g-dots) { display: flex; gap: 4px; }
.qb :global(.g-dots i) { width: 6px; height: 6px; border-radius: 50% !important; background: rgb(255 255 255 / .5) !important; }
.qb :global(.g-dots i.on) { width: 16px; border-radius: 3px !important; background: #fff !important; }
.qb :global(.g-hero.video) { height: 120px; background: linear-gradient(160deg, color-mix(in srgb, var(--b) 80%, #000), var(--a)); align-items: center; justify-content: center; }
.qb :global(.g-play) { width: 38px; height: 38px; border-radius: 50% !important; background: rgb(255 255 255 / .9) !important; clip-path: none; position: relative; }
.qb :global(.g-play::after) { content: ""; position: absolute; left: 15px; top: 11px; border: 8px solid transparent; border-left: 12px solid var(--b); border-right: 0; }
.qb :global(.g-hero.type) { height: auto; padding: 6px 2px; background: transparent; gap: 8px; }
.qb :global(.g-grid.three) { grid-template-columns: repeat(3, 1fr); }
.qb :global(.g-img.sq) { height: 54px; }
.qb :global(.g-menu), .qb :global(.g-receipt) { display: grid; gap: 9px; padding: 4px 2px; }
.qb :global(.g-receipt) { padding: 10px; border-radius: var(--gr, 10px); background: var(--card-g, #fff); border: 1.5px dashed var(--s); }
.qb :global(.g-mrow) { display: flex; align-items: center; gap: 6px; }
.qb :global(.g-mrow .g-lead) { flex: 1; height: 0; border-bottom: 2px dotted var(--s); background: none; }
.qb :global(.g-mrow.tot) { padding-top: 6px; border-top: 1.5px solid var(--s); }
.qb :global(.g-ticket) { display: flex; align-items: center; gap: 10px; padding: 12px; border-radius: var(--gr, 10px); background: var(--card-g, #fff); border-left: 5px solid var(--b); }
.qb :global(.g-ticket > div) { flex: 1; display: grid; gap: 7px; }
.qb :global(.g-qr) { width: 44px; height: 44px; border-radius: 4px !important; background: repeating-conic-gradient(var(--b) 0 25%, transparent 0 50%) 0 0 / 11px 11px !important; }
.qb :global(.g-chat) { display: grid; gap: 7px; }
.qb :global(.g-bub) { height: 24px; border-radius: 12px; }
.qb :global(.g-bub.l) { justify-self: start; border-bottom-left-radius: 3px; background: var(--s); }
.qb :global(.g-bub.r) { justify-self: end; border-bottom-right-radius: 3px; background: var(--b); }
.qb :global(.g-steps) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
.qb :global(.g-steps i) { height: 6px; border-radius: 3px; }
.qb :global(.g-steps i.on) { background: var(--b); }
.qb :global(.g-plans) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.qb :global(.g-plans > div) { display: grid; gap: 7px; padding: 10px; border-radius: var(--gr, 10px); background: var(--card-g, #fff); }
.qb :global(.g-plans > div.on) { box-shadow: inset 0 0 0 2px var(--b); }
.qb :global(.g-progress) { display: grid; gap: 7px; }
.qb :global(.g-track) { height: 10px; border-radius: 5px; background: var(--s); overflow: hidden; }
.qb :global(.g-track i) { height: 100%; border-radius: 5px; background: linear-gradient(90deg, var(--b), var(--a)); }
.qb :global(.g-count) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
.qb :global(.g-count i) { height: 40px; border-radius: var(--gr, 8px); background: var(--b); opacity: .9; }
.qb :global(.g-toggles) { display: grid; gap: 8px; }
.qb :global(.g-tg) { display: flex; align-items: center; justify-content: space-between; }
.qb :global(.g-sw) { width: 30px; height: 16px; border-radius: 999px !important; position: relative; }
.qb :global(.g-sw::after) { content: ""; position: absolute; left: 2px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; }
.qb :global(.g-sw.on) { background: var(--b) !important; }
.qb :global(.g-sw.on::after) { left: 16px; }
.qb :global(.g-cta.split) { display: flex; align-items: center; gap: 8px; padding: 0 8px; background: transparent; }
.qb :global(.g-cta.split .g-qty) { width: 64px; height: 34px; border-radius: var(--gr, 8px); background: var(--s); }
.qb :global(.g-cta.split span) { flex: 1; height: 38px; border-radius: var(--gr, 10px); background: var(--b); display: grid; place-items: center; }
@media (prefers-reduced-motion: reduce) { .qb :global(.gx) { transition: none; } }
.hero-copy .btn-row { margin-top: auto; padding-top: 6px; }
.cta-line { display: flex; flex-wrap: wrap; column-gap: 0.55em; margin: -6px 0 0; font-size: 0.92rem; color: var(--ink-2); }
.cta-line span { white-space: nowrap; }
.cta-line span + span::before { content: "·"; margin-right: 0.55em; }
/* Narrow phones: the phrases wrap as a centred group, without separators left hanging */
@media (max-width: 480px) { .cta-line { column-gap: 1em; } .cta-line span + span::before { content: none; } }
/* The board's tube light comes on once, at dusk */
.lit { animation: tube 1.6s steps(1, end) .3s both; }
@keyframes tube { 0% { filter: brightness(.55); } 12% { filter: brightness(1.05); } 18% { filter: brightness(.6); } 26%, 100% { filter: none; } }

/* The sentence, in a message bar; its sections fly from here into the phone */
.qb-bar { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "in send"; align-items: center; column-gap: 14px; padding: 14px 14px 14px 18px; background: var(--card); border: 1.5px solid var(--line); border-radius: 14px; box-shadow: 0 18px 36px -28px rgb(20 33 61 / .55); }
.qb-in { grid-area: in; }
.qb-bar p { font-size: 1.22rem; font-weight: 600; line-height: 1.35; margin: 2px 0 0; min-height: 2.7em; }
.qb-cap { display: block; font-size: 0.78rem; font-weight: 700; color: var(--ink-2); }
/* The caption tells the stage in place: You type, then the agent at work (a moving sweep of the sign paints), then Done! */
.qb-cap[data-st="busy"] { background: linear-gradient(90deg, var(--red), #d98f00, var(--blue), var(--green), var(--red)) 0 0 / 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: capflow 2s linear infinite; }
.qb-cap[data-st="busy"] .spark { color: var(--red); -webkit-text-fill-color: var(--red); }
.qb-cap[data-st="done"] { color: var(--green); }
:root[data-theme="dark"] .qb-cap[data-st="done"] { color: var(--ok); }
