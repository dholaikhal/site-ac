/* Live at: a badge on the phone's bottom bezel */
.qb-live { text-decoration: none; position: absolute; left: 50%; bottom: 14px; z-index: 3; white-space: nowrap; box-shadow: 0 10px 24px -10px rgb(0 0 0 / .5); display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 0.86rem; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; opacity: 0; translate: -50% 8px; transition: opacity .3s, translate .4s cubic-bezier(.2,.8,.2,1.4); }
.qb-live i { width: 8px; height: 8px; border-radius: 50%; background: var(--yellow); }
.qb-live.on { opacity: 1; translate: -50% 0; }
.qb-live .url { color: var(--yellow); }
.qb :global(.qb-notif) { top: 46px; }
.qb :global(.b.qb-wait) { opacity: 0; }
.qb :global(.b.qb-fly) { animation: qb-fly .45s cubic-bezier(.2,.75,.25,1) both; }
@keyframes qb-fly { from { transform: translate(var(--dx), var(--dy)) scale(.25); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }


