---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import Ticker from "../components/Ticker.astro";
import BetaButton from "../components/BetaButton.astro";
import ProblemScene from "../components/ProblemScene.astro";
import Photo from "../components/Photo.astro";
import InboxVsStore from "../components/InboxVsStore.astro";
import Faq from "../components/Faq.astro";
import facts, { tk, plan } from "../data/facts";
import "../styles/app-screen.css";
import Device from "../components/Device.astro";
import Brand from "../components/Brand.astro";
import Showcase from "../components/Showcase.astro";
const m = facts.market;
const starter = plan("starter"), business = plan("business");
const rates: [string, string, string, string[]?][] = [
  ["Checkout by bKash, Nagad or card", "Paid into your own merchant account", "Included", ["bkash", "nagad", "visa", "mastercard"]],
  ["Courier booking", "The courier charges its own delivery fee", "Included", ["pathao", "steadfast", "redx"]],
  ["Your web address", "yourname.amader.cloud", "Included"],
  ["Hosting, backups and updates", "We keep it running", "Included"],
  ["Changes by asking", `On Starter; extra changes ${tk(facts.pricing.extraEditTk)} each`, `${starter.edits} a month`],
  ["SMS to your customers", "On Business", `${business.sms} a month`],
];
const ticker = ["bKash checkout", "Nagad", "Cards", "Courier booking", "Order SMS", "Bookings with deposits", "Fee receipts", "Write it your way", "Change it by asking", "yourname.amader.cloud"];
---
<Base title="Amader Cloud: describe your business, our agent builds its app" description="Tell Amader Cloud what you sell in one sentence. It builds a working online store, booking page or fee collection, with bKash, Nagad and card payments already set up.">

<section class="hero" data-qb>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="signboard lit">
        <!-- The kind of business turns in a window on the board; the ones before and after peek in. Click one to build it. -->
        <h1><span class="hl">An app for your</span>
          <span class="slot"><ol class="qb-reel" data-qb-reel aria-label="Kind of business">
            {[["Facebook store"], ["home kitchen"], ["salon"], ["clinic"], ["pharmacy"], ["event"], ["AC service"], ["coaching centre"]].map(([word], i) =>
              <li style={`--o:${((i + 4) % 8) - 4}`} data-d={Math.abs(((i + 4) % 8) - 4) > 1 ? "far" : String(Math.abs(((i + 4) % 8) - 4))}><button type="button" data-qb-pick={i} aria-pressed={i === 0 ? "true" : "false"} tabindex={Math.abs(((i + 4) % 8) - 4) > 1 ? -1 : 0}>{word}</button></li>)}
          </ol></span>
          <span class="hl">from one sentence.</span></h1>
        <span class="address">Payments by <Brand id="bkash" h={18} />, Nagad and card, built in</span>
      </div>
      <div class="btn-row"><BetaButton sticker="" /><a class="btn btn-quiet" href="#demo">Try the builder</a></div>
      <p class="cta-line"><span>Free while you build</span><span>Pay when you go live</span><span>Cancel any time</span></p>
    </div>

    <figure class="qb" aria-label="Our agent building an app from one sentence, for different kinds of business (animation)">
      <div class="qb-stage">
        <div class="qb-bubble">
          <span class="qb-cap">You type</span>
          <p data-qb-text></p>
          <span class="qb-status" data-qb-status hidden><span class="spark" aria-hidden="true">✦</span> Our agent is building</span>
        </div>
        <div class="qb-phone">
          <Device kind="phone">
            <div class="notif qb-notif" data-qb-notif></div>
            <div class="phone-url"><span data-qb-url>…</span></div>
            <div class="screen" data-qb-screen></div>
          </Device>
          <span class="qb-live" data-qb-live><i></i>Live at <span class="url" data-qb-url-2></span></span>
        </div>
      </div>
    </figure>
  </div>
</section>

<Ticker items={ticker} />

<section class="band band-green demo-band has-photo fade-low" id="demo">
  <Photo id="street" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="band-head band-split" data-reveal>
      <h2 class="slogan">Try it.<br>Build one now.</h2>
      <p class="lede">Pick a kind of business, or write what you want, how you want. Then open it to customers and watch the orders come in.</p>
    </div>
    <Demo />
  </div>
</section>

<Showcase />

<ProblemScene />

<section class="band band-red has-photo">
  <Photo id="tea-stall" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap band-split">
    <h2 class="slogan" data-reveal>Your store.<br>Your money.</h2>
    <div data-reveal style="--d:1">
      <p class="lede">Customers pay into your own bKash, Nagad and card merchant accounts. We build the store and keep it running; we never hold your sales.</p>
      <a class="band-link" href="terms.html#payments-to-your-business">How payments work →</a>
    </div>
  </div>
</section>

<section class="band band-blue has-photo">
  <Photo id="cloth-shop" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="band-head" data-reveal>
      <h2 class="slogan">Less typing.<br>More orders.</h2>
      <p class="lede">Flip the switch: the same six jobs, done by your own store.</p>
    </div>
    <div data-reveal style="--d:1"><InboxVsStore /></div>
  </div>
</section>

<section class="band band-yellow has-photo fade-right">
  <Photo id="facades" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap rate-grid">
    <div data-reveal>
      <h2 class="slogan">All in.<br>No setup.</h2>
      <p class="lede">What comes with every store. Ask for changes in plain words.</p>
      <a class="band-link" href="pricing.html">See the plans →</a>
    </div>
    <ul class="rates board" data-reveal style="--d:1">
      {rates.map(([item, note, val, logos]) => <li><span class="item">{item}<small>{note}</small>{logos && <span class="rl">{logos.map((id) => <Brand id={id as any} h={18} />)}</span>}</span><span class="lead" aria-hidden="true"></span><span class="val">{val}</span></li>)}
    </ul>
  </div>
</section>

<section class="section has-photo tint">
  <Photo id="night-market" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap faq-grid">
    <div class="head" data-reveal>
      <h2>Questions owners ask first</h2>
      <p class="small">Anything else: <a href="contact.html">write to us</a>, or ask on WhatsApp.</p>
    </div>
    <div data-reveal style="--d:1"><Faq /></div>
  </div>
</section>

<section class="band band-navy has-photo fade-left">
  <Photo id="sunset" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap closing">
    <div class="signboard sign-yellow" data-reveal>
      <h2>Free to build. {tk(starter.tk)} a month to go&nbsp;live.</h2>
      <span class="address">Pilot pricing, paid by bKash</span>
    </div>
    <div data-reveal style="--d:1">
      <p class="lede">The closed beta opens to the first {facts.mvp.phases[1].output.match(/\d+/)?.[0]} businesses. Tell us what you sell and we'll set you up.</p>
      <div class="btn-row"><BetaButton label="Get my store" /><a class="btn" href="pricing.html">See the plans</a></div>
    </div>
  </div>
</section>

<style>
.hero { position: relative; padding-block: clamp(28px, 4vw, 56px) clamp(48px, 7vw, 96px); overflow: hidden; }
.hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(28px, 4vw, 64px); align-items: start; }

.hero { --h1: clamp(2.3rem, 1.4rem + 3.6vw, 4.4rem); --pad: clamp(26px, 3.4vw, 44px); }
.hero-copy .signboard h1 { font-size: var(--h1); line-height: 1; }
.hl { display: block; }
.hero-copy .btn-row { margin-top: 30px; }
.cta-line { display: flex; flex-wrap: wrap; column-gap: 0.55em; margin: 14px 0 0; font-size: 0.92rem; color: var(--ink-2); }
.cta-line span { white-space: nowrap; }
.cta-line span + span::before { content: "·"; margin-right: 0.55em; }
/* Narrow phones: the phrases wrap as a centred group, without separators left hanging */
@media (max-width: 480px) { .cta-line { column-gap: 1em; } .cta-line span + span::before { content: none; } }
/* The board's tube light comes on once, at dusk */
.lit { animation: tube 1.6s steps(1, end) .3s both; }
@keyframes tube { 0% { filter: brightness(.55); } 12% { filter: brightness(1.05); } 18% { filter: brightness(.6); } 26%, 100% { filter: none; } }

/* The window on the board: a recessed slot where the kinds of business turn like a drum */
.slot { --row: 1.08em; position: relative; display: block; height: calc(var(--row) * 2.2); margin: 0.12em -0.2em; border-radius: 6px; background: rgb(0 0 0 / .32); box-shadow: inset 0 0 0 2px var(--pin), inset 0 4px 10px rgb(0 0 0 / .45); overflow: clip; }
/* Soft edges top and bottom so the neighbours fade into the frame */
.slot::before, .slot::after { content: ""; position: absolute; left: 2px; right: 2px; height: 22%; z-index: 1; pointer-events: none; }
.slot::before { top: 2px; background: linear-gradient(rgb(6 40 26 / .85), transparent); border-radius: 4px 4px 0 0; }
.slot::after { bottom: 2px; background: linear-gradient(transparent, rgb(6 40 26 / .85)); border-radius: 0 0 4px 4px; }
.qb-reel { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; }
.qb-reel li { position: absolute; left: 0.22em; top: calc(50% - var(--row) / 2); height: var(--row); display: flex; align-items: center; white-space: nowrap; translate: 0 calc(var(--o) * var(--row) * 0.8); transition: translate .6s cubic-bezier(.3,1.2,.5,1), opacity .35s; }
.qb-reel li[data-d="far"] { opacity: 0; pointer-events: none; }
.qb-reel button { font: inherit; letter-spacing: inherit; padding: 0; border: 0; background: none; cursor: pointer; color: inherit; text-shadow: inherit; opacity: .6; scale: .48; transform-origin: left center; transition: color .3s, opacity .3s, scale .45s; }
.qb-reel li[data-d="0"] button { color: #fff; opacity: 1; scale: 1; }
.qb-reel button:hover, .qb-reel button:focus-visible { opacity: 1; }

/* Quick build: the request is a chat bubble beside the phone; its sections fly from it into the phone */
.qb { position: relative; margin: 0; display: grid; justify-items: end; }
.qb-stage { position: relative; display: grid; grid-template-columns: 210px auto; align-items: start; }
.qb-bubble { position: relative; z-index: 2; margin-top: calc(var(--pad) + var(--h1) * 2.31 - 64px); margin-right: -14px; background: var(--card); border: 1.5px solid var(--line); border-radius: 18px 18px 4px 18px; padding: 14px 18px 16px; box-shadow: 0 18px 36px -22px rgb(20 33 61 / .55); }
.qb-bubble p { font-size: 1.02rem; font-weight: 600; line-height: 1.35; margin: 4px 0 0; min-height: 4.05em; }
.qb-cap { display: block; font-size: 0.8rem; font-weight: 700; color: var(--ink-2); }
.qb-bubble .caret::after { content: "▍"; color: var(--red); animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }
.qb-status { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; font-weight: 800; font-size: 0.82rem; color: #14213d; padding: 5px 12px; border-radius: 999px; border: 2px solid transparent; background: linear-gradient(var(--yellow), var(--yellow)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; animation: aiflow 2s linear infinite; }
.qb-status[hidden] { display: none; }
.qb-status .spark { color: var(--red); }
@keyframes aiflow { to { background-position: 0 0, 300% 0; } }
.qb-phone { position: relative; z-index: 1; display: grid; justify-items: center; gap: 14px; }
.qb-live { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 0.86rem; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; opacity: 0; translate: 0 8px; transition: opacity .3s, translate .4s cubic-bezier(.2,.8,.2,1.4); }
.qb-live i { width: 8px; height: 8px; border-radius: 50%; background: var(--yellow); }
.qb-live.on { opacity: 1; translate: 0 0; }
.qb-live .url { color: var(--yellow); }
.qb :global(.qb-notif) { top: 46px; }
.qb :global(.b.qb-wait) { opacity: 0; }
.qb :global(.b.qb-fly) { animation: qb-fly .62s cubic-bezier(.2,.75,.25,1) both; }
@keyframes qb-fly { from { transform: translate(var(--dx), var(--dy)) scale(.25); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }


.head.center { margin-inline: auto; text-align: center; }
.head.center .lede { margin-inline: auto; }


.rate-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
@media (max-width: 860px) { .rate-grid { grid-template-columns: 1fr; } }
.rate-grid h2 { max-width: 12ch; }
.rl { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 6px; }
.board { background: var(--card); border-radius: 4px; padding: 10px 28px; box-shadow: inset 0 0 0 6px var(--card), inset 0 0 0 8px var(--green); }

.faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
@media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }

.closing { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
@media (max-width: 860px) { .closing { grid-template-columns: 1fr; } }
.closing .signboard h2 { font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.8rem); }

/* Tablets and phones: one centred axis. The board, the buttons and the terms line stack on it, and the
   phone sits centred below with the request bubble on its left shoulder. */
@media (max-width: 1140px) {
  .hero-grid { grid-template-columns: 1fr; justify-items: center; gap: clamp(36px, 6vw, 56px); }
  .hero-copy { width: 100%; max-width: 680px; display: grid; justify-items: center; }
  .hero-copy .signboard { width: 100%; }
  .hero-copy .btn-row { justify-content: center; }
  .cta-line { justify-content: center; text-align: center; }
  .qb { justify-items: center; }
  .qb-stage { display: block; }
  .qb-bubble { position: absolute; top: 96px; right: calc(100% - 16px); width: 220px; margin: 0; }
}
/* Too narrow for the shoulder: the bubble sits on top of the phone instead */
@media (max-width: 720px) {
  .qb-stage { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; }
  .qb-bubble { position: relative; top: auto; right: auto; width: auto; justify-self: stretch; margin: 0 0 -28px; border-radius: 18px 18px 18px 4px; }
  .qb-bubble p { min-height: 2.7em; }
}
@media (prefers-reduced-motion: reduce) { .lit, .qb-status { animation: none; } }
</style>
<script src="../scripts/hero-build.js"></script>
</Base>
