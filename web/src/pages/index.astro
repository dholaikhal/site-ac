---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import Src from "../components/Src.astro";
import Sources from "../components/Sources.astro";
import facts, { tk, plan } from "../data/facts";
import "../styles/app-screen.css";
const m = facts.market;
// Static "after" screen: the same fictional shop the demo builds.
const products: [string, number, string][] = [["Market tote", 1450, "w1"], ["Sling bag", 980, "w2"], ["Laptop sleeve", 1650, "w3"], ["Coin pouch", 350, "w4"]];
---
<Base title="Amader Cloud: describe your business, AI builds its app" description="Amader Cloud turns one sentence into a working online shop, booking page or fee collection at yourname.amader.cloud, with bKash, Nagad and card payments already set up.">

<div class="awning" aria-hidden="true"></div>
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>Describe it. <span class="paint red">AI&nbsp;builds</span> your shop.</h1>
      <p class="lede">Amader Cloud turns one sentence into a working online shop, booking page or fee collection at <span class="url">yourname.amader.cloud</span>, with bKash, Nagad and card payments already set up.</p>
      <div class="btn-row"><a class="btn btn-go" href="contact.html?topic=beta">Join the beta</a></div>
    </div>

    <figure class="before-after" aria-label="Before: a one-sentence request. After: the finished shop on a phone.">
      <div class="ba-before">
        <span class="ba-label">You type</span>
        <p class="ba-request">“A shop for my handmade bags, with bKash payment and delivery.”</p>
      </div>
      <div class="ba-arrow" aria-hidden="true">
        <svg viewBox="0 0 120 60"><path d="M6 34 C 40 6, 76 6, 104 28" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/><path d="M88 14 L108 30 L84 40" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="ba-after">
        <div class="phone">
          <div class="phone-notch" aria-hidden="true"></div>
          <div class="phone-url"><span>jutethread.amader.cloud</span></div>
          <div class="screen">
            <div class="b ink"><div class="ah"><strong>Jute &amp; Thread</strong><span class="cart">Bag · 0</span></div></div>
            <div class="b ink"><div class="hero-b"><span>Handmade jute bags</span><small>Delivery across Bangladesh</small></div></div>
            <div class="b ink"><div class="pgrid">{products.map(([n, p, w]) => <div class="pc"><div class={`sw ${w}`}></div><span>{n}</span><b>{tk(p)}</b></div>)}</div></div>
          </div>
        </div>
        <span class="ba-label after">Your shop, live</span>
      </div>
      <figcaption class="small">Illustration with a made-up shop.</figcaption>
    </figure>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <div class="head">
      <h2>Everything a shop needs comes with it.</h2>
      <p class="lede">You don't connect anything. Change it by asking, and we host it and keep it running.</p>
    </div>
    <div class="cards three">
      <div class="block red"><h3>Get paid</h3><p>Checkout by bKash, Nagad or card. The money goes to your own account.</p></div>
      <div class="block green"><h3>Deliver</h3><p>A courier is booked when you mark an order as sent.</p></div>
      <div class="block cobalt"><h3>Keep customers posted</h3><p>An SMS when the order is confirmed and when it ships.</p></div>
    </div>
  </div>
</section>

<section class="section band band-red">
  <div class="wrap split">
    <div>
      <h2>Prepaid orders come back less.</h2>
      <p class="lede">Most online orders in Bangladesh are paid in cash at the door, and many are refused when the courier arrives. A shop with its own checkout lets buyers pay first.</p>
    </div>
    <div class="why-stats">
      <div class="stat"><span class="n">{m.codShare.text}</span><span class="l">{m.codShare.label}.</span><Src id={m.codShare.source} /></div>
      <div class="stat"><span class="n">{m.codReturns.text}</span><span class="l">{m.codReturns.label}.</span><Src id={m.codReturns.source} /></div>
    </div>
  </div>
</section>

<section class="section" id="demo">
  <div class="wrap">
    <div class="head">
      <h2>Try it yourself.</h2>
      <p class="lede">Pick a business or type your own, watch the app come together, then ask for a change.</p>
    </div>
    <Demo />
  </div>
</section>

<section class="section tight band band-marigold">
  <div class="wrap split">
    <div>
      <h2>Free to build. {tk(plan("starter").tk)} a month to go live.</h2>
      <p class="lede" style="margin:0"><span class="hyp">Pilot pricing</span> Paid by bKash. <a href="pricing.html">See all plans</a></p>
    </div>
    <div class="btn-row cta-end"><a class="btn btn-go" href="contact.html?topic=beta">Join the beta</a></div>
  </div>
</section>

<div class="wrap"><Sources ids={["easysell"]} /></div>
<div style="height:40px"></div>

<style>
.hero { padding-block: clamp(36px, 6vw, 80px) clamp(48px, 7vw, 96px); }
.hero-grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
@media (max-width: 1100px) { .hero-grid { grid-template-columns: 1fr; } .before-after { max-width: 680px; } }
.hero-copy h1 { font-size: clamp(2.7rem, 1.3rem + 4.6vw, 5.3rem); }
.hero-copy .lede { max-width: 42ch; }

.before-after { margin: 0; display: grid; grid-template-columns: minmax(220px, 1fr) 64px auto; align-items: center; gap: 8px; }
.ba-before { background: var(--card); border: 2px solid var(--line); border-radius: 18px 18px 18px 4px; padding: 18px 20px; box-shadow: var(--sh); position: relative; }
.ba-request { font-family: var(--display); font-weight: 700; font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem); line-height: 1.25; letter-spacing: -0.02em; margin: 6px 0 0; }
.ba-label { display: inline-block; font-weight: 700; font-size: 0.78rem; padding: 4px 10px; border-radius: 999px; background: var(--cobalt); color: #fff; }
.ba-label.after { background: var(--green); margin-top: 14px; }
.ba-arrow { color: var(--red); }
.ba-arrow svg { width: 100%; height: auto; }
.ba-after { display: grid; justify-items: center; }
.ba-after .phone { width: 236px; }
.before-after figcaption { grid-column: 1 / -1; text-align: right; margin-top: 4px; }
@media (max-width: 620px) {
  .before-after { grid-template-columns: 1fr; justify-items: center; max-width: none; }
  .ba-before { justify-self: stretch; }
  .ba-arrow { width: 70px; transform: rotate(90deg); }
  .before-after figcaption { text-align: center; }
}

.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
@media (max-width: 820px) { .three { grid-template-columns: 1fr; } }
.block { border: 2px solid #1b1510; border-radius: var(--radius); padding: 26px 24px 22px; box-shadow: var(--sh); color: #fff; }
.block h3 { font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem); font-weight: 800; }
.block p { margin: 0; font-size: 1.05rem; }
.block.red { background: var(--red); }
.block.green { background: var(--green); }
.block.cobalt { background: var(--cobalt); }

.why-stats { display: grid; gap: 28px; grid-template-columns: 1fr 1fr; }
@media (max-width: 520px) { .why-stats { grid-template-columns: 1fr; } }
.band .stat .l { color: rgb(255 255 255 / .9); }
.cta-end { justify-content: flex-end; margin: 0; }
@media (max-width: 860px) { .cta-end { justify-content: flex-start; } }
</style>
</Base>
