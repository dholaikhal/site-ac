/* The catch-all's spin: each idea flicks in from below; the one it lands on settles with a little weight */
.qb-bar .flick { animation: flick .14s ease-out; }
@keyframes flick { from { opacity: .35; translate: 0 .35em; } }
.qb-bar.spinning p { color: var(--ink-2); }
.qb-bar .landed { animation: landed .45s cubic-bezier(.2, 1.5, .4, 1); }
@keyframes landed { from { opacity: .5; translate: 0 .5em; } }
@media (prefers-reduced-motion: reduce) { .qb-bar .flick, .qb-bar .landed { animation: none; } }
@keyframes blink { 50% { opacity: 0; } }
.qb-send { grid-area: send; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 10px; background: var(--red); color: #fff; font-weight: 800; font-size: 1.2rem; }
@keyframes capflow { to { background-position: 300% 0; } }

/* The phone, as tall as the column beside it */
.qb { position: relative; margin: 0; display: grid; align-content: start; justify-items: center; }
.qb-phone { position: relative; display: grid; justify-items: center; }
.qb { --pz: .8; }
