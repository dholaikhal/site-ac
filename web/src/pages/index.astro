---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import Ticker from "../components/Ticker.astro";
import BetaButton from "../components/BetaButton.astro";
import FixTabs from "../components/FixTabs.astro";
import StreetScene from "../components/StreetScene.astro";
import InboxVsStore from "../components/InboxVsStore.astro";
import Compare from "../components/Compare.astro";
import Faq from "../components/Faq.astro";
import facts, { tk, plan } from "../data/facts";
import "../styles/app-screen.css";
import { icon, bag } from "../scripts/app-art.js";
const m = facts.market;
const starter = plan("starter"), business = plan("business");
// Static "after" screen: the same fictional store the demo builds.
const products: [string, number, string, string, string][] = [["Market tote", 1450, "tote", "#d9b27a", "#8a4a22"], ["Sling bag", 980, "sling", "#a7b58e", "#4f5f3a"], ["Laptop sleeve", 1650, "sleeve", "#8b97ab", "#2f3b55"], ["Coin pouch", 350, "pouch", "#d4876a", "#7a2f17"]];
const rates: [string, string, string][] = [
  ["Checkout by bKash, Nagad or card", "Paid into your own merchant account", "Included"],
  ["Courier booking", "The courier charges its own delivery fee", "Included"],
  ["Your web address", "yourname.amader.cloud", "Included"],
  ["Hosting, backups and updates", "We keep it running", "Included"],
  ["Changes by asking", `On Starter; extra changes ${tk(facts.pricing.extraEditTk)} each`, `${starter.edits} a month`],
  ["SMS to your customers", "On Business", `${business.sms} a month`],
];
const ticker = ["bKash checkout", "Nagad", "Cards", "Courier booking", "Order SMS", "Bookings with deposits", "Fee receipts", "Write it your way", "Change it by asking", "yourname.amader.cloud"];
---
<Base title="Amader Cloud: describe your business, AI builds its app" description="Tell Amader Cloud what you sell in one sentence. It builds a working online store, booking page or fee collection, with bKash, Nagad and card payments already set up.">

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="signboard lit">
        <h1>Describe your store. AI builds&nbsp;it.</h1>
        <span class="address">Open at <span class="url">yourname.amader.cloud</span></span>
      </div>
      <p class="lede">Tell Amader Cloud what you sell in one sentence. It builds a working online store, booking page or fee collection, with bKash, Nagad and card payments already set up.</p>
      <div class="btn-row"><BetaButton /><a class="btn btn-quiet" href="#demo">Try the builder</a></div>
      <p class="cta-note"><span>Free while you build</span><span>Pay by bKash when you go live</span><span>Cancel any time</span></p>
    </div>

    <figure class="before-after" aria-label="Before: a one-sentence request. After: the finished store on a phone, taking a paid order.">
      <div class="ba-before">
        <span class="ba-cap">What you type</span>
        <p class="ba-request">A store for my handmade bags, with bKash payment and delivery.</p>
      </div>
      <svg class="ba-arrow" viewBox="0 0 130 100" aria-hidden="true"><path pathLength="1" d="M14 6 C 8 58, 48 84, 116 72" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><path pathLength="1" d="M98 58 L118 72 L100 88" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div class="ba-after">
        <div class="phone">
          <div class="phone-notch" aria-hidden="true"></div>
          <div class="phone-url"><span>jutethread.amader.cloud</span></div>
          <div class="screen">
            <div class="b ink" style="--s:0"><div class="ah"><span class="mark">J</span><strong>Jute &amp; Thread</strong><span class="ah-ic"><span class="ib" set:html={icon("search")}></span><span class="ib"><Fragment set:html={icon("bag")} /></span></span></div></div>
            <div class="b ink" style="--s:1"><div class="hero-b"><div><span>Handmade jute bags</span><small>Delivery across Bangladesh</small><em>Shop now</em></div><span class="hero-art" set:html={bag("tote", "#d9b27a", "#8a4a22")}></span></div></div>
            <div class="b ink" style="--s:2"><div class="cats"><span class="on">All</span><span>Totes</span><span>Slings</span><span>Sleeves</span></div></div>
            <div class="b ink" style="--s:3"><div class="pgrid">{products.map(([n, p, k, c, a], i) => <div class="pc"><div class="pimg" style={`--tint:${c}22`}><Fragment set:html={bag(k, c, a)} /><span class="fav" set:html={icon("heart")}></span>{i === 0 && <span class="new">New</span>}</div><span class="pn">{n}</span><b>{tk(p)}</b></div>)}</div></div>
          </div>
        </div>
        <ul class="pings" aria-hidden="true">
          <li style="--p:0"><span class="ico ok">✓</span>Order paid by bKash · {tk(1530)}</li>
          <li style="--p:1"><span class="ico go">⟶</span>Courier booked</li>
          <li style="--p:2"><span class="ico sms">SMS</span>Buyer told it's on the way</li>
        </ul>
        <figcaption class="ba-cap">What you get</figcaption>
      </div>
    </figure>
  </div>
</section>

<Ticker items={ticker} />

<section class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2>A Facebook page is not a store.</h2>
      <p class="lede">We add the missing pieces: checkout, delivery and order updates, so the inbox stops eating your day.</p>
    </div>
    <div data-reveal style="--d:1"><FixTabs /></div>
  </div>
</section>

<section class="section alt demo-sec" id="demo">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2>Try the builder</h2>
      <p class="lede">Pick a business, or write what you want, how you want.</p>
    </div>
    <Demo />
  </div>
</section>

<section class="scene-sec">
  <StreetScene />
  <div class="wrap">
    <div class="scene-card" data-reveal>
      <h2>Prepaid orders rarely come back.</h2>
      <p class="lede">Most online orders here are paid in cash at the door, and many are refused when the courier arrives. Your own checkout lets buyers pay first, while your Facebook page keeps bringing them in.</p>
      <div class="cod-stats">
        <div class="stat"><span class="n" data-count>{m.codShare.text}</span><span class="l">{m.codShare.label}.</span></div>
        <div class="stat"><span class="n red" data-count>{m.codReturns.text}</span><span class="l">{m.codReturns.label}.</span></div>
      </div>
    </div>
  </div>
</section>

<section class="band band-red">
  <div class="wrap band-split">
    <h2 class="slogan" data-reveal>Your store.<br>Your money.</h2>
    <div data-reveal style="--d:1">
      <p class="lede">Customers pay into your own bKash, Nagad and card merchant accounts. We build the store and keep it running; we never hold your sales.</p>
      <a class="band-link" href="terms.html#payments-to-your-business">How payments work →</a>
    </div>
  </div>
</section>

<section class="band band-blue">
  <div class="wrap">
    <div class="band-head" data-reveal>
      <h2 class="slogan">Less typing.<br>More orders.</h2>
      <p class="lede">Flip the switch: the same six jobs, done by your own store.</p>
    </div>
    <div data-reveal style="--d:1"><InboxVsStore /></div>
  </div>
</section>

<div class="awning" aria-hidden="true"></div>
<section class="section alt rates-sec">
  <div class="wrap rate-grid">
    <div data-reveal>
      <h2>What comes with every store</h2>
      <p class="lede">Nothing to set up yourself. Ask for changes in plain words.</p>
      <p class="small"><a href="pricing.html">See the plans</a></p>
    </div>
    <ul class="rates board" data-reveal style="--d:1">
      {rates.map(([item, note, val]) => <li><span class="item">{item}<small>{note}</small></span><span class="lead" aria-hidden="true"></span><span class="val">{val}</span></li>)}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2>Where else can a store go?</h2>
      <p class="lede">The usual options, side by side.</p>
    </div>
    <div data-reveal style="--d:1"><Compare /></div>
  </div>
</section>

<section class="section alt">
  <div class="wrap faq-grid">
    <div class="head" data-reveal>
      <h2>Questions owners ask first</h2>
      <p class="small">Anything else: <a href="contact.html">write to us</a>, or ask on WhatsApp.</p>
    </div>
    <div data-reveal style="--d:1"><Faq /></div>
  </div>
</section>

<section class="section">
  <div class="wrap closing">
    <div class="signboard sign-yellow" data-reveal>
      <h2>Free to build. {tk(starter.tk)} a month to go&nbsp;live.</h2>
      <span class="address">Pilot pricing, paid by bKash</span>
    </div>
    <div data-reveal style="--d:1">
      <p class="lede">The closed beta opens to the first {facts.mvp.phases[1].output.match(/\d+/)?.[0]} businesses. Tell us what you sell and we'll set you up.</p>
      <div class="btn-row"><BetaButton label="Get my store" /><a class="btn" href="pricing.html">See the plans</a></div>
    </div>
  </div>
</section>

<style>
.hero { position: relative; padding-block: clamp(28px, 4vw, 56px) clamp(48px, 7vw, 96px); overflow: hidden; }
.hero::before { content: ""; position: absolute; inset: auto -10% -30% 40%; height: 70%; background: radial-gradient(closest-side, color-mix(in srgb, var(--yellow) 26%, transparent), transparent); pointer-events: none; }
.hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
@media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } }
.hero-copy .signboard h1 { font-size: clamp(3.2rem, 1.8rem + 4.6vw, 6rem); }
.hero-copy .lede { margin-top: 26px; max-width: 46ch; }
/* The board's tube light comes on once, at dusk */
.lit { animation: tube 1.6s steps(1, end) .3s both; }
@keyframes tube { 0% { filter: brightness(.55); } 12% { filter: brightness(1.05); } 18% { filter: brightness(.6); } 26%, 100% { filter: none; } }

.before-after { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: 0 4px; align-items: start; }
.ba-before { grid-column: 1; grid-row: 1; position: relative; z-index: 1; background: var(--card); border: 1.5px solid var(--line); border-radius: 18px 18px 18px 4px; padding: 14px 18px 16px; max-width: 280px; margin-top: 28px; animation: rise .5s ease .2s both; }
.ba-request { font-size: 1.15rem; font-weight: 600; line-height: 1.35; margin: 4px 0 0; }
.ba-cap { display: block; font-size: 0.85rem; font-weight: 600; color: var(--ink-2); }
.ba-arrow { grid-column: 1; grid-row: 2; width: 130px; justify-self: end; color: var(--red); margin: 6px 6px 0 0; }
.ba-arrow path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw .7s ease .8s forwards; }
.ba-arrow path + path { animation-delay: 1.35s; animation-duration: .3s; }
@keyframes draw { to { stroke-dashoffset: 0; } }
@keyframes rise { from { opacity: 0; translate: 0 12px; } }
.ba-after { position: relative; grid-column: 2; grid-row: 1 / 3; display: grid; justify-items: center; gap: 12px; }
.ba-after .phone { width: 248px; }
.ba-after .b { animation: rise .45s ease both; animation-delay: calc(1.5s + var(--s) * .25s); }
.ba-after .ba-cap { text-align: center; max-width: 248px; }
.pings { list-style: none; margin: 0; padding: 0; position: absolute; left: -48px; bottom: 34px; display: grid; gap: 8px; z-index: 2; }
.pings li { display: flex; align-items: center; gap: 8px; width: max-content; max-width: 240px; padding: 7px 12px 7px 7px; background: #fff; color: #14213d; border: 2px solid #14213d; border-radius: 10px; font-size: 0.8rem; font-weight: 700; box-shadow: 0 10px 22px -12px rgb(0 0 0 / .45); animation: ping-in .45s cubic-bezier(.2,.8,.2,1.3) both; animation-delay: calc(2.6s + var(--p) * .7s); }
.pings li:nth-child(2) { margin-left: 18px; } .pings li:nth-child(3) { margin-left: 36px; }
.pings .ico { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 6px; color: #fff; font-size: 0.75rem; font-weight: 900; }
.pings .ok { background: var(--green); } .pings .go { background: var(--blue); } .pings .sms { background: var(--red); font-size: 0.5rem; }
@keyframes ping-in { from { opacity: 0; translate: -14px 6px; scale: .9; } }
@media (max-width: 1000px) { .before-after { max-width: 620px; } }
@media (max-width: 560px) {
  .before-after { grid-template-columns: 1fr; justify-items: center; }
  .ba-before { grid-column: 1; grid-row: 1; justify-self: stretch; max-width: none; margin: 0; }
  .ba-arrow { grid-row: 2; width: 70px; justify-self: center; transform: rotate(60deg); margin: 0; }
  .ba-after { grid-column: 1; grid-row: 3; }
  .pings { left: -10px; }
}

.head.center { margin-inline: auto; text-align: center; }
.head.center .lede { margin-inline: auto; }

.scene-sec { position: relative; }
.scene-card { position: relative; z-index: 1; margin-top: clamp(-160px, -12vw, -60px); max-width: 760px; background: var(--card); border: 1.5px solid var(--line); border-radius: 6px; padding: clamp(24px, 4vw, 44px); box-shadow: 0 30px 60px -40px rgb(20 33 61 / .5); }
.scene-card h2 { max-width: 14ch; }
.cod-stats { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); margin-top: 28px; }
.cod-stats .stat { border-left: 3px solid var(--yellow); padding-left: 20px; }
.cod-stats .n.red { color: var(--red); }
@media (max-width: 760px) { .scene-card { margin-top: -40px; } }
@media (max-width: 480px) { .cod-stats { grid-template-columns: 1fr; } }

.rates-sec { padding-top: clamp(76px, 9vw, 128px); }
.rate-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
@media (max-width: 860px) { .rate-grid { grid-template-columns: 1fr; } }
.rate-grid h2 { max-width: 12ch; }
.board { background: var(--card); border-radius: 4px; padding: 10px 28px; box-shadow: inset 0 0 0 6px var(--card), inset 0 0 0 8px var(--green); }

.faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
@media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }

.closing { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
@media (max-width: 860px) { .closing { grid-template-columns: 1fr; } }
.closing .signboard h2 { font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.8rem); }

@media (prefers-reduced-motion: reduce) { .lit, .ba-before, .ba-after .b, .pings li { animation: none; } .ba-arrow path { animation: none; stroke-dashoffset: 0; } }
</style>
</Base>
