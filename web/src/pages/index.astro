---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";
import Ticker from "../components/Ticker.astro";
import BetaButton from "../components/BetaButton.astro";
import ProblemScene from "../components/ProblemScene.astro";
import Photo from "../components/Photo.astro";
import InboxVsStore from "../components/InboxVsStore.astro";
import Faq from "../components/Faq.astro";
import facts, { tk, plan } from "../data/facts";
import "../styles/app-screen.css";
import Device from "../components/Device.astro";
import Brand from "../components/Brand.astro";
const m = facts.market;
const starter = plan("starter"), business = plan("business");
const rates: [string, string, string, string[]?][] = [
  ["Checkout by bKash, Nagad or card", "Paid into your own merchant account", "Included", ["bkash", "nagad", "visa", "mastercard"]],
  ["Courier booking", "The courier charges its own delivery fee", "Included", ["pathao", "steadfast", "redx"]],
  ["Your web address", "yourname.amader.cloud", "Included"],
  ["Hosting, backups and updates", "We keep it running", "Included"],
  ["Changes by asking", `On Starter; extra changes ${tk(facts.pricing.extraEditTk)} each`, `${starter.edits} a month`],
  ["SMS to your customers", "On Business", `${business.sms} a month`],
];
const ticker = ["bKash checkout", "Nagad", "Cards", "Courier booking", "Order SMS", "Bookings with deposits", "Fee receipts", "Write it your way", "Change it by asking", "yourname.amader.cloud"];
---
<Base title="Amader Cloud: describe your business, our agent builds its app" description="Tell Amader Cloud what you sell in one sentence. It builds a working online store, booking page or fee collection, with bKash, Nagad and card payments already set up.">

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="signboard lit">
        <h1>Describe your business. Our agent builds&nbsp;it.</h1>
        <span class="address">Open at <span class="url">yourname.amader.cloud</span></span>
      </div>
      <p class="lede">Say what you need in one sentence. Our agent builds the app, with bKash, Nagad and card payments already set up.</p>
      <div class="btn-row"><BetaButton /><a class="btn btn-quiet" href="#demo">Try the builder</a></div>
      <p class="cta-note"><span>Free while you build</span><span>Pay by <Brand id="bkash" h={16} /> when you go live</span><span>Cancel any time</span></p>
    </div>

    <figure class="qb" data-qb aria-label="Our agent building an app from one sentence, for different kinds of business (animation)">
      <p class="qb-q">Do you want an app for your <b data-qb-type>Facebook store</b>?</p>
      <div class="qb-types" role="group" aria-label="Kind of business">
        {[["Facebook store", "Facebook store"], ["Home kitchen", "home kitchen"], ["Salon", "salon"], ["Clinic", "clinic"], ["Pharmacy", "pharmacy"], ["Event tickets", "event"], ["AC servicing", "AC servicing team"], ["Coaching centre", "coaching centre"]].map(([label, word], i) =>
          <button type="button" data-qb-pick={i} data-word={word} aria-pressed={i === 0 ? "true" : "false"}>{label}</button>)}
      </div>
      <div class="qb-side">
        <div class="qb-prompt"><span class="qb-cap">You type</span><p data-qb-text></p></div>
        <div class="qb-status" data-qb-status hidden><span class="spark" aria-hidden="true">✦</span> Our agent is building</div>
      </div>
      <div class="qb-phone">
        <Device kind="phone">
          <div class="notif qb-notif" data-qb-notif></div>
          <div class="phone-url"><span data-qb-url>…</span></div>
          <div class="screen" data-qb-screen></div>
        </Device>
        <span class="qb-live" data-qb-live><i></i>Live at <span class="url" data-qb-url-2></span></span>
      </div>
    </figure>
  </div>
</section>

<Ticker items={ticker} />

<section class="band band-green demo-band has-photo fade-low" id="demo">
  <Photo id="street" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="band-head band-split" data-reveal>
      <h2 class="slogan">Try it.<br>Build one now.</h2>
      <p class="lede">Pick a kind of business, or write what you want, how you want. Then open it to customers and watch the orders come in.</p>
    </div>
    <Demo />
  </div>
</section>

<ProblemScene />

<section class="band band-red has-photo">
  <Photo id="tea-stall" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap band-split">
    <h2 class="slogan" data-reveal>Your store.<br>Your money.</h2>
    <div data-reveal style="--d:1">
      <p class="lede">Customers pay into your own bKash, Nagad and card merchant accounts. We build the store and keep it running; we never hold your sales.</p>
      <a class="band-link" href="terms.html#payments-to-your-business">How payments work →</a>
    </div>
  </div>
</section>

<section class="band band-blue has-photo">
  <Photo id="cloth-shop" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="band-head" data-reveal>
      <h2 class="slogan">Less typing.<br>More orders.</h2>
      <p class="lede">Flip the switch: the same six jobs, done by your own store.</p>
    </div>
    <div data-reveal style="--d:1"><InboxVsStore /></div>
  </div>
</section>

<section class="band band-yellow has-photo fade-right">
  <Photo id="facades" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap rate-grid">
    <div data-reveal>
      <h2 class="slogan">All in.<br>No setup.</h2>
      <p class="lede">What comes with every store. Ask for changes in plain words.</p>
      <a class="band-link" href="pricing.html">See the plans →</a>
    </div>
    <ul class="rates board" data-reveal style="--d:1">
      {rates.map(([item, note, val, logos]) => <li><span class="item">{item}<small>{note}</small>{logos && <span class="rl">{logos.map((id) => <Brand id={id as any} h={18} />)}</span>}</span><span class="lead" aria-hidden="true"></span><span class="val">{val}</span></li>)}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap faq-grid">
    <div class="head" data-reveal>
      <h2>Questions owners ask first</h2>
      <p class="small">Anything else: <a href="contact.html">write to us</a>, or ask on WhatsApp.</p>
    </div>
    <div data-reveal style="--d:1"><Faq /></div>
  </div>
</section>

<section class="band band-navy has-photo fade-left">
  <Photo id="sunset" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap closing">
    <div class="signboard sign-yellow" data-reveal>
      <h2>Free to build. {tk(starter.tk)} a month to go&nbsp;live.</h2>
      <span class="address">Pilot pricing, paid by bKash</span>
    </div>
    <div data-reveal style="--d:1">
      <p class="lede">The closed beta opens to the first {facts.mvp.phases[1].output.match(/\d+/)?.[0]} businesses. Tell us what you sell and we'll set you up.</p>
      <div class="btn-row"><BetaButton label="Get my store" /><a class="btn" href="pricing.html">See the plans</a></div>
    </div>
  </div>
</section>

<style>
.hero { position: relative; padding-block: clamp(28px, 4vw, 56px) clamp(48px, 7vw, 96px); overflow: hidden; }
.hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
@media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } }
.hero-copy .signboard h1 { font-size: clamp(3.2rem, 1.8rem + 4.6vw, 6rem); }
.hero-copy .lede { margin-top: 26px; max-width: 46ch; }
/* The board's tube light comes on once, at dusk */
.lit { animation: tube 1.6s steps(1, end) .3s both; }
@keyframes tube { 0% { filter: brightness(.55); } 12% { filter: brightness(1.05); } 18% { filter: brightness(.6); } 26%, 100% { filter: none; } }

/* Quick build: the request types, sections fly into the phone, confetti when it's live */
.qb { position: relative; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 20px; align-items: center; }
.qb-q { grid-column: 1 / -1; margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem); line-height: 1.05; }
.qb-q b { color: var(--red); display: inline-block; }
.qb-q b.swap { animation: swap .45s cubic-bezier(.2,.8,.2,1.3); }
@keyframes swap { from { opacity: 0; translate: 0 .4em; } }
.qb-types { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; }
.qb-types button { font: inherit; font-size: 0.84rem; font-weight: 700; padding: 5px 12px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--card); color: var(--ink); cursor: pointer; }
.qb-types button[aria-pressed="true"] { background: var(--ink); color: var(--wash); }
.qb-side { display: grid; gap: 12px; align-self: start; margin-top: 40px; }
.qb-prompt { position: relative; z-index: 1; background: var(--card); border: 1.5px solid var(--line); border-radius: 18px 18px 4px 18px; padding: 14px 18px 16px; box-shadow: 0 16px 30px -22px rgb(20 33 61 / .5); }
.qb-prompt p { font-size: 1.12rem; font-weight: 600; line-height: 1.35; margin: 4px 0 0; min-height: 3.1em; }
.qb-cap { display: block; font-size: 0.85rem; font-weight: 600; color: var(--ink-2); }
.qb-prompt .caret::after { content: "▍"; color: var(--red); animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }
.qb-status { justify-self: start; display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 0.9rem; color: #14213d; padding: 7px 14px; border-radius: 999px; border: 2px solid transparent; background: linear-gradient(var(--yellow), var(--yellow)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; animation: aiflow 2s linear infinite; }
.qb-status .spark { color: var(--red); }
@keyframes aiflow { to { background-position: 0 0, 300% 0; } }
.qb-phone { display: grid; justify-items: center; gap: 12px; }
.qb-live { display: inline-flex; align-items: center; gap: 8px; font-weight: 800; font-size: 0.86rem; padding: 6px 14px; border-radius: 999px; background: var(--green); color: #fff; opacity: 0; translate: 0 8px; transition: opacity .3s, translate .4s cubic-bezier(.2,.8,.2,1.4); }
.qb-live i { width: 8px; height: 8px; border-radius: 50%; background: var(--yellow); }
.qb-live.on { opacity: 1; translate: 0 0; }
.qb-live .url { color: var(--yellow); }
.qb :global(.qb-notif) { top: 46px; }
.qb :global(.b.qb-wait) { opacity: 0; }
.qb :global(.b.qb-fly) { animation: qb-fly .62s cubic-bezier(.2,.75,.25,1) both; }
@keyframes qb-fly { from { transform: translate(var(--dx), var(--dy)) scale(.25); opacity: 0; } 30% { opacity: 1; } to { transform: none; opacity: 1; } }
@media (max-width: 1000px) { .qb { max-width: 620px; } }
@media (max-width: 560px) { .qb { grid-template-columns: 1fr; justify-items: center; } .qb-side { margin-top: 0; justify-self: stretch; } }

.head.center { margin-inline: auto; text-align: center; }
.head.center .lede { margin-inline: auto; }


.rate-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
@media (max-width: 860px) { .rate-grid { grid-template-columns: 1fr; } }
.rate-grid h2 { max-width: 12ch; }
.rl { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 6px; }
.board { background: var(--card); border-radius: 4px; padding: 10px 28px; box-shadow: inset 0 0 0 6px var(--card), inset 0 0 0 8px var(--green); }

.faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
@media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }

.closing { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
@media (max-width: 860px) { .closing { grid-template-columns: 1fr; } }
.closing .signboard h2 { font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.8rem); }

@media (prefers-reduced-motion: reduce) { .lit, .qb-status { animation: none; } }
</style>
<script src="../scripts/hero-build.js"></script>
</Base>
