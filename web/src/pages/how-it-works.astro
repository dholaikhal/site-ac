---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { plan } from "../data/facts";
import Connectors from "../components/Connectors.astro";
// Who does each step. Agent steps glow on the track. Copy rule: "our agent", never "AI", a model or a provider.
const steps = [
  { t: "Describe it", d: "Write what you want, how you want. “A store for my handmade bags with bKash payment and an SMS when the order ships.”", who: "you" },
  { t: "Our agent builds it", d: "Our store agent plans your app, lays out the pages, adds your products or services, and connects payments, courier and SMS. Minutes, not weeks.", who: "ai" },
  { t: "Try it", d: "A preview on your phone, with test payments, before anything is public. Look around, place a test order, read the SMS.", who: "you" },
  { t: "Change it by asking", d: "“Add 10% off for bKash payments.” “Make it green.” Our agent makes the change, you see it first, and any change can be undone.", who: "ai" },
  { t: "Our agent checks it", d: "Before it goes live, and while it runs, every app is checked for scams, fake bank or wallet pages and prohibited goods.", who: "ai" },
  { t: "Get paid", d: "Live at yourname.amader.cloud. Customers pay into your own merchant accounts; we never hold your money.", who: "you" },
];
const run = [
  ["Hosting", "Your app runs on our servers at yourname.amader.cloud. Nothing to install."],
  ["Database and backups", "Orders, customers and payments are stored and backed up for you."],
  ["Security updates", "We keep the stack, libraries and certificates up to date."],
  ["Connectors", "When a payment, courier or SMS provider changes its system, we update the connector, not you."],
  ["Safety review", "Every published app is checked by our agent and by rules, before publishing and continuously."],
  ["Support", "Ask “Why didn't my bKash payment show?” and our agent looks it up in your store's records. People answer on WhatsApp too."],
];
---
<Base title="How it works · Amader Cloud" description="Describe, build, preview, change by asking, publish, get paid. What our agent does at each step, and what we run for you.">

<section class="page-hero">
  <div class="wrap">
    <div class="signboard sign-blue">
      <h1>From a sentence to a working app.</h1>
      <span class="address">Six steps. Our agent does three of them.</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="flow" data-tabs data-auto>
      <p class="legend"><span class="ai-dot" aria-hidden="true">✦</span> Our cloud agent does the glowing steps. You do the rest.</p>
      <ol class="track" role="tablist" aria-label="Steps">
        {steps.map((s, i) => (
          <li class:list={["station", s.who]}>
            <button type="button" role="tab" id={`st-${i}`} aria-controls={`sp-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
              <span class="disc">{s.who === "ai" ? "✦" : i + 1}</span>
              <span class="name">{s.t}</span>
              <span class="tag">{s.who === "ai" ? "Our agent" : "You"}</span>
            </button>
          </li>
        ))}
      </ol>
      {steps.map((s, i) => (
        <div class:list={["stop", s.who]} role="tabpanel" id={`sp-${i}`} aria-labelledby={`st-${i}`} hidden={i !== 0}>
          <span class="stop-n">Step {i + 1} of {steps.length}{s.who === "ai" ? " · done by our agent" : ""}</span>
          <h2>{s.t}</h2>
          <p class="lede">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div>
      <h2>Built from parts that already work.</h2>
      <p class="lede">Our agent doesn't start from a blank page. It puts your app together from pieces we've already tested.</p>
      <ul class="ticks">
        <li><strong>Tested building blocks:</strong> product grids, calendars, checkouts and receipts that already work.</li>
        <li><strong>Ready connections:</strong> bKash, Nagad, cards, couriers and SMS are plugged in, not written from scratch.</li>
        <li><strong>Every change is checked</strong> and shown to you before it goes live, and can be undone in one click.</li>
      </ul>
    </div>
    <div class="rails" aria-hidden="true">
      <div class="rail ai"><span>✦</span> Our agent puts it together</div>
      <div class="rail-row"><div class="rail">Tested building blocks</div><div class="rail">Ready connections</div></div>
      <div class="rail">Checked, previewed, undoable</div>
      <div class="rail out">Your store</div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <div class="head">
      <h2>Connected from day one.</h2>
      <p class="lede">Tested connectors for the services your customers already use.</p>
    </div>
    <Connectors />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="run-head">
      <div>
        <h2>You run the business. We run the app.</h2>
        <p class="lede">Everything behind your store's address is ours to keep working.</p>
      </div>
      <Photo id="night-market" class="run-photo" sizes="(max-width: 860px) 100vw, 50vw" />
    </div>
    <div class="cards">
      {run.map(([t, d]) => <div class="card"><h3>{t}</h3><p>{d}</p></div>)}
    </div>
  </div>
</section>

<section class="section ink-band" id="agencies">
  <div class="wrap split">
    <div>
      <h2>Deliver client apps in a day.</h2>
      <p class="lede">The agency plan covers {plan("agency").apps} client apps and their hosting.</p>
      <div class="btn-row"><a class="btn btn-go" href="contact.html?topic=agency">Agency enquiry</a><a class="btn" href="pricing.html">See the agency plan</a></div>
    </div>
    <div class="card agency-card">
      <h3>A client job, start to finish</h3>
      <ol class="aw">
        <li>Client brief in a sentence or two</li>
        <li>First build and preview the same day</li>
        <li>Client asks for changes; you, or they, ask our agent</li>
        <li>Publish on the client's subdomain or own domain</li>
        <li>Payments go to the client's own accounts</li>
      </ol>
    </div>
  </div>
</section>

<style>
.run-head { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: end; margin-bottom: clamp(26px, 4vw, 44px); }
:global(.run-photo) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
@media (max-width: 860px) { .run-head { grid-template-columns: 1fr; } }
.legend { display: flex; align-items: center; gap: 10px; font-weight: 700; margin: 0 0 22px; }
.ai-dot { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; color: #fff; background: conic-gradient(var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)); animation: spin-ai 4s linear infinite; }
@keyframes spin-ai { to { rotate: 360deg; } }
/* The track: six stations on a line; a token rides the line, and agent stations run with colour */
.track { list-style: none; margin: 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
.track::before { content: ""; position: absolute; left: 8%; right: 8%; top: 31px; height: 4px; background: repeating-linear-gradient(90deg, var(--line) 0 10px, transparent 10px 18px); animation: flow-line 1.2s linear infinite; }
@keyframes flow-line { to { background-position: 18px 0; } }
.station button { position: relative; width: 100%; display: grid; justify-items: center; gap: 8px; padding: 0 4px 10px; font: inherit; color: var(--ink); background: none; border: 0; cursor: pointer; text-align: center; }
.disc { position: relative; z-index: 1; display: grid; place-items: center; width: 66px; height: 66px; border-radius: 50%; background: var(--card); border: 3px solid var(--line); font-family: var(--display); font-weight: 900; font-size: 1.7rem; transition: scale .25s, background-color .25s; }
.station.ai .disc { border-color: transparent; background: linear-gradient(var(--card), var(--card)) padding-box, conic-gradient(from var(--a, 0deg), var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) border-box; color: var(--red); animation: ring 3s linear infinite; }
@property --a { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
@keyframes ring { to { --a: 360deg; } }
.station.ai .disc::after { content: ""; position: absolute; inset: -10px; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--yellow) 55%, transparent), transparent); z-index: -1; animation: glow 2.4s ease-in-out infinite; }
@keyframes glow { 50% { opacity: .35; scale: .85; } }
.name { font-weight: 700; font-size: 0.98rem; line-height: 1.2; }
.station .tag { font-size: 0.72rem; color: var(--ink-2); }
.station.ai .tag { color: var(--red); }
.station button[aria-selected="true"] .disc { scale: 1.12; background-color: var(--yellow); }
.station.you button[aria-selected="true"] .disc { background: var(--yellow); color: #14213d; }
.station.ai button[aria-selected="true"] .disc { background: linear-gradient(var(--yellow), var(--yellow)) padding-box, conic-gradient(from var(--a, 0deg), var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) border-box; color: #14213d; }
.station button[aria-selected="true"] .name { text-decoration: underline; text-decoration-color: var(--red); text-decoration-thickness: 3px; text-underline-offset: 5px; }
.stop { margin-top: 26px; padding: clamp(22px, 3vw, 34px); border: 2px solid var(--line); border-radius: 8px; background: var(--card); max-width: 860px; margin-inline: auto; text-align: center; animation: panel-in .35s ease; }
.stop.ai { border-color: transparent; background: linear-gradient(var(--card), var(--card)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; animation: panel-in .35s ease, aiflow-b 3s linear infinite; }
@keyframes aiflow-b { to { background-position: 0 0, 300% 0; } }
@keyframes panel-in { from { opacity: 0; translate: 0 8px; } }
.stop-n { font-weight: 700; font-size: 0.85rem; color: var(--ink-2); }
.stop.ai .stop-n { color: var(--red); }
.stop h2 { margin: 6px 0 10px; }
.stop .lede { margin: 0 auto; }
.flow-bar { height: 3px; }
@media (max-width: 760px) {
  .track { grid-template-columns: 1fr; gap: 4px; }
  .track::before { left: 31px; right: auto; top: 10px; bottom: 10px; width: 4px; height: auto; background: repeating-linear-gradient(180deg, var(--line) 0 10px, transparent 10px 18px); }
  .station button { grid-template-columns: 66px 1fr auto; justify-items: start; align-items: center; text-align: left; gap: 14px; padding: 4px 0; }
  .stop { text-align: left; }
}
@media (prefers-reduced-motion: reduce) { .track::before, .station.ai .disc, .station.ai .disc::after, .ai-dot, .stop.ai { animation: none; } }
.rails { display: grid; gap: 10px; }
.rail-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.rail { border: 2px solid var(--line); border-radius: 12px; padding: 16px; text-align: center; font-family: var(--display); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.01em; background: var(--card); }
.rail.ai { color: #fff; border-color: transparent; background: linear-gradient(var(--blue), var(--blue)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; border-width: 3px; animation: aiflow-b 3s linear infinite; }
.rail.ai span { color: var(--yellow); }
.rail.out { background: var(--red); color: #fff; border-color: #14213d; justify-self: center; padding-inline: 40px; border-radius: 999px; }
.aw { margin: 8px 0 0; padding-left: 20px; display: grid; gap: 8px; }
#agencies .agency-card { color: #14213d; background: var(--yellow); border-color: var(--yellow); }
</style>
</Base>
