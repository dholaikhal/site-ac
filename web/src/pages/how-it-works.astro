---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { plan } from "../data/facts";
import Connectors from "../components/Connectors.astro";
import Assemble from "../components/Assemble.astro";
import { icon } from "../scripts/app-art.js";
// Who does each step. Agent steps glow in the chain. Copy rule: "our agent", never "AI", a model or a provider.
const steps = [
  { t: "You describe it", who: "you" },
  { t: "Our agent builds it", who: "ai" },
  { t: "You try it", who: "you" },
  { t: "You ask, our agent changes it", who: "ai" },
  { t: "Our agent checks it", who: "ai" },
  { t: "You get paid", who: "you" },
];
const run = [
  ["Hosting", "Your app runs on our servers at yourname.amader.cloud. Nothing to install."],
  ["Database and backups", "Orders, customers and payments are stored and backed up for you."],
  ["Security updates", "We keep the stack, libraries and certificates up to date."],
  ["Connectors", "When a payment, courier or SMS provider changes its system, we update the connector, not you."],
  ["Safety review", "Every published app is checked by our agent and by rules, before publishing and continuously."],
  ["Support", "Ask “Why didn't my bKash payment show?” and our agent looks it up in your store's records. People answer on WhatsApp too."],
];
---
<Base title="How it works · Amader Cloud" description="Describe, build, preview, change by asking, publish, get paid. What our agent does at each step, and what we run for you.">

<section class="page-hero band band-green has-photo">
  <Photo id="street" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="signboard sign-blue">
      <h1>From a sentence to a working app.</h1>
      <span class="address">Six steps. Our agent does three of them.</span>
    </div>
  </div>
</section>

<section class="section has-photo tint">
  <Photo id="night-market" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="flow">
      <p class="legend"><span class="ai-dot" aria-hidden="true">✦</span> Our cloud agent does the glowing steps. You do the rest.</p>
      <ol class="chain" aria-label="Steps">
        {steps.map((s, i) => (
          <li class:list={["link", s.who]} style={`--i:${i}`}><span class="pill">{s.who === "ai" && <span class="spark" aria-hidden="true">✦</span>}{s.t}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="band band-navy parts-band">
  <div class="wrap">
    <header class="parts-head" data-reveal>
      <h2 class="slogan">Built from parts that already work.</h2>
      <p class="lede">Our agent doesn't start from a blank page. It puts your app together from blocks we've already built and tested.</p>
    </header>
    <Assemble />
    <ul class="parts-points">
      <li data-reveal><span class="pi" set:html={icon("box")} /><strong>Tested building blocks</strong><span>Product grids, calendars, checkouts and receipts that already work.</span></li>
      <li data-reveal style="--d:1"><span class="pi" set:html={icon("route")} /><strong>Ready connections</strong><span>bKash, Nagad, cards, couriers and SMS are plugged in, not written from scratch.</span></li>
      <li data-reveal style="--d:2"><span class="pi" set:html={icon("shield")} /><strong>Every change checked</strong><span>Shown to you before it goes live, and undone in one click.</span></li>
    </ul>
  </div>
</section>

<section class="band band-yellow">
  <div class="wrap">
    <div class="head">
      <h2>Connected from day one.</h2>
      <p class="lede">Tested connectors for the services your customers already use.</p>
    </div>
    <Connectors />
  </div>
</section>

<section class="section has-photo tint">
  <Photo id="rooftops" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="run-head">
      <div>
        <h2>You run the business. We run the app.</h2>
        <p class="lede">Everything behind your store's address is ours to keep working.</p>
      </div>
      <Photo id="night-market" class="run-photo" sizes="(max-width: 860px) 100vw, 50vw" />
    </div>
    <div class="cards">
      {run.map(([t, d]) => <div class="card"><h3>{t}</h3><p>{d}</p></div>)}
    </div>
  </div>
</section>

<section class="section ink-band has-photo fade-right" id="agencies">
  <Photo id="office" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />

  <div class="wrap split">
    <div>
      <h2>Deliver client apps in a day.</h2>
      <p class="lede">The agency plan covers {plan("agency").apps} client apps and their hosting.</p>
      <div class="btn-row"><a class="btn btn-go" href="contact.html?topic=agency">Agency enquiry</a><a class="btn" href="pricing.html">See the agency plan</a></div>
    </div>
    <div class="card agency-card">
      <h3>A client job, start to finish</h3>
      <ol class="aw">
        <li>Client brief in a sentence or two</li>
        <li>First build and preview the same day</li>
        <li>Client asks for changes; you, or they, ask our agent</li>
        <li>Publish on the client's subdomain or own domain</li>
        <li>Payments go to the client's own accounts</li>
      </ol>
    </div>
  </div>
</section>

<style>
.run-head { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 56px); align-items: end; margin-bottom: clamp(26px, 4vw, 44px); }
:global(.run-photo) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
@media (max-width: 860px) { .run-head { grid-template-columns: 1fr; } }
.legend { display: flex; align-items: center; gap: 10px; font-weight: 700; margin: 0 0 22px; }
.ai-dot { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; color: #fff; background: conic-gradient(var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)); animation: spin-ai 4s linear infinite; }
@keyframes spin-ai { to { rotate: 360deg; } }
/* The chain: six steps as buttons joined by arrows; a light runs along it, and the agent's steps glow */
.flow { display: grid; justify-items: center; gap: 22px; }
.chain { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 0; max-width: 1100px; }
.link { display: flex; align-items: center; }
.link + .link::before { content: "→"; margin: 0 12px; font-weight: 900; font-size: 1.5rem; color: var(--red); animation: nudge 1.4s ease-in-out infinite; animation-delay: calc(var(--i) * .15s); }
@keyframes nudge { 50% { translate: 4px 0; } }
@keyframes aiflow-b { to { background-position: 0 0, 300% 0; } }
.pill { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 999px; font-weight: 800; font-size: 1.05rem; background: var(--card); border: 2px solid var(--line); color: var(--ink); white-space: nowrap; animation: lit 9s ease-in-out infinite; animation-delay: calc(var(--i) * 1.5s - 9s); }
.link.ai .pill { border-color: transparent; background: linear-gradient(var(--card), var(--card)) padding-box, linear-gradient(90deg, var(--yellow), var(--red), var(--blue), var(--green), var(--yellow)) 0 0 / 300% 100% border-box; animation: lit 9s ease-in-out infinite, aiflow-b 3s linear infinite; animation-delay: calc(var(--i) * 1.5s - 9s), 0s; }
.pill .spark { color: var(--red); }
@keyframes lit { 0%, 18%, 100% { scale: 1; box-shadow: none; } 6%, 12% { scale: 1.08; box-shadow: 0 10px 24px -10px rgb(20 33 61 / .45); } }
@media (max-width: 700px) { .chain { flex-direction: column; } .link + .link::before { content: "↓"; margin: 6px 0; } .link { flex-direction: column; } }
@media (prefers-reduced-motion: reduce) { .pill, .link + .link::before, .ai-dot { animation: none !important; } }
.aw { margin: 8px 0 0; padding-left: 20px; display: grid; gap: 8px; }
#agencies .agency-card { color: #14213d; background: var(--yellow); border-color: var(--yellow); }
</style>
</Base>
