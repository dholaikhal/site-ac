---
import Base from "../layouts/Base.astro";
import { plan } from "../data/facts";
import Connectors from "../components/Connectors.astro";
const steps = [
  { n: "01", t: "Describe it", d: "Type or say what you need, in Bangla, Banglish or English. “A shop for my handmade bags with bKash payment and an SMS when the order ships.”", m: "you" },
  { n: "02", t: "AI builds it", d: "Coding agents plan the app, set up its data, assemble pages from a tested component library, wire in the payment, courier and SMS connectors, and run the tests.", m: "Claude Opus 5.5" },
  { n: "03", t: "Preview it", d: "A live preview on your phone, with test payments, before anything is public. Look around, place a test order, read the SMS.", m: "sandbox" },
  { n: "04", t: "Change it by asking", d: "“Add 10% off for bKash payments.” “Make the menu green.” Every change is previewed and tested, and can be rolled back in one click.", m: "Claude Sonnet 5.5" },
  { n: "05", t: "Publish", d: "One click puts it live at yourname.amader.cloud, or on your own domain. Every app is checked for scams and impersonation first.", m: "Claude Haiku 4.5 + rules" },
  { n: "06", t: "Get paid", d: "Payments go straight to your own merchant accounts through a licensed payment partner. We help with the gateway paperwork; we never hold your money.", m: "your account" },
];
const run = [
  ["Hosting", "Your app runs on our servers at yourname.amader.cloud. Nothing to install."],
  ["Database and backups", "Orders, customers and payments are stored and backed up for you."],
  ["Security updates", "We keep the stack, libraries and certificates up to date."],
  ["Connectors", "When a payment, courier or SMS provider changes its system, we update the connector, not you."],
  ["Safety review", "Every published app is checked by AI and rules, before publishing and continuously."],
  ["Support", "An AI support agent that reads your app's own logs: “Why didn't my bKash payment show?”"],
];
---
<Base title="How it works · Amader Cloud" description="Describe, build, preview, change by asking, publish, get paid. What the AI does at each step, and what we run for you.">

<section class="page-hero band band-cobalt">
  <div class="wrap">
    <p class="kicker">How it works</p>
    <h1>From a sentence to a working app.</h1>
    <p class="lede">Six steps. You do the first one; the AI and our team handle the rest, and keep handling it after you go live.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <ol class="steps-bp">
      {steps.map((s) => (
        <li>
          <span class="n">{s.n}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <span class="who">{s.m}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div>
      <p class="kicker">Why it doesn't break</p>
      <h2>The AI builds on rails.</h2>
      <p class="lede">Generated code is reliable when it is constrained. So the agents don't start from a blank page.</p>
      <ul class="ticks">
        <li><strong>One fixed stack:</strong> a TypeScript web app with a managed database, the same for every app.</li>
        <li><strong>A tested component library:</strong> product grids, calendars, checkouts and receipts that already work.</li>
        <li><strong>Pre-built connectors:</strong> the AI wires in payments, couriers and SMS; it never writes payment code from scratch.</li>
        <li><strong>Tests on every change,</strong> a preview before publishing, and one-click rollback.</li>
      </ul>
    </div>
    <div class="rails" aria-hidden="true">
      <div class="rail ai">AI agents plan, assemble, wire and test</div>
      <div class="rail-row"><div class="rail">Tested components</div><div class="rail">Local connectors</div></div>
      <div class="rail">One fixed stack, tests, rollback</div>
      <div class="rail out">Your app</div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <div class="head">
      <h2>Connected from day one.</h2>
      <p class="lede">The AI doesn't write payment code from scratch. It wires in tested connectors for the services Bangladeshi customers already use.</p>
    </div>
    <Connectors />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="head">
      <p class="kicker">What we run for you</p>
      <h2>You run the business. We run the app.</h2>
    </div>
    <div class="cards">
      {run.map(([t, d]) => <div class="card"><h3>{t}</h3><p>{d}</p></div>)}
    </div>
  </div>
</section>

<section class="section band band-ink" id="agencies">
  <div class="wrap split">
    <div>
      <p class="kicker">For agencies and freelancers</p>
      <h2>Deliver client apps in a day.</h2>
      <p class="lede">Build on the same rails for your clients: describe, refine, hand over. The agency plan covers {plan("agency").apps} client apps and their hosting, so you stop babysitting servers and spend your time on the client.</p>
      <div class="btn-row"><a class="btn btn-go" href="contact.html?topic=agency">Agency enquiry</a><a class="btn" href="pricing.html">See the agency plan</a></div>
    </div>
    <div class="card tint">
      <span class="plate">Agency workflow</span>
      <ol class="aw">
        <li>Client brief in a sentence or two</li>
        <li>First build and preview the same day</li>
        <li>Client asks for changes; you, or they, ask the AI</li>
        <li>Publish on the client's subdomain or own domain</li>
        <li>Payments go to the client's own accounts</li>
      </ol>
    </div>
  </div>
</section>

<style>
.steps-bp { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
@media (max-width: 900px) { .steps-bp { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 580px) { .steps-bp { grid-template-columns: 1fr; } }
.steps-bp li { position: relative; background: var(--card); border: 2px solid var(--line); border-radius: var(--radius); padding: 22px; display: grid; align-content: start; gap: 4px; box-shadow: var(--sh); }
.steps-bp li:nth-child(3n+1) .n { background: var(--red); }
.steps-bp li:nth-child(3n+2) .n { background: var(--green); }
.steps-bp li:nth-child(3n) .n { background: var(--cobalt); }
.steps-bp .n { justify-self: start; font-family: var(--display); font-weight: 800; font-size: 1.1rem; color: #fff; border: 2px solid #1b1510; border-radius: 10px; padding: 2px 10px; }
.steps-bp h3 { margin: 8px 0 4px; font-size: 1.55rem; }
.steps-bp p { margin: 0 0 10px; color: var(--ink-2); }
.steps-bp .who { justify-self: start; font-weight: 700; font-size: 0.78rem; border-radius: 999px; padding: 3px 9px; background: var(--marigold); color: #1b1510; }
.rails { display: grid; gap: 10px; }
.rail-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.rail { border: 2px solid var(--line); border-radius: 12px; padding: 16px; text-align: center; font-family: var(--display); font-weight: 800; font-size: 1.1rem; letter-spacing: -0.01em; background: var(--card); }
.rail.ai { background: var(--cobalt); color: #fff; border-color: #1b1510; }
.rail.out { background: var(--red); color: #fff; border-color: #1b1510; justify-self: center; padding-inline: 40px; border-radius: 999px; box-shadow: var(--sh); }
.aw { margin: 8px 0 0; padding-left: 20px; display: grid; gap: 8px; }
#agencies .card { color: #1b1510; background: var(--marigold); border-color: #1b1510; box-shadow: 5px 5px 0 #000; }
#agencies .plate { background: #fff; border-color: #1b1510; color: #1b1510; }
</style>
</Base>
