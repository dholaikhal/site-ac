---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Amader Cloud" description="This page doesn't exist." noindex>
<section class="page-hero band band-marigold" style="min-height:60vh">
  <div class="wrap">
    <p class="kicker">404</p>
    <h1>Nothing has been built here yet.</h1>
    <p class="lede">The page you asked for doesn't exist. If you were looking for someone's app on amader.cloud, check the name in the link.</p>
    <div class="btn-row"><a class="btn btn-go" href="./">Go home</a><a class="btn" href="./#demo">Try the demo</a></div>
  </div>
</section>
</Base>
