---
import Base from "../layouts/Base.astro";
import SceneHead from "../components/SceneHead.astro";
import F from "../data/facts.json";
---
<Base title="Contact: amader.cloud" description="Book a visit to check your devices, ask about a building, shop or school, or arrange a collection in Dhaka.">
<section class="page-head photo">
<SceneHead id="street" />
  <div class="wrap">
    <h1>Tell us what you have.</h1>
    <p class="lede">We reply within one working day on WhatsApp or by email. Building visits and device checks are free during the pilot.</p>
  </div>
</section>

<section class="wrap" style="padding-bottom:clamp(56px,8vw,112px)">
  <div class="split">
    <form class="form" id="contact-form" data-endpoint={import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? ""} action={`mailto:${F.contact.email}`} method="post" enctype="text/plain">
      <fieldset class="field">
        <legend>This is about</legend>
        <div class="choices">
          <label><input type="radio" name="topic" value="building" required> My building</label>
          <label><input type="radio" name="topic" value="home"> My home</label>
          <label><input type="radio" name="topic" value="shop"> A shop or office</label>
          <label><input type="radio" name="topic" value="school"> A school lab</label>
          <label><input type="radio" name="topic" value="company"> Retiring company devices</label>
          <label><input type="radio" name="topic" value="government"> Government or public body</label>
          <label><input type="radio" name="topic" value="host"> Hosting</label>
          <label><input type="radio" name="topic" value="donate"> Donating devices</label>
          <label><input type="radio" name="topic" value="investor"> Investing</label>
          <label><input type="radio" name="topic" value="other"> Something else</label>
        </div>
      </fieldset>
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="phone">Phone or WhatsApp number</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="01XXXXXXXXX" required>
      </div>
      <div class="field">
        <label for="email">Email <span class="hint">(optional)</span></label>
        <input id="email" name="email" type="email" autocomplete="email">
      </div>
      <div class="field">
        <label for="area">Area in Dhaka</label>
        <input id="area" name="area" type="text" list="areas" required>
        <datalist id="areas">
          <option value="Badda"></option><option value="Banani"></option><option value="Bashundhara"></option><option value="Dhanmondi"></option><option value="Gulshan"></option>
          <option value="Khilgaon"></option><option value="Lalmatia"></option><option value="Mirpur"></option><option value="Mohakhali"></option><option value="Mohammadpur"></option>
          <option value="Motijheel"></option><option value="Old Dhaka"></option><option value="Rampura"></option><option value="Shyamoli"></option><option value="Tejgaon"></option>
          <option value="Uttara"></option><option value="Wari"></option>
        </datalist>
      </div>
      <div class="field">
        <label for="devices">Devices you have <span class="hint">(optional)</span></label>
        <input id="devices" name="devices" type="text" placeholder="e.g. 2 TV boxes, 3 old phones, 1 laptop">
      </div>
      <div class="field">
        <label for="message">Anything else <span class="hint">(optional)</span></label>
        <textarea id="message" name="message"></textarea>
      </div>
      <label class="small" style="display:flex;gap:10px;align-items:flex-start">
        <input type="checkbox" name="consent" value="yes" required style="margin-top:6px">
        <span>amader.cloud may use these details to reply to me and arrange a visit. See the <a href="privacy.html">privacy policy</a>.</span>
      </label>
      <div><button class="btn btn-bulb" type="submit">Send message</button></div>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>

    <div>
      <h2>Or reach us directly</h2>
      <ul class="ledger">
        <li><div><strong>WhatsApp</strong></div><div><p>{F.contact.whatsapp}</p><p class="small">The fastest way. Send a photo of your device's label.</p></div></li>
        <li><div><strong>Email</strong></div><div><p><a href={`mailto:${F.contact.email}`}>{F.contact.email}</a></p></div></li>
        <li><div><strong>Security issues</strong></div><div><p><a href={`mailto:${F.contact.security}`}>{F.contact.security}</a></p><p class="small">Found a vulnerability in something we run? Tell us here first. We reply within 72 hours.</p></div></li>
        <li><div><strong>Hours</strong></div><div><p>Saturday to Thursday, 10:00–19:00</p></div></li>
      </ul>
    </div>
  </div>
</section>
</Base>
