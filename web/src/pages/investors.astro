---
import Base from "../layouts/Base.astro";
import facts from "../data/facts";
import SignAvatar from "../components/SignAvatar.astro";
import forms from "../data/forms.json";
const { market: m, anchor: a, funding: f } = facts;
const figures = [
  [m.fbSellerPages.text, "Facebook pages run by sellers in Bangladesh"],
  [m.codShare.text, "of e-commerce still paid in cash on delivery"],
  [a.lovableValuation.text, "valuation of Lovable, the category leader"],
];
---
<Base title="Investors · Amader Cloud" description="Amader Cloud is raising a pre-seed round. AI app building for markets that pay by mobile money. Request the deck.">

<section class="page-hero">
  <div class="wrap inv-top">
    <div>
      <div class="signboard sign-navy">
        <h1>AI app building for markets that pay by mobile money.</h1>
        <span class="address">For investors</span>
      </div>
      <p class="lede">Bangladeshi businesses describe the store, bookings or fee collection they need, and Amader Cloud builds it with local payments, couriers and SMS already working.</p>
      <div class="btn-row"><a class="btn btn-go" href="#deck">Request the deck</a></div>
    </div>
    <aside class="round" aria-label="Funding status">
      <span class="round-status"><span class="dot" aria-hidden="true"></span>{f.status}</span>
      <dl>
        <div><dt>Round</dt><dd>{f.stage}</dd></div>
        <div><dt>Raising</dt><dd>{f.roundUsd}</dd></div>
        <div><dt>Instrument</dt><dd>{f.instrument}</dd></div>
        <div><dt>First close</dt><dd>{f.firstClose}</dd></div>
      </dl>
    </aside>
  </div>
</section>

<section class="section alt">
  <div class="wrap thesis">
    <div>
      <h2>The problem</h2>
      <p>Bangladeshi commerce runs in Facebook inboxes. Orders are taken by message, tracked by hand and paid in cash at the door. A website costs an agency project the owner can't change afterwards.</p>
    </div>
    <div>
      <h2>Why now</h2>
      <p>AI can now build reliable small-business apps when it works from tested components. Mobile-money providers have opened developer APIs, but merchants still need a developer to use them.</p>
    </div>
    <div>
      <h2>Why us</h2>
      <p>The global builders price in dollars and don't know bKash, local couriers or VAT invoices. We build for this market first, with local connectors and agencies as a sales channel.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>The opportunity</h2>
    <div class="figures">
      {figures.map(([n, l]) => <div class="stat"><span class="n">{n}</span><span class="l">{l}</span></div>)}
    </div>
  </div>
</section>

<section class="section alt">
  <div class="wrap split">
    <div>
      <h2>What we're building</h2>
      <p class="lede">An owner types one sentence. The AI builds a working store, booking page or fee collection at their own address, and changes it whenever they ask. We host it and keep it running; payments go straight to the owner.</p>
      <div class="btn-row"><a class="btn" href="./#demo">Try the demo</a><a class="btn btn-quiet" href="how-it-works.html">How it works</a></div>
    </div>
    <ol class="milestones">
      {facts.investorMilestones.items.map((s) => <li><span class="when">{s.when}</span><span>{s.what}</span></li>)}
    </ol>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2>Team</h2>
    <ul class="team">
      {facts.team.members.map((t) => <li><SignAvatar initials={t.initials} sign={t.sign as any} /><strong>{t.name}</strong><span class="role">{t.role}</span></li>)}
    </ul>
  </div>
</section>

<section class="section ink-band" id="deck">
  <div class="wrap split">
    <div>
      <h2>Request the deck</h2>
      <p class="lede">We'll send the deck and set up a call.</p>
    </div>
    <form class="form deck-form" id="deck-form" data-endpoint={forms.deck} data-fallback={forms.fallbackEmail} data-sent="Thanks. We'll send the deck shortly.">
      <input class="hp" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="field"><label for="d-name">Name</label><input id="d-name" name="name" required autocomplete="name"></div>
      <div class="field"><label for="d-firm">Firm</label><input id="d-firm" name="firm" autocomplete="organization"></div>
      <div class="field"><label for="d-email">Email</label><input id="d-email" name="email" type="email" required autocomplete="email"></div>
      <div><button class="btn btn-go" type="submit">Request the deck</button></div>
      <p class="form-status" role="status"></p>
    </form>
  </div>
</section>


<style>
.inv-top { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
@media (max-width: 900px) { .inv-top { grid-template-columns: 1fr; } }
.inv-top .signboard h1 { max-width: 16ch; }

.round { border: 1.5px solid var(--line); border-radius: 6px; padding: 22px 24px; background: var(--card); }
.round-status { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--ok); }
.round-status .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--ok); }
.round dl { margin: 14px 0 0; display: grid; gap: 0; }
.round dl div { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 10px 0; border-top: 1px solid var(--rule); }
.round dt { color: var(--ink-2); }
.round dd { margin: 0; font-family: var(--display); font-weight: 800; font-size: 1.5rem; line-height: 1; }

.thesis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); }
@media (max-width: 860px) { .thesis { grid-template-columns: 1fr; } }
.thesis h2 { font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem); }
.thesis p { color: var(--ink-2); margin: 0; }

.figures { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); margin-top: 12px; }
@media (max-width: 760px) { .figures { grid-template-columns: 1fr; } }
.figures .stat { border-left: 3px solid var(--yellow); padding-left: 20px; }
.figures .n { color: var(--green); }
:root[data-theme="dark"] .figures .n { color: var(--yellow); }

.milestones { list-style: none; margin: 0; padding: 0; border-left: 3px solid var(--green); }
.milestones li { display: grid; gap: 2px; padding: 0 0 22px 22px; position: relative; }
.milestones li::before { content: ""; position: absolute; left: -9.5px; top: 6px; width: 16px; height: 16px; border-radius: 50%; background: var(--wash-2); border: 3px solid var(--green); }
.milestones li:first-child::before { background: var(--green); }
.milestones .when { font-family: var(--display); font-weight: 800; font-size: 1.4rem; line-height: 1.1; }

.team { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
@media (max-width: 760px) { .team { grid-template-columns: 1fr; } }
.team li { display: grid; gap: 2px; }
.team :global(.sign-avatar) { width: 96px; height: 96px; margin-bottom: 12px; }
.team strong { font-size: 1.1rem; }
.team .role { color: var(--green); font-weight: 600; }

.deck-form { max-width: 460px; }
.deck-form .field input { border-color: rgb(255 255 255 / .3); }
</style>
</Base>
