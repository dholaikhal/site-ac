---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import MiniPhone from "../components/MiniPhone.astro";
const templates = [
  {
    id: "shop", name: "Store with courier booking", for: "Facebook and Instagram sellers, home businesses, small brands",
    ask: "A store for my handmade bags with bKash payment, delivery, and an SMS when the order ships",
    url: "jutethread.amader.cloud", color: "#9a4a24", accent: "red",
    phone: { name: "Jute & Thread", banner: "Handmade jute bags", rows: [["Market tote", "Tk 1,450"], ["Sling bag", "Tk 980"], ["Laptop sleeve", "Tk 1,650"]], button: "Checkout" },
    does: [
      "Product pages with photos, variants and stock",
      "Cart and prepaid checkout by bKash, Nagad or card",
      "Optional cash on delivery, limited by area if you want",
      "A courier booking created when you mark an order dispatched",
      "SMS to the buyer when the order is confirmed and when it ships",
      "An orders screen for you, with payment and delivery status",
      "A link to share from your Facebook page and posts",
    ],
  },
  {
    id: "bookings", name: "Bookings with a deposit", for: "Clinics, salons, tutors, coaching centres, studios",
    ask: "Online bookings for my salon with a deposit paid by bKash and a reminder SMS",
    url: "glowroom.amader.cloud", color: "#6a3d8f", accent: "plum",
    phone: { name: "Glow Room", banner: "Hair, skin and nails", rows: [["Haircut", "Tk 600"], ["Hair colour", "Tk 2,200"], ["Facial", "Tk 1,500"]], button: "Book a time" },
    does: [
      "Your services, prices and opening hours",
      "Customers pick a free slot; double bookings are blocked",
      "A deposit taken online to hold the slot",
      "SMS confirmation and a reminder before the visit",
      "Reschedule and cancel links, with your own rules",
      "A day view of bookings for you and your staff",
    ],
  },
  {
    id: "fees", name: "Fee and membership collection", for: "Schools, coaching centres, clubs, associations",
    ask: "Monthly fee collection for my coaching centre, paid by bKash or Nagad, with an SMS receipt",
    url: "brightpath.amader.cloud", color: "#1f5f8b", accent: "cobalt",
    phone: { name: "Bright Path Coaching", banner: "Pay monthly fees", rows: [["October fee", "Tk 2,500"], ["September fee", "Paid"]], button: "Pay October fee" },
    does: [
      "Students or members, grouped by class, batch or category",
      "Monthly or one-off invoices, with optional late fees",
      "Payment online by bKash, Nagad or card",
      "A receipt by SMS and a printable receipt page",
      "Who has paid and who hasn't, at a glance",
      "Export to a spreadsheet for your accounts",
    ],
  },
];
---
<Base title="Templates · Amader Cloud" description="Start from a store, a booking page or fee collection. Each template comes with payments, SMS and hosting already wired in; the AI shapes it to your business.">

<section class="page-hero">
  <div class="wrap tpl-hero">
    <div>
      <div class="signboard sign-yellow">
        <h1>Start from something that already works.</h1>
        <span class="address">Three ready-made apps for the beta</span>
      </div>
      <p class="lede">The AI starts from a tested template and shapes it to your business.</p>
    </div>
    <Photo id="shop-interior" class="tpl-photo" sizes="(max-width: 860px) 100vw, 34vw" loading="eager" />
  </div>
</section>

{templates.map((t, i) => (
  <section class:list={["section", { alt: i % 2 === 1 }]} id={t.id}>
    <div class="wrap tpl">
      <div class="tpl-copy">
        <h2>{t.name}</h2>
        <p class="small"><strong>For:</strong> {t.for}</p>
        <p class="ask"><span class="ask-l">You say</span>“{t.ask}”</p>
        <h3>Out of the box</h3>
        <ul class="ticks">{t.does.map((d) => <li>{d}</li>)}</ul>
      </div>
      <MiniPhone url={t.url} color={t.color} sample={i === 0} {...(t.phone as any)} />
    </div>
  </section>
))}

<section class="section tight ink-band">
  <div class="wrap split">
    <div>
      <h2>Later</h2>
      <p class="lede">Event tickets, restaurant orders and portfolios. Tell us what you need.</p>
    </div>
    <div class="btn-row" style="justify-content:flex-start">
      <a class="btn btn-go" href="contact.html?topic=beta">Join the beta</a>
      <a class="btn" href="./#demo">Try the demo</a>
    </div>
  </div>
</section>

<style>
.tpl-hero { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
:global(.tpl-photo) { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 4px; }
@media (max-width: 860px) { .tpl-hero { grid-template-columns: 1fr; } :global(.tpl-photo) { aspect-ratio: 16 / 10; } }
.tpl { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
@media (max-width: 820px) { .tpl { grid-template-columns: 1fr; } }
.ask { font-family: var(--display); font-weight: 700; font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.015em; background: var(--card); border: 2px solid var(--line); border-radius: 18px 18px 18px 4px; padding: 14px 18px; margin: 18px 0 26px; max-width: 560px; }
.ask-l { display: block; width: fit-content; font-family: var(--sans); font-size: 0.75rem; font-weight: 700; letter-spacing: 0; background: var(--blue); color: #fff; border-radius: 999px; padding: 3px 9px; margin-bottom: 6px; }

</style>
</Base>
