---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Faq from "../components/Faq.astro";
import BetaButton from "../components/BetaButton.astro";
import PlanCards from "../components/PlanCards.astro";
import facts, { tk, usdOf } from "../data/facts";
const plans = facts.pricing.plans;
const yes = "✓";
const rows: [string, (p: (typeof plans)[number]) => string][] = [
  ["Price a month", (p) => (p.tk ? `${tk(p.tk)} (≈ ${usdOf(p.tk)})` : tk(0))],
  ["Apps", (p) => (p.id === "free" ? "1, preview only" : `${p.apps} live`)],
  ["Changes by asking", (p) => (p.id === "free" ? `${p.edits} in total` : `${p.edits} a month`)],
  ["Live payments", (p) => (p.id === "free" ? "–" : yes)],
  ["yourname.amader.cloud", (p) => yes],
  ["Your own domain", (p) => (p.id === "business" || p.id === "agency" ? "after the beta" : "–")],
  ["SMS included", (p) => (p.sms ? `${p.sms} a month` : "pay as you go")],
  ["Watermark", (p) => (p.id === "free" ? "yes" : "no")],
];
const questions: [string, string][] = [
  ["What counts as a change?", "One request that changes your app, such as “add 10% off for bKash” or “add a size option to every product”. Undoing a change is free."],
  ["Who charges the payment fees?", "Your payment provider charges its own fees, under your merchant account with them. Our plans are a flat monthly price; we don't take a percentage of your sales."],
  ["Do I need a bKash or Nagad merchant account?", "Yes, payments go to your own accounts. We help with the paperwork through our licensed payment partner, so you can start with test payments while it's approved."],
  ["Can I leave?", "Yes. Export your orders, customers and payments at any time. Plans are monthly."],
  ["Why is it cheaper than a custom website?", "Our agent builds from tested templates and connectors on one stack, so building and running your app costs us little. We pass that on."],
];
---
<Base title="Pilot pricing · Amader Cloud" description="Pilot plans in taka with USD equivalents: free to build and preview, then Starter, Business and Agency plans when you go live.">

<section class="page-hero band band-navy has-photo">
  <Photo id="towers" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="signboard sign-red">
      <h1>Build for free. Pay when you're live.</h1>
      <span class="address">Pilot pricing, in taka</span>
    </div>
    <p class="lede">Plans in taka, paid by bKash.</p>
  </div>
</section>

<section class="section has-photo tint">
  <Photo id="facades" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <PlanCards />
  </div>
</section>

<section class="band band-yellow has-photo fade-low">
  <Photo id="sunset" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap">
    <div class="head"><h2>Compare plans</h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Plan</th>{plans.map((p) => <th scope="col">{p.name}</th>)}</tr></thead>
        <tbody>
          {rows.map(([label, f]) => <tr><th scope="row">{label}</th>{plans.map((p) => <td>{f(p)}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="band band-green has-photo pricing-faq">
  <Photo id="card-laptop" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />
  <div class="wrap faq-grid">
    <div class="head">
      <h2>Questions</h2>
      <p class="small">Anything else: <a href="contact.html">write to us</a>.</p>
    </div>
    <Faq items={questions} />
  </div>
</section>


<section class="section tight ink-band has-photo fade-right">
  <Photo id="street" class="bg-photo" sizes="100vw" widths={[800, 1200, 1600]} />

  <div class="wrap split">
    <h2 style="margin:0">Build your first app free in the beta.</h2>
    <div class="btn-row" style="margin:0"><BetaButton /><a class="btn" href="contact.html?topic=agency">Agency enquiry</a></div>
  </div>
</section>

<style>
.faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
@media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
td { white-space: nowrap; }
/* Tablets: let cells wrap so the table fits instead of scrolling a few pixels; phones still scroll it */
@media (min-width: 600px) and (max-width: 960px) { td { white-space: normal; } }
</style>
</Base>
