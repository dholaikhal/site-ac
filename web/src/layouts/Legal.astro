---
// Layout for the Markdown (MDX) legal pages: draft notice and date from facts.json, table of contents from the headings.
import Base from "./Base.astro";
import F from "../data/facts.json";
const { frontmatter: fm, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text.replace(/^\d+\.\s*/, "") }));
---
<Base title={fm.title} description={fm.description} noindex>
<section class="wrap doc" style="padding-block:clamp(40px,6vw,80px)">
  <p class="draft-note"><strong>{F.legal.status}</strong> {fm.draftNote} Last updated {F.legal.updated}.</p>
  <h1>{fm.h1}</h1>
  {fm.intro && <p>{fm.intro}</p>}
  {fm.toc && <nav class="toc" aria-label="On this page"><ol>{toc.map((t) => <li><a href={`#${t.slug}`}>{t.text}</a></li>)}</ol></nav>}
  <slot />
</section>
</Base>
